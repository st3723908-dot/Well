			v_u_10.WhatDo.Text = "Item Offsale"
			v_u_10.Cost.Text = script.ShopStuff.Item.Value:GetAttribute("OffSaleReason")
			v_u_10.Yes.Visible = false
		end
		if script.ShopStuff.Item.Value and script.ShopStuff.Item.Value.Value == true then
