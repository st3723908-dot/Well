local v_u_2 = script.Parent
local v_u_3 = game:GetService("ReplicatedStorage"):WaitForChild("SubRe")
local v_u_4 = require(game:GetService("ReplicatedStorage"):WaitForChild("Icon"))
local v_u_5 = {
	["TEXT_COUNTER_GOOD_TEXT_LENGTH_COLOR"] = Color3.fromRGB(113, 113, 113),
	["TEXT_COUNTER_WARN_TEXT_LENGTH_COLOR"] = Color3.fromRGB(216, 164, 32),
	["TEXT_COUNTER_BAD_TEXT_LENGTH_COLOR"] = Color3.fromRGB(215, 0, 0)
}
v_u_2.search.TextBox.FocusLost:Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_2
	local v_u_6 = nil
	local function v7()
		-- upvalues: (ref) v_u_6, (ref) v_u_1, (ref) v_u_2
		v_u_6 = v_u_1:GetUserIdFromNameAsync(v_u_2.search.TextBox.Text)
	end
	if pcall(v7) then
		v_u_2.search.Icon.Image = v_u_1:GetUserThumbnailAsync(v_u_6, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	else
		v_u_2.search.Icon.Image = ""
	end
end)
v_u_2.Frame.TextBox:GetPropertyChangedSignal("Text"):Connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_5
	v_u_2.Frame.TextBox.Parent.TextCounter.Text = #v_u_2.Frame.TextBox.Text .. "/500"
	if #v_u_2.Frame.TextBox.Text <= 450 then
		v_u_2.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_5.TEXT_COUNTER_GOOD_TEXT_LENGTH_COLOR
		return
	elseif #v_u_2.Frame.TextBox.Text > 450 and #v_u_2.Frame.TextBox.Text <= 500 then
		v_u_2.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_5.TEXT_COUNTER_WARN_TEXT_LENGTH_COLOR
	else
		v_u_2.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_5.TEXT_COUNTER_BAD_TEXT_LENGTH_COLOR
	end
end)
v_u_2.Sub.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_1, (copy) v_u_4, (copy) v_u_3
	local v8 = v_u_2.Frame.TextBox.Text
	if string.len(v8) < 10 then
		v_u_2.em.Text = "Your reason must be above 10 characters."
		return
	else
		local v9 = v_u_2.Frame.TextBox.Text
		if string.len(v9) > 500 then
			v_u_2.em.Text = "Please keep your reason under 500 characters."
			return
		else
			local v_u_10 = nil
			local function v11()
				-- upvalues: (ref) v_u_10, (ref) v_u_1, (ref) v_u_2
				v_u_10 = v_u_1:GetUserIdFromNameAsync(v_u_2.search.TextBox.Text)
			end
			if pcall(v11) then
				if v_u_10 == v_u_1.LocalPlayer.UserId then
					v_u_2.em.Text = "You cannot report yourself."
					return
				elseif v_u_1:GetPlayerByUserId(v_u_10) then
					v_u_4.getIcon("rep"):deselect()
					local v12 = v_u_3:InvokeServer(v_u_2.search.TextBox.Text, v_u_2.Frame.TextBox.Text)
					v_u_2.em.Text = "Report a player breaking the rules. A moderator will review each report."
					if v12 == "good" then
						v_u_2.Frame.TextBox.Text = ""
						v_u_2.search.TextBox.Text = ""
						v_u_2.search.Icon.Image = ""
					end
				else
					v_u_2.em.Text = "This player is not in the game."
				end
			else
				v_u_2.em.Text = "User does not exist."
				return
			end
		end
