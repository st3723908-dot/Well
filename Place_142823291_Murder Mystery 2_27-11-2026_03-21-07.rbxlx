	["GetCurrentDayPST"] = function(_) -- name: GetCurrentDayPST
		local v1 = DateTime.now()
		v1:ToUniversalTime()
		local v2 = v1.UnixTimestamp + -28800
		local v3 = DateTime.fromUnixTimestamp(v2):ToUniversalTime()
		return DateTime.fromUniversalTime(v3.Year, v3.Month, v3.Day, 0, 0, 0, 0).UnixTimestamp - -28800
	end,
	["GetCurrentPeriodStartPST"] = function(_, p4, p5) -- name: GetCurrentPeriodStartPST
		local v6 = DateTime.now().UnixTimestamp + -28800
		local v7 = (p5 or 0) + -28800
		local v8 = v7 - v7 % 86400
		local v9 = v6 - v8
		return v8 + (v9 - v9 % p4) - -28800
	end,
	["GetCurrentDayUTC"] = function(_) -- name: GetCurrentDayUTC
		local v10 = DateTime.now():ToUniversalTime()
		return DateTime.fromUniversalTime(v10.Year, v10.Month, v10.Day, 0, 0, 0, 0).UnixTimestamp
	end,
	["FormatTimeLeftInSeconds"] = function(_, p11) -- name: FormatTimeLeftInSeconds
		local v12 = p11 / 3600
		local v13 = math.floor(v12)
		local v14 = p11 % 3600 / 60
		local v15 = math.floor(v14)
		local v16 = p11 % 60
		if v13 > 0 then
			return string.format("%dh, %dm", v13, v15)
		elseif v15 > 0 then
			return string.format("%dm", v15)
		else
			return string.format("%ds", v16)
		end
	end,
	["GetTimeLeftText"] = function(_, p17) -- name: GetTimeLeftText
		local v18 = p17 / 86400
		local v19 = math.floor(v18)
		local v20 = p17 % 86400 / 3600
		local v21 = math.floor(v20)
		local v22 = p17 % 3600 / 60
		local v23 = math.floor(v22)
		local v24 = p17 % 60
		local v25 = math.floor(v24)
		if v19 > 0 then
			return string.format("%dd, %dh, %dm", v19, v21, v23)
		elseif v21 > 0 then
			return string.format("%dh, %dm", v21, v23)
		elseif v23 > 0 then
			if v23 <= 5 then
				return string.format("%dm, %ds", v23, v25)
			else
				return string.format("%dm", v23)
			end
		else
			return string.format("%ds", v25)
		end
	end,
	["GetLeaderboardTimeText"] = function(_, p26) -- name: GetLeaderboardTimeText
		local v27 = p26 / 86400
		local v28 = math.floor(v27)
		local v29 = p26 % 86400 / 3600
		local v30 = math.floor(v29)
		local v31 = v28 .. "d, " .. v30 .. "h"
		if v28 < 1 then
			local v32 = v30 .. "h"
			v31 = v30 == 1 and "Less than 2 hours" or v32
		end
		local v33 = p26 <= 3600 and "Less than 1 hour!" or v31
		return p26 <= 0 and "ENDED!" or v33
	end
}]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX14630"><Properties><string name="Name">Resources</string></Properties><Item class="Folder" referent="RBX14631"><Properties><string name="Name">Perks</string></Properties><Item class="Folder" referent="RBX14632"><Properties><string name="Name">VampireBat</string></Properties><Item class="Model" referent="RBX14633"><Properties><Ref name="PrimaryPart">RBX14684</Ref><string name="Name">BatModel1</string></Properties><Item class="Folder" referent="RBX14634"><Properties><string name="Name">InitialPoses</string></Properties><Item class="CFrameValue" referent="RBX14635"><Properties><string name="Name">Symmetry_Composited</string></Properties></Item><Item class="CFrameValue" referent="RBX14636"><Properties><CoordinateFrame name="Value"><X>0</X><Y>0</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><string name="Name">Symmetry_Original</string></Properties></Item><Item class="CFrameValue" referent="RBX14637"><Properties><CoordinateFrame name="Value"><X>0</X><Y>0</Y><Z>0</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><string name="Name">Symmetry_Initial</string></Properties></Item><Item class="CFrameValue" referent="RBX14638"><Properties><CoordinateFrame name="Value"><X>-0.708866835</X><Y>-116.41748</Y><Z>73.1533279</Z><R00>-4.88758087e-06</R00><R01>0.999999166</R01><R02>-0.00129970908</R02><R10>4.7981739e-06</R10><R11>0.00129967928</R11><R12>0.999999166</R12><R20>1</R20><R21>4.7981739e-06</R21><R22>-4.88758087e-06</R22></CoordinateFrame><string name="Name">Joint_Composited</string></Properties></Item><Item class="CFrameValue" referent="RBX14639"><Properties><CoordinateFrame name="Value"><X>0.708866835</X><Y>-116.41748</Y><Z>-73.1533279</Z><R00>-4.88758087e-06</R00><R01>-0.999999166</R01><R02>0.00129970908</R02><R10>-4.798173