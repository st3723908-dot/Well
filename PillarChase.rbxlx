			v_u_3.CreateNotificationBigMessage(v_u_4, "Map set to " .. v_u_1.MapName.Text)
			script.SetMap:FireServer(v_u_1.MapName.Text)
		else
			v_u_3.CreateNotification(v_u_4, "Map doesn\'t exist.", "Notification")
		end
		v_u_5 = false
	end
end)
v_u_1.SetQP.MouseButton1Down:Connect(function()
