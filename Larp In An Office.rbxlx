function FireBootGlow() -- name: FireBootGlow
	-- upvalues: (copy) v_u_18, (copy) v_u_6, (copy) v_u_16, (copy) v_u_1, (copy) v_u_11
	if v_u_18.Interface.StartupEffect then
		local v56 = v_u_6:FindFirstChild("Exe6BootBlur")
		local v57 = v_u_6:FindFirstChild("Exe6BootColorCorrection")
		if not v56 then
			v56 = Instance.new("BlurEffect")
			v56.Name = "Exe6BootBlur"
			v56.Size = 0
			v56.Parent = v_u_6
		end
		if not v57 then
			v57 = Instance.new("ColorCorrectionEffect")
			v57.Name = "Exe6BootColorCorrection"
			v57.Parent = v_u_6
		end
		v_u_16.Haptic(0.5, 1.5)
		v_u_1:Create(v56, v_u_11, {
			["Size"] = 12
		}):Play()
		v_u_1:Create(v57, v_u_11, {
			["Brightness"] = 0.2,
			["Contrast"] = 1,
			["Saturation"] = 0.5
		}):Play()
	end
end
function v_u_52.SetFullscreen(p58) -- name: SetFullscreen
	-- upvalues: (copy) v_u_23, (copy) v_u_16, (copy) v_u_1, (copy) v_u_7
