	local v2 = p1.Parent
	local v3 = v2:FindFirstChildWhichIsA("Humanoid")
	if v3 and v3.Health > 0 then
		v2:PivotTo(script.Parent.secretexit:GetPivot())
	end
end)]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX4549"><Properties><token name="RunContext">2</token><string name="Name">SpinScript</string><ProtectedString name="Source"><![CDATA[local v1 = game:GetService("RunService")
local v_u_2 = script.Parent
