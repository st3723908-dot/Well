04</XS><XO>1</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988</XS><XO>0</XO><YS>0.349999994</YS><YO>0</YO></UDim2><int name="ZIndex">2004</int><string name="Name">TextBox</string></Properties><Item class="LocalScript" referent="RBX30674"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("PolicyService")
local v_u_2 = game:GetService("Players").LocalPlayer
local v3, v4 = pcall(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_2
	return v_u_1:GetPolicyInfoForPlayerAsync(v_u_2)
end)
if v3 and v4 then
	local v5 = v4.AllowedExternalLinkReferences
	local v6 = { "X", "Discord", "YouTube" }
	local v7 = 0
	for _, v8 in pairs(v5) do
		if not table.find(v6, v8) then
			continue
		end
		v7 = v7 + 1
	end
	if v7 < #v6 then
		script.Parent.Text = "See HD Admin\'s description (in Marketplace) for updates"
	end
