local v2 = script.Parent
local v3 = v2:FindFirstChild("UIStroke")
if v3 then
	v3.Color = Color3.new(0, 0, 0)
end
local v_u_4 = v2:FindFirstChild("RainbowGradient")
if not v_u_4 then
	v_u_4 = Instance.new("UIGradient")
	v_u_4.Name = "RainbowGradient"
	v_u_4.Parent = v2
end
local v_u_5 = script:FindFirstAncestor("AdminPanel")
local v_u_6 = 0
local v_u_8 = v1.Heartbeat:Connect(function(p7)
	-- upvalues: (copy) v_u_5, (ref) v_u_6, (ref) v_u_4
	if not v_u_5 or v_u_5.Visible then
		v_u_6 = v_u_6 + p7 / 3
		if v_u_6 >= 1 then
			v_u_6 = v_u_6 - 1
		end
		v_u_4.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV((v_u_6 + 0) % 1, 1, 1)),
			ColorSequenceKeypoint.new(0.17, Color3.fromHSV((v_u_6 + 0.17) % 1, 1, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV((v_u_6 + 0.33) % 1, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV((v_u_6 + 0.5) % 1, 1, 1)),
			ColorSequenceKeypoint.new(0.67, Color3.fromHSV((v_u_6 + 0.67) % 1, 1, 1)),
			ColorSequenceKeypoint.new(0.83, Color3.fromHSV((v_u_6 + 0.83) % 1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV((v_u_6 + 1) % 1, 1, 1))
		})
	end
end)
script.AncestryChanged:Connect(function()
	-- upvalues: (copy) v_u_8
	if not script:IsDescendantOf(game) then
		v_u_8:Disconnect()
	end
end)]]></ProtectedString></Properties></Item><Item class="UIStroke" referent="RBX21782"><Properties><float name="Thickness">2</float><string name="Name">UIStroke</string></Properties></Item></Item><Item class="ImageLabel" referent="RBX21783"><Properties><Content name="Image"><url>rbxassetid://107147525412856</url></Content><Content name="ImageContent"><url>rbxassetid://107147525412856</url></Content><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.0048769312</XS><XO>0</XO><YS>0.805738866</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.0783917978</XS><XO>0</XO><YS>0.205390036</YS><YO>0</YO></UDim2><string name="Name">ImageLabel</string></Properties></Item><Item class="TextButton" referent="RBX21784"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><bool name="AutoButtonColor">false</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0.48627454</R><G>0.0666666701</G><B>0</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0.859642148</XS><XO>0</XO><YS>0.585050046</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.256464064</XS><XO>0</XO><YS>0.198745817</YS><YO>0</YO></UDim2><bool name="SelectionGroup">true</bool><string name="Name">Hide</string><BinaryString name="Tags">QnV0dG9u</BinaryString></Properties><Item class="TextLabel" referent="RBX21785"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>800</Weight><Style>Normal</Style></Font><string name="