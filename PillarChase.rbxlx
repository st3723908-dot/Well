e="Value">Always so loud.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10654"><Properties><string name="Value">Disgusting human.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10655"><Properties><string name="Value">You false demon.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10656"><Properties><string name="Name">Rosemary</string></Properties><Item class="StringValue" referent="RBX10657"><Properties><string name="Value">A mistake, our ranks suffer.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10658"><Properties><string name="Value">You shouldn&apos;t be here.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10659"><Properties><string name="Value">Wasting our power.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10660"><Properties><string name="Value">Do you remember your name?</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10661"><Properties><string name="Value">You false demon.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10662"><Properties><string name="Name">Ao Oni</string></Properties><Item class="StringValue" referent="RBX10663"><Properties><string name="Value">Out of the way, blue demon.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10664"><Properties><string name="Value">Are you one of us?</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10665"><Properties><string name="Value">Shapeshifter, why as humans?</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10666"><Properties><string name="Value">Sloppy execution, blue demon.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10667"><Properties><string name="Name">The Fogborn</string></Properties><Item class="StringValue" referent="RBX10668"><Properties><string name="Value">Kill them all, fog dweller.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10669"><Properties><string name="Value">An interesting creature.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10670"><Properties><string name="Value">Fog dweller, join us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10671"><Properties><string name="Value">The humans are fitting prey.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10672"><Properties><string name="Name">EXE</string></Properties><Item class="StringValue" referent="RBX10673"><Properties><string name="Value">Not one of us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10674"><Properties><string name="Value">Leave this planet, entity.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10675"><Properties><string name="Value">Not a god, false.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10676"><Properties><string name="Value">Our numbers are greater.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10677"><Properties><string name="Value">Stay out of the way.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10678"><Properties><string name="Value">Put them to rest.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10679"><Properties><string name="Name">Baldi</string></Properties><Item class="StringValue" referent="RBX10680"><Properties><string name="Value">One mistake and you perish.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10681"><Properties><string name="Value">Human filth.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10682"><Properties><string name="Value">Your soul is weak, teacher.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10683"><Properties><string name="Value">Your time is ticking.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10684"><Properties><string name="Value">You don&apos;t belong here.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10685"><Properties><string name="Name">Springtrap</string></Properties><Item class="StringValue" referent="RBX10686"><Properties><string name="Value">Your soul is tainted.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10687"><Properties><string name="Value">You will make a fine demon.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10688"><Properties><string name="Value">You will join us soon.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10689"><Properties><string name="Value">Show us what you can do.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10690"><Properties><string name="Value">You shall burn.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10691"><Properties><string name="Name">Uncle Samsonite</string></Properties><Item class="StringValue" referent="RBX10692"><Properties><string name="Value">Leave this planet, entity.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10693"><Properties><string name="Value">We remember you, Smiling Sam.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10694"><Properties><string name="Value">Do not toy with them.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10695"><Properties><string name="Value">You waste time, Sam.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10696"><Properties><string name="Value">Unlikely alliance, only temporary.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10697"><Properties><string name="Name">Brutum</string></Properties><Item class="StringValue" referent="RBX10698"><Properties><string name="Value">Ancient entity, disperse.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10699"><Properties><string name="Value">Not one of us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10700"><Properties><string name="Value">Our numbers are greater.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10701"><Properties><string name="Value">Stay out of the way.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10702"><Properties><string name="Value">Put them to rest.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10703"><Properties><string name="Value">The innocent are weak.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10704"><Properties><string name="Name">The Forest King</string></Properties><Item class="StringValue" referent="RBX10705"><Properties><string name="Value">Your vessel is weak.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10706"><Properties><string name="Value">Some forests burn.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10707"><Properties><string name="Value">Our numbers are greater.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10708"><Properties><string name="Value">You are no king.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10709"><Properties><string name="Value">False god, disperse.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10710"><Properties><string name="Name">WYST</string></Properties><Item class="StringValue" referent="RBX10711"><Properties><string name="Value">Kill them all, yellow creature.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10712"><Properties><string name="Value">An interesting creature.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10713"><Properties><string name="Value">Do you understand?</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10714"><Properties><string name="Value">Yellow creature, join us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10715"><Properties><string name="Value">So much potential, join us.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10716"><Properties><string name="Name">Vita Mimic</string></Properties><Item class="StringValue" referent="RBX10717"><Properties><string name="Value">An interesting creature.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10718"><Properties><string name="Value">Kill them all, mimic.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10719"><Properties><string name="Value">Otherworldly creation, intrigued.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10720"><Properties><string name="Value">Unknown origins.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10721"><Properties><string name="Value">The humans are fitting prey.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10722"><Properties><string name="Name">Fuwatti</string></Properties><Item class="StringValue" referent="RBX10723"><Properties><string name="Value">Devour them.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10724"><Properties><string name="Value">Intriguing.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10725"><Properties><string name="Value">Why are you here?</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10726"><Properties><string name="Value">Purple creature, once human.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10727"><Properties><string name="Name">Inkfell</string></Properties><Item class="StringValue" referent="RBX10728"><Properties><string name="Value">Take revenge, kill them.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10729"><Properties><string name="Value">A sad existence.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10730"><Properties><string name="Value">Our power wasn&apos;t meant for you.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10731"><Properties><string name="Value">Such is fate.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10732"><Properties><string name="Value">False ink being, return to us.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10733"><Properties><string name="Name">PCX</string></Properties><Item class="StringValue" referent="RBX10734"><Properties><string name="Value">Leave this planet, false god.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10735"><Properties><string name="Value">Two entities, still outnumbered.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10736"><Properties><string name="Value">You are two, we are many.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10737"><Properties><string name="Value">Stay out of the way.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10738"><Properties><string name="Name">Jeffrey Woods</string></Properties><Item class="StringValue" referent="RBX10739"><Properties><string name="Value">Your soul is tainted.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10740"><Properties><string name="Value">You will make a fine demon.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10741"><Properties><string name="Value">You will join us soon.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10742"><Properties><string name="Value">Show us what you can do.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10743"><Properties><string name="Value">A sad past, a promising future.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10744"><Properties><string name="Name">Valem</string></Properties><Item class="StringValue" referent="RBX10745"><Properties><string name="Value">They are foolish.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10746"><Properties><string name="Value">Fragile humans.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10747"><Properties><string name="Value">Their hearts beat.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10748"><Properties><string name="Value">They tremble before us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10749"><Properties><string name="Value">Their terror, our joy.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10750"><Properties><string name="Value">Their bones creak.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10751"><Properties><string name="Value">Their souls are lively.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10752"><Properties><string name="Name">Niloticus</string></Properties><Item class="StringValue" referent="RBX10753"><Properties><string name="Value">Take revenge, kill them.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10754"><Properties><string name="Value">A sad existence.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10755"><Properties><string name="Value">Creature of radiation, join us.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10756"><Properties><string name="Value">Such is fate.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10757"><Properties><string name="Value">Human creation, interesting.</string><string name="Name">TXT</string></Properties></Item></Item><Item class="Folder" referent="RBX10758"><Properties><string name="Name">The Stricken</string></Properties><Item class="StringValue" referent="RBX10759"><Properties><string name="Value">Destroy them all.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10760"><Properties><string name="Value">Now a monster, once happy.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10761"><Properties><string name="Value">This is not a game.</string><string name="Name">TXT</string></Properties></Item><Item class="StringValue" referent="RBX10762"><Properties><string name="Value">A shell of your former self.</string><string name="Name">TXT</string></Properties></Item></Item></Item></Item><Item class="ImageLabel" referent="RBX10763"><Properties><Content name="Image"><url>rbxassetid://118929408635776</url></Content><Content name="ImageContent"><url>rbxassetid://118929408635776</url></Content><float name="ImageTransparency">1</float><token name="ScaleType">3</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.354999989</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>15.5</XS><XO>0</XO><YS>15.5</YS><YO>0</YO></UDim2><int name="ZIndex">999999999</int><string name="Name">OverMonster</string></Properties><Item class="LocalScript" referent="RBX10764"><Properties><string name="Name">Tween</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("TweenService")
