local v_u_2 = require(v1:WaitForChild("GameModule"))
local v_u_3 = {
	["Options"] = {
		{
			["Amount"] = 1,
			["unlockCost"] = 0
		},
		{
			["Amount"] = 5,
			["unlockCost"] = 450
		},
		{
			["Amount"] = 15,
			["unlockCost"] = 5000
		}
	}
}
function getPrize(p4, p5) -- name: getPrize
	return p4 * (50 + (p5 + 1) * 25)
end
function getCost(p6, p7) -- name: getCost
	return p6 * (50000000 * (p7 + 1) ^ 1.4)
end
function v_u_3.getInfRebirthAmount(_, p8, p9) -- name: getInfRebirthAmount
	local v10 = p8 / getCost(1, p9)
	local v11 = math.floor(v10)
	return math.clamp(v11, 1, (1 / 0))
end
function v_u_3.getInfRebirthPrize(_, p12, p13, p14) -- name: getInfRebirthPrize
	-- upvalues: (copy) v_u_2
	local v15 = v_u_2:GetData(p12)
	local v16 = table.find(v15.Gamepasses, "DoubleGems") and 2 or 1
	return getPrize(p13, p14) * v16
end
function v_u_3.getInfRebirthCost(_, p17, p18) -- name: getInfRebirthCost
	return getCost(p17, p18)
end
function v_u_3.getRebirthCost(_, p19, p20) -- name: getRebirthCost
	-- upvalues: (copy) v_u_3
	local v21 = v_u_3.Options[p19].Amount
	return getCost(v21, p20)
end
function v_u_3.getRebirthPrize(_, p22, p23, p24) -- name: getRebirthPrize
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	local v25 = v_u_2:GetData(p22)
	local v26 = table.find(v25.Gamepasses, "DoubleGems") and 2 or 1
	local v27 = v_u_3.Options[p23].Amount
	return getPrize(v27, p24) * v26
end
return v_u_3]]></ProtectedString></Properties></Item></Item><Item class="Sound" referent="RBX24941"><Properties><Content name="AudioContent"><url>rbxassetid://13845249629</url></Content><Content name="SoundId"><url>rbxassetid://13845249629</url></Content><string name="Name">Sound</string></Properties></Item><Item class="Sound" referent="RBX24942"><Properties><Content name="AudioContent"><url>rbxassetid://13845253548</url></Content><Content name="SoundId"><url>rbxassetid://13845253548</url></Content><string name="Name">Sound</string></Properties></Item><Item class="Folder" referent="RBX24943"><Properties><string name="Name">Blocks</string></Properties><Item class="Part" referent="RBX24944"><Properties><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>431.85675</X><Y>-109.066956</Y><Z>528.012146</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><PhysicalProperties name="CustomPhysicalProperties"><CustomPhysics>true</CustomPhysics><Density>0.449999988</Density><Friction>0.200000003</Friction><Elasticity>0.5</Elasticity><FrictionWeight>1</FrictionWeight><ElasticityWeight>1</ElasticityWeight></PhysicalProperties><bool name="EnableFluidForces">false</bool><token name="Material">272</token><token name="TopSurface">0</token><string name="Name">Extra</string><Color3uint8 name="Color3uint8">4282300766</Color3uint8></Properties><Item class="SurfaceGui" referent="RBX24945"><Properties><bool name="ClipsDescendants">true</bool><float name="LightInfluence">1</float><float name="PixelsPerStud">12</float><token name="SizingMode">1</token><token name="ZIndexBehavior">1</token><string name="Name">Front</string></Properties><Item class="ImageLabel" referent="RBX24946"><Properties><Content name="Image"><url>rbxassetid://10898061434</url></Content><Content name="ImageContent"><url>rbxassetid://10898061434</url></Content><token name="ResampleMode">1</token><Color3 name="BackgroundColor3"><R