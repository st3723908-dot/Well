	local v_u_1 = require(script.Parent.foldLeft)
	it("should call the callback", function()
		-- upvalues: (copy) v_u_1
		local v_u_2 = 0
		v_u_1({ 1, 2, 3 }, function()
			-- upvalues: (ref) v_u_2
			v_u_2 = v_u_2 + 1
		end, 0)
		expect(v_u_2).to.equal(3)
	end)
	it("should not call the callback when the list is empty", function()
		-- upvalues: (copy) v_u_1
		local v_u_3 = false
		v_u_1({}, function()
			-- upvalues: (ref) v_u_3
			v_u_3 = true
		end, 0)
		expect(v_u_3).to.equal(false)
	end)
	it("should call the callback for each element", function()
		-- upvalues: (copy) v_u_1
		local v4 = { 4, 5, 6 }
		local v_u_5 = {}
		v_u_1(v4, function(p6, p7, p8)
			-- upvalues: (copy) v_u_5
			v_u_5[p8] = p7
			return p6
		end, 0)
		expect(#v_u_5).to.equal(#v4)
		for v9, v10 in pairs(v4) do
			expect(v10).to.equal(v_u_5[v9])
		end
	end)
	it("should pass the same modified initial value to the callback", function()
		-- upvalues: (copy) v_u_1
		local v_u_11 = {}
		v_u_1({ 5, 4, 3 }, function(p12)
			-- upvalues: (copy) v_u_11
			expect(p12).to.equal(v_u_11)
			return p12
		end, v_u_11)
	end)
	it("should call the callback in the correct order", function()
		-- upvalues: (copy) v_u_1
		local v_u_13 = { 5, 4, 3 }
		local v_u_14 = 1
		v_u_1(v_u_13, function(p15, p16)
			-- upvalues: (copy) v_u_13, (ref) v_u_14
			expect(p16).to.equal(v_u_13[v_u_14])
			v_u_14 = v_u_14 + 1
			return p15
		end, 0)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13598"><Properties><string name="Name">foldRight</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3) -- name: foldRight
