task.wait(2)
for _, v1 in pairs(script.Parent:GetDescendants()) do
	if not (v1:IsA("TextLabel") and (v1.Parent:IsA("ImageButton") and v1:FindFirstChild("UITextSizeConstraint"))) then
		continue
	end
	v1.UITextSizeConstraint.MaxTextSize = game.Players.LocalPlayer.PlayerGui.LobbyGUI.Darkness.AbsoluteSize.Y * 0.016
	if v1.TextColor3 == Color3.fromRGB(255, 85, 85) then
		v1.UITextSizeConstraint.MaxTextSize = game.Players.LocalPlayer.PlayerGui.LobbyGUI.Darkness.AbsoluteSize.Y * 0.019
	end
	if v1.Name ~= "MoveTXT" then
		continue
	end
	v1.Parent.Size = UDim2.new(0.95, 0, v1.Parent.Size.Y.Scale + v1.UITextSizeConstraint.MaxTextSize * 0.008, 0)
