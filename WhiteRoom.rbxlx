S>0.023</YS><YO>0</YO></UDim2><UDim2 name="CellSize"><XS>0.115999997</XS><XO>0</XO><YS>0.300000012</YS><YO>0</YO></UDim2><token name="SortOrder">2</token><string name="Name">UIGridLayout</string></Properties></Item></Item></Item><Item class="LocalScript" referent="RBX598"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v_u_1 = script.Parent
local v_u_2 = game:GetService("ReplicatedStorage"):WaitForChild("Cosmo")
local v_u_3 = {
	["TEXT_COUNTER_GOOD_TEXT_LENGTH_COLOR"] = Color3.fromRGB(113, 113, 113),
	["TEXT_COUNTER_WARN_TEXT_LENGTH_COLOR"] = Color3.fromRGB(216, 164, 32),
	["TEXT_COUNTER_BAD_TEXT_LENGTH_COLOR"] = Color3.fromRGB(215, 0, 0),
	["ColorEquipIcon"] = v_u_1.Colors.ColorHolder.EquipIcon
}
v_u_1.Frame.TextBox:GetPropertyChangedSignal("Text"):Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_3
	v_u_1.Frame.TextBox.Parent.TextCounter.Text = #v_u_1.Frame.TextBox.Text .. "/100"
	if #v_u_1.Frame.TextBox.Text <= 75 then
		v_u_1.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_3.TEXT_COUNTER_GOOD_TEXT_LENGTH_COLOR
		return
	elseif #v_u_1.Frame.TextBox.Text > 75 and #v_u_1.Frame.TextBox.Text <= 100 then
		v_u_1.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_3.TEXT_COUNTER_WARN_TEXT_LENGTH_COLOR
	else
		v_u_1.Frame.TextBox.Parent.TextCounter.TextColor3 = v_u_3.TEXT_COUNTER_BAD_TEXT_LENGTH_COLOR
	end
end)
v_u_1.Apply.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_2
	v_u_1.Parent.sign.Visible = false
	v_u_2:FireServer("txt", v_u_1.Frame.TextBox.Text)
end)
v_u_1.Close.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_1
	v_u_1.Parent.sign.Visible = false
end)
v_u_1.ColorPicker.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_1
	if v_u_1.Colors.Visible then
		v_u_1.ColorPicker.BackgroundColor3 = Color3.fromRGB(231, 231, 231)
		v_u_1.Colors.Visible = false
		v_u_1.Frame.Visible = true
		v_u_1.Apply.Visible = true
		v_u_1.Close.Visible = false
	else
		v_u_1.ColorPicker.BackgroundColor3 = Color3.fromRGB(61, 129, 255)
		v_u_1.Colors.Visible = true
		v_u_1.Frame.Visible = false
		v_u_1.Apply.Visible = false
		v_u_1.Close.Visible = true
	end
end)
for _, v_u_4 in pairs(v_u_1.Colors.ColorHolder:GetChildren()) do
	if not v_u_4:IsA("TextButton") then
