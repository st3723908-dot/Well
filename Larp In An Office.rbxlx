Handle = Tool:WaitForChild("Handle")
Players = game:GetService("Players")
RunService = game:GetService("RunService")
UserInputService = game:GetService("UserInputService")
Animations = {}
LocalObjects = {}
ServerControl = Tool:WaitForChild("ServerControl")
ClientControl = Tool:WaitForChild("ClientControl")
InputCheck = Instance.new("ScreenGui")
InputCheck.Name = "InputCheck"
InputButton = Instance.new("ImageButton")
InputButton.Name = "InputButton"
InputButton.Image = ""
InputButton.BackgroundTransparency = 1
InputButton.ImageTransparency = 1
InputButton.Size = UDim2.new(1, 0, 1, 0)
InputButton.Parent = InputCheck
Rate = 0.016666666666666666
ToolEquipped = false
function SetAnimation(p1, p2) -- name: SetAnimation
	if p1 == "PlayAnimation" and (p2 and (ToolEquipped and Humanoid)) then
		for v3, v4 in pairs(Animations) do
			if v4.Animation ~= p2.Animation then
				continue
			end
			v4.AnimationTrack:Stop()
			table.remove(Animations, v3)
		end
		local v5 = Humanoid:LoadAnimation(p2.Animation)
		local v6 = Animations
		local v7 = {
			["Animation"] = p2.Animation,
			["AnimationTrack"] = v5
		}
		table.insert(v6, v7)
		v5:Play(p2.FadeTime, p2.Weight, p2.Speed)
	elseif p1 == "StopAnimation" and p2 then
		for v8, v9 in pairs(Animations) do
			if v9.Animation ~= p2.Animation then
				continue
			end
			v9.AnimationTrack:Stop(p2.FadeTime)
			table.remove(Animations, v8)
		end
	end
end
function CheckIfAlive() -- name: CheckIfAlive
	return Character and (Character.Parent and (Humanoid and (Humanoid.Parent and (Humanoid.Health > 0 and (Player and Player.Parent))))) and true or false
end
function Equipped(p_u_10) -- name: Equipped
	Character = Tool.Parent
	Player = Players:GetPlayerFromCharacter(Character)
	Humanoid = Character:FindFirstChild("Humanoid")
	ToolEquipped = true
	if CheckIfAlive() then
		Spawn(function()
			-- upvalues: (copy) p_u_10
			PlayerMouse = Player:GetMouse()
			p_u_10.Button1Down:connect(function()
				InvokeServer("Button1Click", {
					["Down"] = true
				})
			end)
			p_u_10.Button1Up:connect(function()
				InvokeServer("Button1Click", {
					["Down"] = false
				})
			end)
			local v11 = Player:FindFirstChild("PlayerGui")
			if v11 and UserInputService.TouchEnabled then
				InputCheckClone = InputCheck:Clone()
				InputCheckClone.InputButton.InputBegan:connect(function()
					InvokeServer("Button1Click", {
						["Down"] = true
					})
				end)
				InputCheckClone.InputButton.InputEnded:connect(function()
					InvokeServer("Button1Click", {
						["Down"] = false
					})
				end)
				InputCheckClone.Parent = v11
			end
		end)
	end
end
function Unequipped() -- name: Unequipped
	LocalObjects = {}
	if InputCheckClone and InputCheckClone.Parent then
		InputCheckClone:Destroy()
	end
	for _, v12 in pairs(Animations) do
		if not (v12 and v12.AnimationTrack) then
			continue
		end
		v12.AnimationTrack:Stop()
	end
	for _, v13 in pairs({ ObjectLocalTransparencyModifier }) do
		if not v13 then
			continue
		end
		v13:disconnect()
	end
	Animations = {}
	ToolEquipped = false
end
function InvokeServer(p_u_14, p_u_15) -- name: InvokeServer
	pcall(function()
		-- upvalues: (copy) p_u_14, (copy) p_u_15
		return ServerControl:InvokeServer(p_u_14, p_u_15)
	end)
end
function OnClientInvoke(p16, p_u_17) -- name: OnClientInvoke
	if p16 == "PlayAnimation" and (p_u_17 and (ToolEquipped and Humanoid)) then
		SetAnimation("PlayAnimation", p_u_17)
		return
	elseif p16 == "StopAnimation" and p_u_17 then
		SetAnimation("StopAnimation", p_u_17)
		return
	elseif p16 == "PlaySound" and p_u_17 then
		p_u_17:Play()
		return
	elseif p16 == "StopSound" and p_u_17 then
		p_u_17:Stop()
	else
		if p16 == "MousePosition" then
			return {
				["Position"] = PlayerMouse.Hit.p,
				["Target"] = PlayerMouse.Target
			}
		end
		if p16 == "SetLocalTransparencyModifier" and (p_u_17 and ToolEquipped) then
			pcall(function()
				-- upvalues: (copy) p_u_17
				local v18 = false
				for _, v19 in pairs(LocalObjects) do
					if v19 ~= p_u_17 then
						continue
					end
					v18 = true
				end
				if not v18 then
					local v20 = LocalObjects
					local v21 = p_u_17
					table.insert(v20, v21)
					if ObjectLocalTransparencyModifier then
						ObjectLocalTransparencyModifier:disconnect()
					end
					ObjectLocalTransparencyModifier = RunService.RenderStepped:connect(function()
						for v22, v23 in pairs(LocalObjects) do
							if v23.Object and v23.Object.Parent then
								local v24 = v23.Object.LocalTransparencyModifier
								if (v23.AutoUpdate or v24 ~= 1 and v24 ~= 0) and not v23.AutoUpdate then
									continue
								end
								v23.Object.LocalTransparencyModifier = v23.Transparency
							else
								table.remove(LocalObjects, v22)
							end
						end
					end)
				end
			end)
		end
	end
end
ClientControl.OnClientInvoke = OnClientInvoke
Tool.Equipped:connect(Equipped)
Tool.Unequipped:connect(Unequipped)]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX7084"><Properties><string name="Name">MouseIcon</string><ProtectedString name="Source"><![CDATA[Mouse_Icon = "rbxasset://textures/GunCursor.png"
Reloading_Icon = "rbxasset://textures/GunWaitCursor.png"
Tool = script.Parent
Mouse = nil
function UpdateIcon() -- name: UpdateIcon
	if Mouse then
		Mouse.Icon = Tool.Enabled and Mouse_Icon or Reloading_Icon
	end
end
function OnEquipped(p1) -- name: OnEquipped
	Mouse = p1
	UpdateIcon()
end
function OnChanged(p2) -- name: OnChanged
	if p2 == "Enabled" then
		UpdateIcon()
	end
