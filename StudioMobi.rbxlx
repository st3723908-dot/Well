v2.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_4, (copy) v_u_3
	if v_u_1.Text ~= "" then
		if table.find(v_u_4, v_u_1.Text) then
			v_u_3:Fire("Client", 0, "command", "> " .. v_u_1.Text)
			v_u_1.Text = ""
