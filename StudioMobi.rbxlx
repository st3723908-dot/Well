d">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><Color3 name="BackgroundColor3"><R>0.0901960805</R><G>0.0941176489</G><B>0.113725491</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.125</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949000001</XS><XO>0</XO><YS>0.150000006</YS><YO>0</YO></UDim2><int name="ZIndex">1000</int><string name="Name">API</string></Properties><Item class="UICorner" referent="RBX1998"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>4</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>4</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>4</O></UDim><UDim name="TopRightRadius"><S>0</S><O>4</O></UDim><string name="Name">UICorner</string></Properties></Item><Item class="TextLabel" referent="RBX1999"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">API</string><string name="Text">API</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">2</token><Vector2 name="AnchorPoint"><X>0</X><Y>1</Y></Vector2><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.800000012</YS><YO>0</YO></UDim2><int name="ZIndex">1000</int><string name="Name">TextLabel</string></Properties></Item></Item><Item class="ScrollingFrame" referent="RBX2000"><Properties><Vector2 name="AbsoluteCanvasSize"><X>125</X><Y>628.992065</Y></Vector2><Vector2 name="AbsoluteWindowSize"><X>125</X><Y>125</Y></Vector2><UDim2 name="CanvasSize"><XS>0</XS><XO>0</XO><YS>10</YS><YO>0</YO></UDim2><Color3 name="ScrollBarImageColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="ScrollBarThickness">0</int><bool name="Active">true</bool><Color3 name="BackgroundColor3"><R>0.247058824</R><G>0.258823544</G><B>0.325490206</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.25</XS><XO>0</XO><YS>0.970000029</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>125</XO><YS>0</YS><YO>125</YO></UDim2><bool name="Visible">false</bool><int name="ZIndex">1000</int><string name="Name">HelpFrame</string></Properties><Item class="UICorner" referent="RBX2001"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>4</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>4</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>4</O></UDim><UDim name="TopRightRadius"><S>0</S><O>4</O></UDim><string name="Name">UICorner</string></Properties></Item><Item class="TextLabel" referent="RBX2002"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">You can use your own AI API in Studio Mobi by entering your API key, the model name and the API URL.

API Key: Enter the API key issued by your AI provider.

Model: Enter the exact model name you want to use, including its full name. For example, gemini-3.6-flash.

API URL: Enter your provider&apos;s API endpoint. There are two formats:

1) Providers that put the key in the URL (such as Gemini): use {model} where the model name goes and {api} where your API key goes.

Model:
gemini-3.6-flash

API URL:
https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api}

2) OpenAI-compatible providers (Groq, OpenAI, OpenRouter, Together, Mistral, DeepSeek...): use the endpoint URL exactly as shown in the provider&apos;s documentation, WITHOUT {model} and WITHOUT {api}. Studio Mobi sends the model and the key for you.

Model:
llama-3.3-70b-versatile

API URL:
https://api.groq.com/openai/v1/chat/completions

Make sure your API key is valid, the model name is correct and the URL matches your provider&apos;s API format. With these providers, the Model field is required.

When you use your own API, your requests are subject to the limits and pricing set by your provider. Studio Mobi&apos;s default AI remains available separately.
</string><string name="Text">You can use your own AI API in Studio Mobi by entering your API key, the model name and the API URL.

API Key: Enter the API key issued by your AI provider.

Model: Enter the exact model name you want to use, including its full name. For example, gemini-3.6-flash.

API URL: Enter your provider&apos;s API endpoint. There are two formats:

1) Providers that put the key in the URL (such as Gemini): use {model} where the model name goes and {api} where your API key goes.

Model:
gemini-3.6-flash

API URL:
https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api}

2) OpenAI-compatible providers (Groq, OpenAI, OpenRouter, Together, Mistral, DeepSeek...): use the endpoint URL exactly as shown in the provider&apos;s documentation, WITHOUT {model} and WITHOUT {api}. Studio Mobi sends the model and the key for you.

Model:
llama-3.3-70b-versatile

API URL:
https://api.groq.com/openai/v1/chat/completions

Make sure your API key is valid, the model name is correct and the URL matches your provider&apos;s API format. With these providers, the Model field is required.

When you use your own API, your requests are subject to the limits and pricing set by your provider. Studio Mobi&apos;s default AI remains available separately.
</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">12</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1000</int><string name="Name">TextLabel</string></Properties><Item class="LocalScript" referent="RBX2003"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = game:GetService("Players")
local v2 = game:GetService("LocalizationService")
local v3 = script.Parent
if v3:IsA("TextLabel") or (v3:IsA("TextBox") or v3:IsA("TextButton")) then
	local v4 = v1.LocalPlayer.LocaleId
	if v4 == nil or v4 == "" then
		v4 = v2.RobloxLocaleId
	end
	local v5
	if type(v4) == "string" then
		v5 = v4:lower():match("^pt") ~= nil
	else
		v5 = false
	end
	if v5 then
		v3.Text = "Voc\195\170 pode usar sua pr\195\179pria API de IA no Studio Mobi informando sua chave de API, o nome do modelo e a URL da API.\n\nAPI Key: Insira sua chave de API fornecida pelo seu provedor de IA.\n\nModel: Insira o nome exato do modelo que deseja usar, incluindo o nome completo. Por exemplo, gemini-3.6-flash.\n\nAPI URL: Insira o endpoint da API do seu provedor. Existem dois formatos:\n\n1) Provedores que usam a chave dentro da URL (como o Gemini): use {model} onde vai o nome do modelo e {api} onde vai a chave.\n\nModel:\ngemini-3.6-flash\n\nAPI URL:\nhttps://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api}\n\n2) Provedores compat\195\173veis com OpenAI (Groq, OpenAI, OpenRouter, Together, Mistral, DeepSeek...): use a URL do endpoint exatamente como est\195\161 na documenta\195\167\195\163o, SEM {model} e SEM {api}. O Studio Mobi envia o modelo e a chave sozinho.\n\nModel:\nllama-3.3-70b-versatile\n\nAPI URL:\nhttps://api.groq.com/openai/v1/chat/completions\n\nCertifique-se de que sua chave de API seja v\195\161lida, que o nome do modelo esteja correto e que a URL corresponda ao formato da API do seu provedor. Nesses provedores, o Model \195\169 obrigat\195\179rio.\n\nAo utilizar sua pr\195\179pria API, suas solicita\195\167\195\181es estar\195\163o sujeitas aos limites e pre\195\167os definidos pelo seu provedor. A IA padr\195\163o do Studio Mobi continua dispon\195\173vel separadamente."
	end
else
	warn("[SMFX AI Help] script.Parent must be a TextLabel, TextButton or TextBox.")
end]]></ProtectedString></Properties></Item></Item></Item><Item class="UIStroke" referent="RBX2004"><Properties><Color3 name="Color"><R>0.0470588244</R><G>0.0509803928</G><B>0.0627451017</B></Color3><string name="Name">UIStroke</string></Properties></Item><Item class="TextButton" referent="RBX2005"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">Reset</string><string name="Text">Reset</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0</X><Y>1</Y></Vector2><Color3 name="BackgroundColor3"><R>0.321568638</R><G>0.345098048</G><B>0.423529416</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.349999994</XS><XO>0</XO><YS>0.958000004</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.300000012</XS><XO>0</XO><YS>0.150000006</YS><YO>0</YO></UDim2><int name="ZIndex">1000</int><string name="Name">Reset</string></Properties><Item class="LocalScript" referent="RBX2006"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = script.Parent
