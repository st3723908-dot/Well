local v_u_2 = game:GetService("TweenService")
local v_u_3 = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false)
TweenInfo.new(0.15, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false)
local v_u_4 = {
	["In"] = 0,
	["Out"] = 1
}
local v_u_5 = {
	["In"] = false,
	["Out"] = true
}
function v_u_1.PlayCameraFade(p6)
	-- upvalues: (copy) v_u_5, (copy) v_u_2, (copy) v_u_3, (copy) v_u_4
	local v7 = game.Players.LocalPlayer.PlayerGui:WaitForChild("CameraFade").Fade
	game.StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, v_u_5[p6])
	local v8 = { v_u_2:Create(v7, v_u_3, {
			["BackgroundTransparency"] = v_u_4[p6]
		}) }
	for _, v9 in pairs(v8) do
		v9:Play()
	end
end
local function v_u_14(p10) -- name: PlayDeathFade
	-- upvalues: (copy) v_u_5, (copy) v_u_2, (copy) v_u_3, (copy) v_u_4
	local v11 = game.Players.LocalPlayer.PlayerGui:FindFirstChild("SpawnFade").Fade
	game.StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, v_u_5[p10])
	local v12 = { v_u_2:Create(v11, v_u_3, {
			["BackgroundTransparency"] = v_u_4[p10]
		}) }
	for _, v13 in pairs(v12) do
		v13:Play()
	end
end
function v_u_1.DeathFlash()
	local v15 = game.Players.LocalPlayer.PlayerGui:FindFirstChild("SpawnFade").Fade
	v15.BackgroundTransparency = 0
	v15.BackgroundColor3 = Color3.new(1, 1, 1)
	wait(0.1)
