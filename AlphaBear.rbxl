end
function v_u_6.Execute() -- name: Execute
	-- upvalues: (copy) v_u_4, (copy) v_u_6
	local v17, v18 = v_u_4.Network:InvokeFunction("PrivateServer_Command", script.Name, v_u_6.payload)
	if v17 then
		v_u_6.Reset()
