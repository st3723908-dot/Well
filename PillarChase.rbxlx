		v_u_11.Item.Text = script.ShopStuff.Item.Value.Name
		v_u_11.Frame.Coins.CoinTXT.Text = script.ShopStuff.Cost.Value
		if script.ShopStuff.Item.Value:GetAttribute("CostRobux") then
			v_u_11.Frame.Robux.RobuxTXT.Text = script.ShopStuff.CostRobux.Value
		end
		if script.ShopStuff.Item.Value and (script.ShopStuff.Item.Value:GetAttribute("CostRobux") == nil and (script.ShopStuff.Item.Value.Value == false and (script.ShopStuff.Item.Value:GetAttribute("OnSale") and v_u_26 == false))) then
