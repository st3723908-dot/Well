v_u_1.Enabled = true
local v_u_2 = game:GetService("Players")
function GetCharacterFromPart(p3)
	-- upvalues: (copy) v_u_2
	local v4 = nil
	local v5 = next
	local v6, v7 = p3:GetChildren()
	for _, v8 in v5, v6, v7 do
		if not v8:IsA("Humanoid") then
			continue
		end
		v4 = p3
	end
	if not v4 then
		p3 = p3.Parent
		if p3 and p3 ~= game then
			break
		end
	end
	local v9
	if v4 then
		v9 = v_u_2:GetPlayerFromCharacter(v4)
	else
		v9 = v4
	end
	return v4, v9
end
v_u_1.Equipped:connect(function(p_u_10)
	-- upvalues: (copy) v_u_1
	p_u_10.Icon = "rbxasset://textures/GunCursor.png"
	p_u_10.Button1Down:connect(function()
		-- upvalues: (copy) p_u_10, (ref) v_u_1
		local v11 = p_u_10.Target
		local v12 = GetCharacterFromPart(v11)
		if v12 then
			v_u_1.SwapWith:FireServer(v12)
			p_u_10.Icon = "rbxasset://textures/GunWaitCursor.png"
			v_u_1.Enabled = false
			wait(2)
			p_u_10.Icon = "rbxasset://textures/GunCursor.png"
			v_u_1.Enabled = true
		end
	end)
