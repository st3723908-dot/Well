end
function UpdatePlayerList() -- name: UpdatePlayerList
	-- upvalues: (copy) v_u_7, (copy) v_u_1, (copy) v_u_6
	for v11, v12 in v_u_7 do
		if v_u_1:GetPlayerByUserId(v11) ~= nil then
			continue
		end
		v12:Destroy()
		v_u_7[v11] = nil
	end
	for _, v_u_13 in v_u_1:GetPlayers() do
		if v_u_13 == v_u_1.LocalPlayer or v_u_7[v_u_13.UserId] then
			continue
		end
