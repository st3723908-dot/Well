	-- upvalues: (copy) v_u_2, (copy) v_u_4, (copy) v_u_3
	local v5 = v_u_4
	local v6 = v_u_3
	v_u_2.Text = ""
	v5.Text = ""
	v6.Text = ""
end)]]></ProtectedString></Properties></Item><Item class="UICorner" referent="RBX2007"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>3</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>3</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>3</O></UDim><UDim name="TopRightRadius"><S>0</S><O>3</O></UDim><string name="Name">UICorner</string></Properties></Item></Item></Item></Item><Item class="UICorner" referent="RBX2008"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>0</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>6</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>6</O></UDim><UDim name="TopRightRadius"><S>0</S><O>6</O></UDim><string name="Name">UICorner</string></Properties></Item><Item class="ImageLabel" referent="RBX2009"><Properties><Content name="Image"><url>rbxthumb://type=Asset&amp;id=137773352828578&amp;w=420&amp;h=420</url></Content><Content name="ImageContent"><url>rbxthumb://type=Asset&amp;id=137773352828578&amp;w=420&amp;h=420</url></Content><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.00999999978</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1001</int><string name="Name">ImageLabel</string></Properties><Item class="UIAspectRatioConstraint" referent="RBX2010"><Properties><string name="Name">UIAspectRatioConstraint</string></Properties></Item></Item><Item class="TextButton" referent="RBX2011"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="An