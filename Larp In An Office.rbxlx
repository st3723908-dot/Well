function display_role() -- name: display_role
	-- upvalues: (copy) v_u_5, (copy) v_u_7, (copy) v_u_12, (copy) v_u_9, (copy) v_u_8, (copy) v_u_2, (copy) v_u_1, (copy) v_u_4
	repeat
		task.wait()
	until v_u_5:HasTag("Exe6PersonLoaded")
	local v13 = v_u_7.auth.Auth:InvokeServer("IsAuthorized", v_u_5.UserId)
	if v13 then
		v_u_12.frame.role.Text = v13.Role.Alias
		v_u_12.frame.role.BackgroundColor3 = v13.Role.Accent
		v_u_12.frame.role.TextColor3 = v_u_9.AdjustColor(v13.Role.Accent)
		v_u_12.frame.profile.Image = v_u_9.GetPlayerThumbnail(v_u_5.UserId)
		v_u_12.frame.display.Text = v_u_5.DisplayName
		v_u_12.frame.MouseButton1Click:Connect(function()
			-- upvalues: (ref) v_u_8, (ref) v_u_2, (ref) v_u_12
			v_u_8.Profile(true, v_u_2.LocalPlayer.UserId, v_u_12.frame)
		end)
		v_u_12.frame.MouseEnter:Connect(function()
			-- upvalues: (ref) v_u_1, (ref) v_u_12, (ref) v_u_4
			v_u_1:Create(v_u_12.frame, v_u_4, {
				["BackgroundColor3"] = Color3.fromRGB(47, 47, 47)
			}):Play()
		end)
		v_u_12.frame.MouseButton1Down:Connect(function()
			-- upvalues: (ref) v_u_1, (ref) v_u_12, (ref) v_u_4
			v_u_1:Create(v_u_12.frame, v_u_4, {
				["BackgroundColor3"] = Color3.fromRGB(20, 20, 20)
			}):Play()
		end)
		v_u_12.frame.InputEnded:Connect(function()
			-- upvalues: (ref) v_u_1, (ref) v_u_12, (ref) v_u_4
			v_u_1:Create(v_u_12.frame, v_u_4, {
				["BackgroundColor3"] = Color3.fromRGB(34, 34, 34)
			}):Play()
		end)
