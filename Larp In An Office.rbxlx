function EnableHotkeys() -- name: EnableHotkeys
	Connections.Hotkeys = Support.AddUserInputListener("Began", "Keyboard", false, function(_)
		local v16 = Support.GetListMembers(UserInputService:GetKeysPressed(), "KeyCode")
		local v17 = Support.FlipTable({
			"LeftAlt",
			"W",
			"S",
			"A",
			"D",
			"Space"
		})
		local v18 = {}
		for _, v19 in ipairs(v16) do
			if v17[v19.Name] then
				continue
			end
			table.insert(v18, v19)
		end
		local v20 = #v18
		table.sort(Hotkeys, function(p21, p22)
			if #p21.Keys > #p22.Keys then
				return true
			end
		end)
		for _, v23 in ipairs(Hotkeys) do
			if v20 ~= #v23.Keys then
				continue
			end
			local v24 = Support.FlipTable(v23.Keys)
			local v25 = 0
			for _, v26 in pairs(v18) do
				if not v24[v26] then
					continue
				end
				v25 = v25 + 1
			end
			if v25 ~= v20 then
				break
			end
			v23.Callback()
			return
		end
	end)
end
