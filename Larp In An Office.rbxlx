			end
		end
		if CanModifyItems(p80) then
			if not Security.ArePartsViolatingAreas(v81, Player, false) then
				for _, v84 in pairs(p80) do
					local v85 = LastParents[v84]
					LastParents[v84] = v84.Parent
					CreatedInstances[v84] = v84
					v84.Parent = v85
					if v84:IsA("BasePart") then
						v84:MakeJoints()
					else
						local v86 = Support.GetDescendantsWhichAreA(v84, "BasePart")
						for _, v87 in pairs(v86) do
