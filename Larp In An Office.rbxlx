			local v7 = typeof(v4) == "boolean" and "present" or "of type " .. v4
			local v8 = tostring(v3)
			local v9 = v_u_1[v3]
			local v10 = ("Expected public API member %q to be %s, but instead it was of type %s"):format(v8, v7, (typeof(v9)))
			error(v10)
