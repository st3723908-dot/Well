alse</bool><int name="ZIndex">999</int><string name="Name">PluginsFrame</string></Properties><Item class="LocalScript" referent="RBX610"><Properties><string name="Name">PluginsFrame</string><ProtectedString name="Source"><![CDATA[local v1 = game:GetService("ReplicatedStorage")
local v_u_2 = script.Parent
local v_u_3 = v1:WaitForChild("SMFX"):WaitForChild("Plugins")
local v_u_4 = v1:WaitForChild("SMFX"):WaitForChild("ScriptEditor"):WaitForChild("ConsoleB")
local v5 = require(script:WaitForChild("PluginsEdit"))
local v6 = v_u_2:WaitForChild("LeftFrame")
local v7 = v6:WaitForChild("Layout")
local v_u_8 = v_u_2:WaitForChild("Hub")
local v_u_9 = v_u_8:WaitForChild("Layout")
local v_u_10 = v_u_2:WaitForChild("Search")
local v11 = v_u_10:WaitForChild("Search")
local v_u_12 = v_u_2:WaitForChild("Filter")
local v_u_13 = v_u_2:WaitForChild("Create")
local v_u_14 = { "Popular", "New" }
local v_u_15 = v_u_9:WaitForChild("Install").BackgroundColor3
local v_u_16 = Color3.fromRGB(200, 55, 55)
local v_u_17 = {
	["tab"] = "Hub",
	["filter"] = nil,
	["query"] = "",
	["page"] = 0,
	["hasMore"] = false,
	["loading"] = false,
	["creating"] = false,
	["token"] = 0,
	["loadedAt"] = 0,
	["source"] = nil,
	["cards"] = nil,
	["filter"] = v_u_14[1],
	["source"] = {},
	["cards"] = {}
}
local v18 = table.concat({
	"PLUGIN RULES",
	"",
	"1. PUBLISHING",
	"- Press + to create a plugin. It starts as a draft with a random name and only appears in the Hub after you select its content and press Save.",
	"- Open a plugin\'s Settings (gear icon) to change its name, image, short description and content.",
	"- The content must be a Script, LocalScript or Folder. Any other object inside it is ignored.",
	"- A plugin is either a server plugin or a client plugin. A plugin that contains both a Script and a LocalScript is rejected, unless the Script is placed inside the LocalScript. In that case the whole plugin runs on the client.",
	"- A plugin must contain at least one script, at most 300 objects, at most 20 levels of nesting and at most 2 MB of data.",
	"- You can own up to 25 plugins.",
	"",
	"2. NAMES, IMAGES AND DESCRIPTIONS",
	"- Names are limited to 40 characters and short descriptions to 100 characters. Both go through Roblox text filtering.",
	"- The image must be a valid asset ID. If you do not set one, a default image is used.",
	"- Players who abuse the system may lose the ability to publish plugins.",
	"",
	"3. INSTALLING AND RUNNING",
	"- Installed plugins start automatically when you join the game and keep running until you uninstall them.",
	"- Server plugins run on the server on your behalf. Client plugins run only on your device.",
	"- You can install up to 25 plugins. Use the Installed tab to review and uninstall them.",
	"- When the author updates a plugin, your installed copy is updated automatically. If the author deletes it, it is uninstalled automatically.",
	"",
	"4. SECURITY",
	"- Plugins run inside a sandbox. Access to DataStoreService, MessagingService, MemoryStoreService, HttpService, TeleportService, MarketplaceService, BadgeService, GroupService, SocialService and to the editor\'s own systems (SMFX) is blocked.",
	"- Kicking and banning players (Player:Kick, Players:BanAsync, Players:UnbanAsync and Players:GetBanHistoryAsync) and shutting the server down (game:Shutdown) are not allowed and raise an error.",
	"- Prints, warnings and errors from your plugins are sent to the Output.",
	"- Install only plugins from authors you trust.",
	"",
	"5. DOWNLOADS, SEARCH AND SORTING",
	"- A download is counted when a plugin is installed. Installing your own plugin does not count.",
	"- The Search bar looks for plugins by name. Filter switches between Popular (most downloads) and New (most recent).",
	"- Create opens your Dashboard, where you can manage your plugins.",
	"",
	"6. EDITING AND DELETING",
	"- Only the author can edit or delete a plugin. Open Settings in the Dashboard (or on your plugin\'s card) to do it.",
	"- Changing the content publishes a new version. Players who have the plugin installed receive it automatically, even while they are playing.",
	"- Changing only the name, image or description does not restart the plugin.",
	"- Deleting a plugin requires two clicks on Delete. It removes the plugin for everyone and cannot be undone.",
	"",
	"7. LIMITS",
	"- Actions are rate limited. If you see a message asking you to slow down, wait a moment and try again.",
	"- Search results, plugin lists and download counters may take a short time to update.",
	"",
	"8. PROHIBITED CONTENT",
