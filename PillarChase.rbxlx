	-- upvalues: (copy) v_u_1
	if p4:IsA("ParticleEmitter") then
		v_u_1:RemoveEmitter(p4)
	end
end)]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12786"><Properties><string name="Name">UI_EmitterModule</string><int64 name="SourceAssetId">5745017050</int64><ProtectedString name="Source"><![CDATA[local v1 = {}
