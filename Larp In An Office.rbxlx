		v3[v4] = v6
		v4 = v4 + 1
	end
	return v3
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13591"><Properties><string name="Name">filterMap.spec</string><ProtectedString name="Source"><![CDATA[return function()
