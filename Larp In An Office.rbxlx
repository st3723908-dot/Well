function HandleFlightControl() -- name: HandleFlightControl
	if CheckIfAlive() then
		if FightMonitor then
			FightMonitor:disconnect()
		end
		FightMonitor = Torso.ChildAdded:connect(function(p2)
			if not Flying then
				if p2.Name == "FlightHold" then
					local v3 = Torso:FindFirstChild("FlightSpin")
					local v4 = Torso:FindFirstChild("FlightPower")
					local v5 = Torso:FindFirstChild("FlightHold")
					if not (v3 and (v4 and v5)) then
						return
					end
					Flying = true
					Humanoid.WalkSpeed = 0
					Humanoid.PlatformStand = true
					Humanoid.AutoRotate = false
					DisableJump(true)
					Torso.Velocity = Vector3.new(0, 0, 0)
					Torso.RotVelocity = Vector3.new(0, 0, 0)
					while Flying and (v3.Parent and (v4.Parent and (v5.Parent and CheckIfAlive()))) do
						local v6 = Vector3.new(0, 0, 0)
						local v7 = Camera.CoordinateFrame:vectorToWorldSpace(Vector3.new(0, 0, -1))
						local v8 = Camera.CoordinateFrame:vectorToWorldSpace(Vector3.new(-1, 0, 0))
						local v9 = Camera.CoordinateFrame
						local v10 = CFrame.new(Vector3.new(0, 0, 0), v9.lookVector * Vector3.new(1, 0, 1)):vectorToObjectSpace(Humanoid.MoveDirection)
						local v11 = v6 + (v7 * CameraSpeed.Z * -v10.z or v6)
						local v12 = v11 + (v8 * CameraSpeed.X * -v10.x or v11)
						v3.cframe = CFrame.new(Vector3.new(0, 0, 0), v7)
						if v12.magnitude < 1 then
							local v13 = v5.P
							local v14 = v5.P
							local v15 = v5.P
							v5.maxForce = Vector3.new(v13, v14, v15)
							v4.maxForce = Vector3.new(0, 0, 0)
							v5.position = Torso.Position
						else
							v5.maxForce = Vector3.new(0, 0, 0)
							local v16 = v4.P * 100
							local v17 = v4.P * 100
							local v18 = v4.P * 100
							v4.maxForce = Vector3.new(v16, v17, v18)
						end
						v4.velocity = v12
						wait(Rate)
					end
					Flying = false
					if CheckIfAlive() then
						Torso.Velocity = Vector3.new(0, 0, 0)
						Torso.RotVelocity = Vector3.new(0, 0, 0)
						Humanoid.WalkSpeed = 16
						Humanoid.PlatformStand = false
						Humanoid.AutoRotate = true
						DisableJump(false)
						Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
					end
				end
			end
		end)
	end
end
function SetAnimation(p19, p20) -- name: SetAnimation
	if p19 == "PlayAnimation" and (p20 and (ToolEquipped and Humanoid)) then
		for v21, v22 in pairs(Animations) do
			if v22.Animation ~= p20.Animation then
				continue
			end
			v22.AnimationTrack:Stop()
			table.remove(Animations, v21)
		end
		local v23 = Humanoid:LoadAnimation(p20.Animation)
		local v24 = Animations
		local v25 = {
			["Animation"] = p20.Animation,
			["AnimationTrack"] = v23
		}
		table.insert(v24, v25)
		v23:Play(p20.FadeTime, p20.Weight, p20.Speed)
	elseif p19 == "StopAnimation" and p20 then
		for v26, v27 in pairs(Animations) do
			if v27.Animation ~= p20.Animation then
				continue
			end
			v27.AnimationTrack:Stop()
			table.remove(Animations, v26)
		end
	end
end
function DisableJump(p28) -- name: DisableJump
	if PreventJump then
		PreventJump:disconnect()
	end
	if p28 then
