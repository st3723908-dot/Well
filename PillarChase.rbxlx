function v_u_4.GetMousePos(p83) -- name: GetMousePos
	-- upvalues: (copy) v_u_1, (copy) v_u_3
	local v84 = v_u_1:GetMouseLocation()
	if p83.Gui:IsA("ScreenGui") then
		local v85 = v_u_3.TopbarInset.Height
		return v84 - Vector2.new(0, v85)
	end
	if p83.Gui:IsA("PluginGui") then
		return p83.Gui:GetRelativeMousePosition()
	end
	local v86 = game.Workspace.CurrentCamera:ViewportPointToRay(v84.X, v84.Y)
	local v87, v88 = getScreenGuiWorldDetails(p83.Gui)
	local v89 = -(v86.Origin - v87):Dot(v88) / v86.Direction:Dot(v88)
	local v90 = v86.Origin + v86.Direction * v89
	local v91 = (-p83.Gui.Parent.CFrame:PointToObjectSpace(v90) + p83.Gui.Parent.Size / 2) * p83.Gui.PixelsPerStud
	return Vector2.new(v91.X, v91.Y)
end
