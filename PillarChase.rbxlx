			v11.Accel = v11.Accel + v11.Emitter.Acceleration * 100 * v11.Scale * v12 ^ 2 * p8 * v27
			v11.UI.Position = v11.StartPos + v33 + UDim2.new(0, v11.Accel.X, 0, -v11.Accel.Y)
		end
	end
	for _, v34 in pairs(v10) do
		v34.UI.ImageTransparency = 1
		local v35 = v_u_5
		local v36 = {
			["UI"] = v34.UI,
			["RemoveAt"] = tick() + 3 * v34.Emitter.Rate ^ (-1)
