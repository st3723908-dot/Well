	}),
	v1:Create(script.Parent, v2, {
		["Color3"] = Color3.fromRGB(255, 0, 255)
	})
}
while wait() do
	for _, v4 in pairs(v3) do
		v4:Play()
		wait(1)
	end
end]]></ProtectedString></Properties></Item></Item><Item class="Attachment" referent="RBX3081"><Properties><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><string name="Name">Attachment</string></Properties></Item><Item class="RigidConstraint" referent="RBX3082"><Properties><Ref name="Attachment1">RBX3081</Ref><string name="Name">RigidConstraint</string></Properties></Item></Item><Item class="Part" referent="RBX3083"><Properties><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>72.5774765</X><Y>291.237793</Y><Z>9020.02734</Z><R00>0.984651268</R00><R01>-0.0836639553</R01><R02>-0.153174236</R02><R10>0.168522894</R10><R11>0.684082091</R11><R12>0.709670186</R12><R20>0.0454099476</R20><R21>-0.724591017</R21><R22>0.687681675</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><PhysicalProperties name="CustomPhysicalProperties"><CustomPhysics>true</CustomPhysics><Density>0.00100000005</Density><Friction>0</Friction><Elasticity>0</Elasticity><FrictionWeight>1</FrictionWeight><ElasticityWeight>1</ElasticityWeight></PhysicalProperties><bool name="EnableFluidForces">false</bool><token name="LeftSurface">10</token><bool name="Massless">true</bool><token name="TopSurface">0</token><float name="Transparency">1</float><string name="Name">KnifeDisplay</string><Color3uint8 name="Color3uint8">4288914085</Color3uint8><BinaryString name="Tags">V2VhcG9uRGlzcGxheQ==</BinaryString></Properties><Item class="Part" referent="RBX3084"><Properties><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>72.583847</X><Y>291.185669</Y><Z>9020.08301</Z><R00>-0.173449323</R00><R01>-0.0193093624</R01><R02>0.984653711</R02><R10>0.973694324</R10><R11>-0.153374225</R11><R12>0.168511003</R12><R20>0.14776662</R20><R21>0.987979889</R21><R22>0.0454040319</R22></Coord