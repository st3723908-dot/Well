local v4 = v2:WaitForChild("update_rate").Value
local v_u_5 = (v4 < 0.25 or v4 > 2) and 1 or v4
local v_u_6 = 0
local v_u_7 = tick() - v_u_5
local v_u_8 = 1 / v_u_5
v1.run_service.RenderStepped:Connect(function()
	-- upvalues: (ref) v_u_7, (ref) v_u_5, (copy) v_u_3, (ref) v_u_6, (copy) v_u_8
	if v_u_5 <= tick() - v_u_7 then
		local v9 = v_u_3
		local v10 = v_u_6 * v_u_8
		local v11 = math.round(v10)
		v9.Text = tostring(v11) .. " FPS"
		v_u_6 = 0
		v_u_7 = tick()
	else
		v_u_6 = v_u_6 + 1
	end
end)]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX13368"><Properties><string name="Name">HandleSpawnLighting</string><ProtectedString name="Source"><![CDATA[repeat
