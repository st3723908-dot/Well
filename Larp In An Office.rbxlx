			v_u_124.Parent = v_u_23.scroll.people.others.scroll
		end
		v_u_124.MouseEnter:Connect(function()
			-- upvalues: (ref) v_u_2, (copy) v_u_124, (ref) v_u_9
			v_u_2:Create(v_u_124, v_u_9, {
				["BackgroundColor3"] = Color3.fromRGB(53, 53, 53)
