</YO></UDim2><bool name="Visible">false</bool><string name="Name">update</string></Properties><Item class="TextLabel" referent="RBX29123"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="LocalizedText">Here is what is coming to the game</string><string name="Text">Here is what is coming to the game</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><token name="BorderMode">1</token><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.0296296664</XS><XO>0</XO><YS>-0.000766600599</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.93902117</XS><XO>0</XO><YS>0.117117584</YS><YO>0</YO></UDim2><token name="SizeConstraint">1</token><int name="ZIndex">4</int><string name="Name">PublicBathroomSimulator</string></Properties><Item class="UIStroke" referent="RBX29124"><Properties><token name="LineJoinMode">2</token><float name="Thickness">3</float><float name="Transparency">0.800000012</float><string name="Name">UIStroke</string></Properties></Item></Item><Item class="TextLabel" referent="RBX29125"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/GothamSSm.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">I will add a bigger map,  new office themed tool items. You will be able to use TVs and computers. I will also add more rooms and fix bugs.

A new ui is also planned. This update will require significant time. Only one teammate and I are working on this game.

Im going  to animate the new tools for both R6 and R15 avatar types. I will remake all user interfaces. I will script every new feature.

I plan to keep the office space small. The map will be large enough for twenty players. I do not want it to be too big. don&apos;t get too exited, I am not an expert in all areas.</string><string name="Text">I will add a bigger map,  new office themed tool items. You will be able to use TVs and computers. I will also add more rooms and fix bugs.

A new ui is also planned. This update will require significant time. Only one teammate and I are working on this game.

Im going  to animate the new tools for both R6 and R15 avatar types. I will remake all user interfaces. I will script every new feature.

I plan to keep the office space small. The map will be large enough for twenty players. I do not want it to be too big. don&apos;t get too exited, I am not an expert in all areas.</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">15</float><token name="TextTruncate">1</token><bool name="TextWrapped">true</bool><bool name="Active">true</bool><Color3 name="BackgroundColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="BackgroundTransparency">0.800000012</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.0249999203</XS><XO>0</XO><YS>0.175044179</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.950000167</XS><XO>0</XO><YS>0.781148195</YS><YO>0</YO></UDim2><int name="ZIndex">3</int><string name="Name">Text Box</string></Properties><Item class="UITextSizeConstraint" referent="RBX29126"><Properties><string name="Name">UITextSizeConstraint</string></Properties></Item></Item><Item class="UICorner" referent="RBX29127"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>4</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>4</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>4</O></UDim><UDim name="TopRightRadius"><S>0</S><O>4</O></UDim><string name="Name">UICorner</string></Properties></Item></Item><Item class="Frame" referent="RBX29128"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.00999999978</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.075000003</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><string name="Name">LeftButtons</string></Properties><Item class="ImageButton" referent="RBX29129"><Properties><bool name="AutoButtonColor">false</bool><Color3 name="BackgroundColor3"><R>1</R