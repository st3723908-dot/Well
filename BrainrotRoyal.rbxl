	local randomNumber

	repeat
		randomNumber = math.random(1, #t1)

		if randomNumber ~= u7 or n1 < 2 then
			return randomNumber
		end

		n2 += 1
	until n2 >= 10

	return randomNumber
end

local function playRandomAnimation()
	local humanoid = scriptParent.Parent:FindFirstChildOfClass("Humanoid")

	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")

		if animator then
			local v3 = getRandomIndex()

			n1 = if v3 == u7 then n1 + 1 else 1
			u7 = v3

			local animationTrack = animator:LoadAnimation(t1[v3])
			animationTrack.Looped = false
			animationTrack:Play()

			if v3 == 1 then
				animationTrack:AdjustSpeed(1.5)
			else
				animationTrack:AdjustSpeed(1.2)
			end
		end
	end
end

scriptParent.Activated:Connect(function()
	if not u6 and not LocalPlayer:GetAttribute("OpeningChest") then
		u6 = true
		playRandomAnimation()
		task.wait(0.7)
		u6 = false
	end
end)

