game.Players.LocalPlayer:WaitForChild("InvLoaded")
repeat
	task.wait()
until game.Players.LocalPlayer:GetAttribute("Chance") and game.Players.LocalPlayer:GetAttribute("InputType")
local v1 = script.Parent
local v2 = require(v1.Icon)
local v_u_3 = game:GetService("TweenService")
local v_u_4 = game.Players.LocalPlayer.Inventory:WaitForChild("Coins")
local v_u_5 = game:GetService("MarketplaceService")
local v_u_6 = v2.new("Toggle Top Bar"):setName("Toggle Top Bar"):setTextColor(Color3.fromRGB(255, 255, 255)):setImage(13021320268, "Deselected"):setImage(13021320268, "Selected"):setCaption("Toggle Top Bar"):setImageScale(0.8, "Deselected"):debounce(0):setImageScale(0.8, "Selected"):autoDeselect():align("Left"):setEnabled(false)
local v_u_7 = v2.new("Coins"):setName("Coins"):setTextColor(Color3.fromRGB(255, 170, 0)):lock():setImageScale(1, "Deselected"):setImage(137124258802189, "Deselected"):setImage(137124258802189, "Selected"):setLabel(v_u_4.Value):setCaption("Coins"):align("Left")
local v_u_8 = v2.new("Queue Points"):setName("Queue Points"):setTextColor(Color3.fromRGB(255, 85, 85)):setImage(128422155334899, "Deselected"):setImage(128422155334899, "Selected"):setLabel(game.Players.LocalPlayer:GetAttribute("Chance")):setImageScale(1, "Deselected"):debounce(0):setImageScale(1, "Selected"):autoDeselect(true):oneClick():align("Left"):setCloseOnOutsideClick(true):setCaption("Queue Points"):modifyTheme({
	{ "IconImage", "ImageColor3", Color3.fromRGB(255, 85, 85) }
})
local v_u_9 = v2.new("Settings"):setName("Settings"):setLabel(""):setImage(124912899697693, "Deselected"):setImage(124912899697693, "Selected"):setImageScale(1, "Deselected"):debounce(0):setImageScale(0.75, "Selected"):autoDeselect(true):setCaption("Settings")
local v_u_10 = v2.new("Servers"):setName("Servers"):setLabel(""):setImage(116519424359941, "Deselected"):setImage(116519424359941, "Selected"):setImageScale(0.7, "Deselected"):debounce(0):setImageScale(0.55, "Selected"):autoDeselect(true):setCaption("Servers")
local v_u_11 = v2.new("Guides"):setName("Guides"):setLabel(""):setImage(5107159153, "Deselected"):setImage(5107159153, "Selected"):setImageScale(0.9, "Deselected"):debounce(0):setImageScale(0.75, "Selected"):autoDeselect(true):setCaption("Guides")
if game.Players.LocalPlayer:GetAttribute("InputType") == "Mobile" then
	v_u_11:setEnabled(false)
	v_u_10:setEnabled(false)
	v_u_9:setEnabled(false)
	v_u_8:setEnabled(false)
	v_u_7:setEnabled(false)
	v_u_6:setEnabled(true)
	v_u_6.selected:Connect(function()
		-- upvalues: (copy) v_u_11, (copy) v_u_10, (copy) v_u_9, (copy) v_u_8, (copy) v_u_7, (copy) v_u_6
		if v_u_11.isEnabled then
			v_u_11:setEnabled(false)
			v_u_10:setEnabled(false)
			v_u_9:setEnabled(false)
			v_u_8:setEnabled(false)
