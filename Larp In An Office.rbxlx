function EnterKeyforPeoplePage(p_u_164) -- name: EnterKeyforPeoplePage
	-- upvalues: (copy) v_u_154, (copy) v_u_2, (copy) v_u_10, (copy) v_u_11, (copy) v_u_9
	task.spawn(function()
		-- upvalues: (copy) p_u_164, (ref) v_u_154, (ref) v_u_2, (ref) v_u_10, (ref) v_u_11, (ref) v_u_9
		if p_u_164 then
			if not v_u_154.search.EnterKey:GetAttribute("Shown") then
				v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_10, {
					["Position"] = UDim2.fromScale(0, 1.5)
				}):Play()
				task.wait()
			end
			v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_11, {
				["Position"] = UDim2.fromScale(0, 0.5)
			}):Play()
		else
			if v_u_154.search.EnterKey:GetAttribute("Shown") then
				v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_10, {
					["Position"] = UDim2.fromScale(0, 0.5)
				}):Play()
				task.wait()
			end
			v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_9, {
				["Position"] = UDim2.fromScale(0, 1.5)
			}):Play()
		end
		v_u_154.search.EnterKey:SetAttribute("Shown", p_u_164)
	end)
end
v_u_154.search.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_154
	v_u_154.search.textbox:CaptureFocus()
end)
v_u_154.search.textbox:GetPropertyChangedSignal("Text"):Connect(function()
	-- upvalues: (copy) v_u_154
	SearchKeywordForPeoplePage()
	if v_u_154.search.textbox.Text:len() >= 3 and (v_u_154.search.textbox.Text:len() <= 20 and v_u_154.search.textbox.Text ~= "") then
		EnterKeyforPeoplePage(true)
	else
		EnterKeyforPeoplePage(false)
	end
end)
v_u_154.search.textbox.FocusLost:Connect(function(p165)
	-- upvalues: (copy) v_u_154, (copy) v_u_6, (copy) v_u_15, (copy) v_u_17
	if p165 and v_u_154.search.EnterKey:GetAttribute("Shown") then
		v_u_154.search.Interactable = false
		local function v166()
			-- upvalues: (ref) v_u_6, (ref) v_u_154
			return v_u_6:GetUserIdFromNameAsync(v_u_154.search.textbox.Text)
		end
		local v167, v168 = pcall(v166)
		if v167 then
			v_u_15.Profile(true, v168, v_u_154.search)
		else
			v_u_17.BannerNotify({
				["Header"] = "Failed to find the player.",
				["Description"] = "Error: Unknown Player",
				["Icon"] = "rbxassetid://11422144471"
			})
		end
	end
	v_u_154.search.Interactable = true
	EnterKeyforPeoplePage(false)
end)
v_u_154.refresh.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_31, (copy) v_u_154, (copy) v_u_2, (copy) v_u_9, (copy) v_u_6, (copy) v_u_24
	if not v_u_31.PeoplePage then
		v_u_31.PeoplePage = true
		v_u_154.refresh.icon.Rotation = 0
		v_u_2:Create(v_u_154.refresh.icon, v_u_9, {
			["Rotation"] = 360
		}):Play()
		for _, v169 in v_u_6:GetPlayers() do
			RemovePerson(v169, true)
		end
		for _, v170 in v_u_24.scroll.display.scroll:GetChildren() do
			if not v170:IsA("ImageButton") then
				continue
			end
			v170:Destroy()
		end
		InitiatePeople()
		SetFiltersForPeoplePage({
			["Category"] = "All"
		})
		v_u_31.PeoplePage = false
	end
end)
