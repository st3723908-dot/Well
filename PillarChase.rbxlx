><![CDATA[local v_u_1 = game:GetService("TweenService")
local _ = game.Players.LocalPlayer.PlayerGui.LobbyGUI.Darkness
task.spawn(function()
	-- upvalues: (copy) v_u_1
	repeat
		task.wait(0.08)
		v_u_1:Create(script.Parent, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			["Rotation"] = -0.11
		}):Play()
		script.Parent.AnchorPoint = Vector2.new(0.501, 0.5)
		task.wait(0.08)
		script.Parent.AnchorPoint = Vector2.new(0.499, 0.5)
		v_u_1:Create(script.Parent, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			["Rotation"] = 0.11
		}):Play()
	until not script
end)
script.Parent.Size = UDim2.new(0, 0, 0, 0)
script.Parent.WhoWin.UIScale.Scale = 0
script.Parent.GameOver.UIScale.Scale = 0
script.Parent.Visible = true
local v2 = game.Players.LocalPlayer:GetAttribute("EndCondition") or "You died."
if v2 == "You were locked in." or (v2 == "You died." or v2 == "MONSTER") then
	script.Parent.WhoWin.TextColor3 = Color3.fromRGB(255, 85, 85)
	script.Parent.Parent.Sounds.Monster:Play()
	script.Parent.Image = "rbxassetid://108799225864275"
else
	script.Parent.WhoWin.TextColor3 = Color3.fromRGB(255, 255, 85)
	script.Parent.Parent.Sounds.Survivors:Play()
	script.Parent.Image = "rbxassetid://74098831717207"
end
if game.Players.LocalPlayer:GetAttribute("EndCondition") then
	script.Parent.WhoWin.Text = "< " .. game.Players.LocalPlayer:GetAttribute("EndCondition") .. " >"
end
if v2 == "MONSTER" and game.Players.LocalPlayer:GetAttribute("EndCondition") then
	for _, v3 in pairs(game.Players:GetPlayers()) do
		if not v3:GetAttribute("EndCondition") or v3:GetAttribute("EndCondition") ~= "You survived." then
			continue
		end
		local v4 = workspace.Server.RoundHandler.PlrsAlive
		v4.Value = v4.Value + 1
	end
	script.Parent.WhoWin.Text = "< " .. workspace.Server.RoundHandler.PlrsAlive.Value .. " SURVIVORS REMAINED >"
end
v_u_1:Create(script.Parent, TweenInfo.new(0.5, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
	["Size"] = UDim2.new(0.62, 0, 0.528, 0)
}):Play()
v_u_1:Create(script.Parent, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["ImageTransparency"] = 0
}):Play()
task.wait(1)
v_u_1:Create(script.Parent.GameOver, TweenInfo.new(0.66, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["TextTransparency"] = 0
}):Play()
v_u_1:Create(script.Parent.GameOver.UIScale, TweenInfo.new(0.44, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
	["Scale"] = 1
}):Play()
task.wait(0.5)
v_u_1:Create(script.Parent.WhoWin, TweenInfo.new(0.88, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["TextTransparency"] = 0
}):Play()
v_u_1:Create(script.Parent.WhoWin.UIScale, TweenInfo.new(0.66, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
	["Scale"] = 1
}):Play()
task.wait(1.55)
v_u_1:Create(script.Parent.WhoWin, TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["TextTransparency"] = 1
}):Play()
v_u_1:Create(script.Parent, TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["ImageTransparency"] = 1
}):Play()
v_u_1:Create(script.Parent, TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["Size"] = UDim2.new(0, 0, 0, 0)
}):Play()
v_u_1:Create(script.Parent.GameOver, TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
	["TextTransparency"] = 1
}):Play()
task.wait(0.85)
