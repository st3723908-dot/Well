			v23 = Vector2.new(v21, v_u_1.CanvasPosition.Y)
		elseif v_u_1.ScrollingDirection == Enum.ScrollingDirection.Y then
			v23 = Vector2.new(v_u_1.CanvasPosition.X, v22)
