function format_date(_) -- name: format_date
	local v39 = os.date
	local v40 = tonumber(v39("%d"))
	return os.date("%A, %B ") .. v40
end
function get_greeting() -- name: get_greeting
	local v41 = os.date
	local v42 = tonumber(v41("%H"))
	return v42 >= 5 and v42 < 12 and "Good Morning, " or (v42 >= 12 and v42 < 17 and "Good Afternoon, " or (v42 >= 17 and v42 < 21 and "Good Evening, " or "Welcome, "))
end
