local v2 = script.Parent:WaitForChild("VisualizeBullet")
function VisualizeBullet(p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13) -- name: VisualizeBullet
	if p3 ~= game.Players.LocalPlayer and p4 then
		local v14 = (p4.CFrame * CFrame.new(p5.X, p5.Y, p5.Z)).p
		local v15 = (v14 - p6).magnitude / 2
		local v16 = Instance.new("Part")
		v16.Name = "Bullet"
		v16.Size = Vector3.new(0.01, 0.01, 0.01)
		v16.Transparency = 1
		v16.Anchored = false
		v16.CanCollide = false
		v16.TopSurface = Enum.SurfaceType.SmoothNoOutlines
		v16.BottomSurface = Enum.SurfaceType.SmoothNoOutlines
		local v_u_17 = p7:Clone()
		v_u_17.Parent = v16
		local v18 = Instance.new("Weld", v16)
		v18.Part0 = p4
		v18.Part1 = v16
		v18.C0 = CFrame.new(p5.X, p5.Y, p5.Z)
		v16.Position = v14
		v16.Parent = Workspace.CurrentCamera
		Spawn(function()
			-- upvalues: (copy) v_u_17
			v_u_17:Emit(5)
		end)
		game.Debris:AddItem(v16, 10)
		local v19 = Instance.new("Part")
		v19.Name = "Bullet"
		v19.Size = Vector3.new(0.01, 0.01, 0.01)
		v19.Transparency = 1
		v19.Anchored = true
		v19.CanCollide = false
		v19.TopSurface = Enum.SurfaceType.SmoothNoOutlines
		v19.BottomSurface = Enum.SurfaceType.SmoothNoOutlines
		local v_u_20 = p8:Clone()
		v_u_20.Parent = v19
		local v_u_21 = Instance.new("Sound", v19)
		v_u_21.SoundId = "rbxassetid://" .. p9
		v_u_21.Volume = 1
		v19.Position = p6
		v19.Parent = Workspace.CurrentCamera
		Spawn(function()
			-- upvalues: (copy) v_u_20, (copy) v_u_21
			v_u_20:Emit(2)
			v_u_21:Play()
		end)
		game.Debris:AddItem(v19, 10)
		if p10[1] and p12 then
			local v22 = Instance.new("Explosion")
			v22.BlastRadius = p10[2]
			v22.BlastPressure = 0
			v22.Position = p6
			v22.Parent = Workspace.CurrentCamera
		end
		if p13 then
			local v23 = Instance.new("Part")
			v23.Name = "Bullet"
			v23.Size = Vector3.new(0.2, 0.2, 0.2)
			v23.BrickColor = p11[3]
			v23.Transparency = p11[4]
			v23.Material = p11[5]
			v23.Anchored = true
			v23.CanCollide = false
			v23.TopSurface = Enum.SurfaceType.SmoothNoOutlines
			v23.BottomSurface = Enum.SurfaceType.SmoothNoOutlines
			local v24 = Instance.new("SpecialMesh", v23)
			v24.MeshType = Enum.MeshType.Brick
			v24.Scale = p11[2] * 5
			local v25 = -v24.Scale.Z / 10
			v24.Offset = Vector3.new(0, 0, v25)
			v23.CFrame = CFrame.new(v14, p6)
			v23.Parent = Workspace.CurrentCamera
			game.Debris:AddItem(v23, 10)
			if p11[1] == (1 / 0) then
				local v26 = p11[2].X
				local v27 = p11[2].Y
				local v28 = (v23.Position - p6).magnitude
				v24.Scale = Vector3.new(v26, v27, v28) * 5
				local v29 = -v24.Scale.Z / 10
				v24.Offset = Vector3.new(0, 0, v29)
				local v30 = game:GetService("RunService").Heartbeat:wait()
				while v23.Transparency < 1 do
					v23.Transparency = v23.Transparency + v30 / p11[6]
					v30 = game:GetService("RunService").Heartbeat:wait()
				end
			else
				for v31 = 0, v15, p11[1] do
					if v31 ~= 0 then
						v23.CFrame = v23.CFrame * CFrame.new(0, 0, -p11[1])
					end
					if (v23.Position - p6).magnitude < p11[2].Z then
						local v32 = p11[2].X
						local v33 = p11[2].Y
						local v34 = (v23.Position - p6).magnitude
						v24.Scale = Vector3.new(v32, v33, v34) * 5
						local v35 = -v24.Scale.Z / 10
						v24.Offset = Vector3.new(0, 0, v35)
					end
					game:GetService("RunService").Stepped:wait()
				end
			end
			if v23 then
				v23:Destroy()
			end
		end
	end
end
v1.Event:connect(VisualizeBullet)
v2.OnClientEvent:connect(VisualizeBullet)]]></ProtectedString></Properties><Item class="BindableEvent" referent="RBX6710"><Properties><string name="Name">Visualize</string></Properties></Item></Item><Item class="LocalScript" referent="RBX6711"><Properties><string name="Name">nothing</string><ProtectedString name="Source"><![CDATA[script.Parent.Equipped:Connect(function()
