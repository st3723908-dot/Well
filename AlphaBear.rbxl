local v5 = require(v2.GuiCollect)
local _ = v_u_4.Database
local _ = v5.GameUI.PrivateServerCommands
local v_u_6 = {
	["Name"] = "Kick Player",
	["payload"] = nil,
	["MenuFrame"] = nil,
	["Enabled"] = false,
	["MenuFrame"] = script.Frame
}
local v_u_7 = {}
function RefreshButtons() -- name: RefreshButtons
	-- upvalues: (copy) v_u_7, (copy) v_u_6
	for v8, v9 in v_u_7 do
		local v10 = v_u_6.payload
		if v10 then
			v10 = v_u_6.payload.UserId == v8
		end
		v9.BorderColor3 = v10 and Color3.new(1, 0, 0) or Color3.new(0, 0, 0)
