&quot;A01&quot; would use its extreme intelligence to make a plan and was able to break out from the facility it was being held in, causing many casualties. Its current whereabouts are unknown, and the team of scientists who contained it are still attempting to track it down.</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><UDim2 name="Position"><XS>0.720625341</XS><XO>0</XO><YS>0.479152769</YS><YO>0</YO></UDim2><float name="Rotation">-1</float><UDim2 name="Size"><XS>0.409380138</XS><XO>0</XO><YS>0.847833157</YS><YO>0</YO></UDim2><int name="ZIndex">55</int><string name="Name">Desc</string></Properties><Item class="UIGradient" referent="RBX13452"><Properties><ColorSequence name="Color">0 1 1 1 0 0.961937726 1 1 1 0 0.984429121 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">-90</float><string name="Name">UIGradient</string></Properties></Item></Item><Item class="TextLabel" referent="RBX13453"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">★★★</string><string name="Text">★★★</string><Color3 name="TextColor3"><R>1</R><G>0.70588237</G><B>0.117647067</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 na