		["number"] = p12.Radius
	}).number.value
	p12.RotationLimit = p11.InputNum({
		"Rotation Limit",
		0.1,
		0,
		180,
		"%.3f"
	}, {
		["number"] = p12.RotationLimit
	}).number.value
	p12.Anchored = p11.Checkbox({ "Anchored" }, {
		["isChecked"] = p12.Anchored
