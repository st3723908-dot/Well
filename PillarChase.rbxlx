/token><int name="ZIndex">999999999</int><string name="Name">MonsterIcon</string></Properties></Item><Item class="TextLabel" referent="RBX13515"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Kalam.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Niloticus also known as &quot;G-07α&quot; is a man-made creature that was developed under a nuclear power plant. 
It has incredibly dangerous radioactive abilities in which it can utilize to kill anything in its way. It uses these abilities to hunt down every single human it can find and intends to eradicate humanity from the face of the Earth.
Niloticus is nearly indestructible, having highly durable scales and an indestructible skeleton. It cannot be killed by human weapons and has yet to be stopped and still roams around the planet, cleansing the world of human life.</string><string name="Text">Niloticus also known as &quot;G-07α&quot; is a man-made creature that was developed under a nuclear power plant. 
It has incredibly dangerous radioactive abilities in which it can utilize to kill anything in its way. It uses these abilities to hunt down every single human it can find and intends to eradicate humanity from the face of the Earth.
Niloticus is nearly indestructible, having highly durable scales and an indestructible skeleton. It cannot be killed by human weapons and has yet to be stopped and still roams around the planet, cleansing the world of human life.</string><Color3 name="TextColor3"><R>0.254901975</R><G>0.203921586</G><B>0.160784319</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0.549019635</R><G>0.466666669</G><B>0.337254912</B></Color3><float name="TextTransparency">1</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><bool name="Interactable">false</bool><UDim2 name="Position"><XS>0.512901604</XS><XO>0</XO><YS>0.522064388</YS><YO>0</YO></UDim2><float name="Rotation">-0.5</float><UDim2 name="Size"><XS>0.87720114</XS><XO>0</XO><YS>0.928961992</YS><YO>0</YO></UDim2><int name="ZIndex">55</int><string name="Name">Desc</string></Properties><Item class="UIGradient" referent="RBX13516"><Properties><ColorSequence name="Color">0 1 1 1 0 0.961937726 1 1 1 0 0.984429121 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">-90</float><string name="Name">UIGradient</string></Properties></Item></Item></Item><Item class="ImageButton" referent="RBX13517"><Properties><Content name="Image"><url>rbxassetid://9680568214</url></Content><Color3 name="ImageColor3"><R>0.607843161</R><G>0</G><B>0</B></Color3><Content name="ImageContent"><url>rbxassetid://9680568214</url></Content><token name="ScaleType">3</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1