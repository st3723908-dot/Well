float><UDim2 name="Size"><XS>2</XS><XO>0</XO><YS>2</YS><YO>0</YO></UDim2><token name="SizeConstraint">2</token><int name="ZIndex">4</int><string name="Name">KnifeRight</string></Properties></Item></Item></Item></Item><Item class="LocalScript" referent="RBX27132"><Properties><string name="Name">PerkSystem</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("RunService")
local v_u_2 = game:GetService("GuiService")
local v_u_3 = require(game.ReplicatedStorage:WaitForChild("ClientServices"):WaitForChild("PerkService"))
local v_u_4 = game.Players.LocalPlayer
local v_u_5 = v_u_4:WaitForChild("PlayerGui")
local v_u_6 = nil
local v_u_7 = nil
local v_u_8 = nil
local v_u_9 = nil
local v_u_10 = nil
local function v_u_19(p_u_11) -- name: onPerkAdded
	-- upvalues: (copy) v_u_3, (copy) v_u_2, (ref) v_u_10, (ref) v_u_8, (ref) v_u_7, (ref) v_u_9, (ref) v_u_6
	local v12 = v_u_3:GetPerkInfo(p_u_11.Name)
	local v_u_13 = v_u_3.PerkButton
	while v_u_13 == nil do
		v_u_13 = v_u_3.PerkButton
		task.wait(0.1)
	end
	v_u_13.ControlText.Text = v12.DisplayName
	v_u_13.ControlIcon.Image = v12.Image
	if v_u_13:FindFirstChild("PassiveLabel") then
		v_u_13.PassiveLabel.Visible = v12.Passive == true
	end
	if v_u_13:FindFirstChild("UIGradient") then
		v_u_13.UIGradient.Enabled = v12.Passive ~= true
	end
	if v_u_13:FindFirstChild("Keybind") then
		v_u_13.Keybind.Visible = v12.Passive ~= true
	end
	if p_u_11.Name == "FakeGun" and v_u_2:IsTenFootInterface() then
		v_u_13.Keybind.Visible = true
	end
	v_u_13.Charges.Visible = v12.Charges ~= nil
	v_u_13.ControlIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
	local v_u_14 = nil
	v_u_14 = p_u_11.AncestryChanged:Connect(function()
		-- upvalues: (copy) p_u_11, (ref) v_u_14, (ref) v_u_10, (ref) v_u_13, (ref) v_u_3
		if not p_u_11:IsDescendantOf(game) then
			v_u_14:Disconnect()
			v_u_10 = nil
			v_u_13.Visible = false
			v_u_3.PerkIsActive = false
			if workspace:FindFirstChild("Footsteps") then
				workspace:FindFirstChild("Footsteps"):Destroy()
			end
			_G.Sleight = false
			_G.Ninja = false
			_G.Haste = false
		end
	end)
	local function v15() -- name: updatePerk
		-- upvalues: (ref) v_u_8, (copy) p_u_11, (ref) v_u_7, (ref) v_u_9
		v_u_8 = p_u_11:GetAttribute("ActiveTime")
		v_u_7 = p_u_11:GetAttribute("Cooldown")
		v_u_9 = p_u_11:GetAttribute("Charges")
	end
	local function v17() -- name: updateCharges
		-- upvalues: (copy) p_u_11, (ref) v_u_13, (ref) v_u_8, (ref) v_u_7, (ref) v_u_9
		local v16 = p_u_11:GetAttribute("Charges")
		if v16 then
			v_u_13.Charges.Text = "(" .. v16 .. ")"
			if v16 <= 0 then
				v_u_13.ControlIcon.ImageColor3 = Color3.fromRGB(90, 90, 90)
			end
			v_u_8 = p_u_11:GetAttribute("ActiveTime")
			v_u_7 = p_u_11:GetAttribute("Cooldown")
			v_u_9 = p_u_11:GetAttribute("Charges")
		end
	end
	p_u_11:GetAttributeChangedSignal("ActiveTime"):Connect(v15)
	p_u_11:GetAttributeChangedSignal("Cooldown"):Connect(v15)
	p_u_11:GetAttributeChangedSignal("LastUse"):Connect(function()
		-- upvalues: (ref) v_u_6
		v_u_6 = os.clock()
	end)
	p_u_11:GetAttributeChangedSignal("Charges"):Connect(v17)
	local v18 = p_u_11:GetAttribute("Charges")
	if v18 then
		v_u_13.Charges.Text = "(" .. v18 .. ")"
		if v18 <= 0 then
			v_u_13.ControlIcon.ImageColor3 = Color3.fromRGB(90, 90, 90)
		end
		v_u_8 = p_u_11:GetAttribute("ActiveTime")
		v_u_7 = p_u_11:GetAttribute("Cooldown")
		v_u_9 = p_u_11:GetAttribute("Charges")
	end
	v_u_8 = p_u_11:GetAttribute("ActiveTime")
	v_u_7 = p_u_11:GetAttribute("Cooldown")
	v_u_9 = p_u_11:GetAttribute("Charges")
	v_u_6 = -100
	v_u_10 = p_u_11
	v_u_13.Visible = true
	v_u_3.PerkIsActive = true
end
local function v_u_21(p20) -- name: onPlayerGuiChildAdded
	-- upvalues: (copy) v_u_19
	if p20:HasTag("Perk") then
		v_u_19(p20)
	end
