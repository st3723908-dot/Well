			expect(v_u_11).to.be.ok()
			expect(v_u_3.isBrio(v_u_11)).to.equal(true)
			expect(not v_u_11:IsDead()).to.equal(true)
			expect(v_u_11:GetValue()).to.be.a("table")
			expect(v_u_11:GetValue().value).to.equal(5)
			v13:Destroy()
		end)
	end)
	describe("RxBrioUtils.flatCombineLatest", function()
		-- upvalues: (ref) v_u_3, (ref) v_u_2, (ref) v_u_4
		local v_u_14 = nil
		local v_u_15 = v_u_3.new(5)
		local v_u_17 = v_u_2.flatCombineLatest({
			["value"] = nil,
			["otherValue"] = 25,
			["value"] = v_u_4.new(function(p_u_16)
