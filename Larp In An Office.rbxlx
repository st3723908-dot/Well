function SearchKeywordForBanPage() -- name: SearchKeywordForBanPage
	-- upvalues: (copy) v_u_25
	local v180 = string.lower(v_u_25.scroll.filter.search.textbox.Text)
	for _, v181 in v_u_25.scroll.display.scroll:GetChildren() do
		if not v181:IsA("ImageButton") then
			continue
		end
		if v180 == "" then
			v181.Visible = true
		else
			local v182 = { v181.Name, v181.info.mod.Text, v181.info.username.Text }
			local v183 = string.lower(table.concat(v182, ","))
			if string.find(v183, v180) then
				v181.Visible = true
			else
				v181.Visible = false
			end
		end
	end
end
