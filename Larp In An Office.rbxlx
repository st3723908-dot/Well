function update_meter() -- name: update_meter
	-- upvalues: (copy) v_u_6, (copy) v_u_23, (copy) v_u_2, (copy) v_u_9
	local v107 = #v_u_6:GetPlayers()
	local v108 = v_u_6.MaxPlayers
	local v109 = -180 + v107 / v108 * 100 * 1.8
	v_u_23.scroll.people.count.count.Text = v107 .. "/" .. v108
	v_u_2:Create(v_u_23.scroll.people.count.meter.line, v_u_9, {
		["Rotation"] = v109
	}):Play()
end
function update_counts_overview() -- name: update_counts_overview
	-- upvalues: (copy) v_u_6, (copy) v_u_14, (copy) v_u_24
	local v110 = #v_u_6:GetPlayers()
	local v111 = {}
	for _, v112 in v_u_6:GetPlayers() do
		local v113 = v_u_14.auth.Auth:InvokeServer("IsAuthorized", v112.UserId)
		if not (v112:HasTag("Exe6PersonLoaded") and v113) then
			continue
		end
		table.insert(v111, v112)
	end
	v_u_24.scroll.charts.max.count.Text = v_u_6.MaxPlayers
	v_u_24.scroll.charts.others.count.Text = v110 - #v111
	v_u_24.scroll.charts.people.count.Text = v110
	v_u_24.scroll.charts.team.count.Text = #v111
end
function PeoplePageSelection(p114, p115, p116) -- name: PeoplePageSelection
	-- upvalues: (copy) v_u_30, (copy) v_u_2, (copy) v_u_9, (copy) v_u_17
	if p116 then
		if #v_u_30.PeopleSelection < 50 then
			p114:SetAttribute("selected", true)
			local v117 = v_u_30.PeopleSelection
			local v118 = p115.UserId
			table.insert(v117, v118)
			v_u_2:Create(p114, v_u_9, {
				["BackgroundColor3"] = Color3.fromRGB(27, 27, 27)
			}):Play()
			v_u_2:Create(p114.select.blue.scale, v_u_9, {
				["Scale"] = 1
			}):Play()
		else
			v_u_17.BannerNotify({
				["Header"] = "Bulk Selection Limit Reached",
				["Description"] = "You can only select 50 players at a time.",
				["Icon"] = "rbxassetid://12974220720"
			})
		end
	else
		p114:SetAttribute("selected", false)
		table.remove(v_u_30.PeopleSelection, table.find(v_u_30.PeopleSelection, p115.UserId) or 0)
		v_u_2:Create(p114.select.blue.scale, v_u_9, {
			["Scale"] = 0
		}):Play()
		v_u_2:Create(p114, v_u_9, {
			["BackgroundColor3"] = Color3.fromRGB(27, 27, 27)
		}):Play()
	end
	UpdatePeopleSelection()
end
function OptionChosenActivation(p119, p120) -- name: OptionChosenActivation
	-- upvalues: (copy) v_u_15, (copy) v_u_22
	if p120 then
		if p120 == "View Profile" then
			v_u_15.Profile(true, p119)
			return
		end
		if p120 == "Ban" then
			v_u_15.Ban(true, { p119 })
			return
		end
		if p120 == "Kick" then
			v_u_15.Kick(true, { p119 })
			return
		end
		if p120 == "Warn" then
			v_u_15.Warn(true, { p119 })
			return
		end
		if p120 == "Notify" then
			v_u_15.Notify(true, { p119 })
			return
		end
		if p120 == "Chat History" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
				v_u_15.Profile(false)
			end
			v_u_15.ChatHistory(true, p119)
			return
		end
		if p120 == "Ban History" then
			v_u_15.BanHistory(true, false, p119)
			return
		end
		if p120 == "Warn History" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
				v_u_15.Profile(false)
			end
			v_u_15.WarnHistory(true, p119)
			return
		end
		if p120 == "Spectate" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
				v_u_15.Profile(false)
			end
			v_u_15.Spectate(true, p119)
		end
	end
end
function AddPerson(p_u_121, p122) -- name: AddPerson
	-- upvalues: (copy) v_u_14, (copy) v_u_23, (copy) v_u_16, (copy) v_u_2, (copy) v_u_9, (copy) v_u_15, (copy) v_u_24, (copy) v_u_1
	update_meter()
	update_counts_overview()
	local v123 = v_u_14.auth.Auth:InvokeServer("IsAuthorized", p_u_121.UserId)
	if table.find(p122, v_u_23) then
		local v_u_124 = v_u_23.scroll.people.list.item:Clone()
