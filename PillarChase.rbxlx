	script.Parent["true"].BorderColor3 = Color3.fromRGB(255, 0, 0)
	script.Parent["false"].BorderSizePixel = 1
	script.Parent["true"].BorderSizePixel = 0
	v_u_2 = false
end)
script.Parent.PlayerName.InputEnded:Connect(function()
	script.Parent.AdminUI.GetBanInfo:FireServer(script.Parent.PlayerName.Text)
end)
if game.Players.LocalPlayer.Name == "The_BladeNinja" or (game.Players.LocalPlayer.Name == "PhoenixFinch" or game.Players.LocalPlayer.Name == "Bowserson21") then
	script.Parent.Parent.Mobile.PF.Visible = true
	script.Parent.Parent.Mobile.PF.MouseButton1Down:Connect(function()
		workspace.Server.Timer.Tick:FireServer()
	end)
end]]></ProtectedString></Properties></Item><Item class="TextLabel" referent="RBX13628"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Ban Information</string><string name="Text">Ban Information</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>-0.0023791343</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.700000048</XS><XO>0</XO><YS>0.0943860561</YS><YO>0</YO></UDim2><string name="Name">TXT</string></Properties><Item class="UIGradient" referent="RBX13629"><Properties><ColorSequence name="Color">0 1 1 1 0 0.384083062 1 1 1 0 1 0.384313732 0.384313732 0.384313732 0 </ColorSequence><float name="Rotation">90</float><string name="Name">UIGradient</string></Properties></Item></Item><Item class="TextBox" referent="RBX13630"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/ComicNeueAngular.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><Color3 name="PlaceholderColor3"><R>0.699999988</R><G>0.699999988</G><B>0.699999988</B></Color3><string name="PlaceholderText">Enter Name Here</string><string name="Text"></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextStrokeTransparency">0.850000024</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X