			v_u_26 = true
			v_u_10:TweenSize(v_u_10:GetAttribute("FullSize"), "InOut", "Sine", 0.2, true)
			v_u_10.WhatDo.Text = "Finish Selection"
			v_u_10.Cost.Text = "Purchased"
		end
