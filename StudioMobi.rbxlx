roundColor3"><R>0.372549027</R><G>0.403921574</G><B>0.501960814</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.935000002</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988</XS><XO>0</XO><YS>0.949999988</YS><YO>0</YO></UDim2><int name="ZIndex">1000</int><string name="Name">Menu</string></Properties><Item class="LocalScript" referent="RBX489"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = script.Parent
local v2 = v1.Parent.Parent
