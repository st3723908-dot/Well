local v_u_59 = v_u_20.frame.content.properties
function animate_expiration_object(p_u_60) -- name: animate_expiration_object
	-- upvalues: (copy) v_u_59, (copy) v_u_1, (copy) v_u_6
	task.spawn(function()
		-- upvalues: (ref) v_u_59, (ref) v_u_1, (ref) v_u_6, (copy) p_u_60
		v_u_59.scroll.duration.box.textbox.Interactable = false
		v_u_59.scroll.duration.box.expiration.date.gradient.Offset = Vector2.new(-1, 0)
		v_u_59.scroll.duration.box.expiration.date.gradient.Rotation = 0
		v_u_1:Create(v_u_59.scroll.duration.box.expiration.date.gradient, v_u_6, {
			["Offset"] = Vector2.new(1, 0)
		}):Play()
		task.wait(0.5)
		v_u_59.scroll.duration.box.expiration.date.Text = p_u_60
		v_u_59.scroll.duration.box.expiration.date.gradient.Offset = Vector2.new(-1, 0)
		v_u_59.scroll.duration.box.expiration.date.gradient.Rotation = -180
		v_u_1:Create(v_u_59.scroll.duration.box.expiration.date.gradient, v_u_6, {
			["Offset"] = Vector2.new(1, 0)
		}):Play()
		v_u_1:Create(v_u_59.scroll.duration.box.expiration, v_u_6, {
			["Size"] = UDim2.new(0, v_u_59.scroll.duration.box.expiration.date.AbsoluteSize.X + 30, 1, -2)
		}):Play()
		task.wait(0.5)
		v_u_59.scroll.duration.box.textbox.Interactable = true
	end)
end
