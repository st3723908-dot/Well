				["Scale"] = 1.04
			}):Play()
		else
			v_u_17.BannerNotify({
				["Header"] = "Bulk Selection Limit Reached",
				["Description"] = "You can only select 50 players at a time.",
				["Icon"] = "rbxassetid://12974220720"
			})
		end
	else
		p193:SetAttribute("selected", false)
		table.remove(v_u_30.BanSelection, table.find(v_u_30.BanSelection, p194) or 0)
		v_u_2:Create(p193.select.blue.scale, v_u_9, {
			["Scale"] = 0
		}):Play()
		v_u_2:Create(p193, v_u_9, {
			["BackgroundColor3"] = Color3.fromRGB(29, 29, 29)
		}):Play()
	end
	UpdateBanSelection()
end
