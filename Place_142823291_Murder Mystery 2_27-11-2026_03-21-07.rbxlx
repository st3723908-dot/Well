local v_u_2 = require(game.ReplicatedStorage.Modules.InventoryModule)
local v_u_3 = require(game:GetService("ReplicatedStorage"):WaitForChild("Database"):WaitForChild("Sync"))
local v_u_4 = {
	[0] = "",
	[1] = "I",
	[2] = "II",
	[3] = "III",
	[4] = "IV",
