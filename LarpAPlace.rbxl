local u3 = nil
local contextActionService = game:GetService(&quot;ContextActionService&quot;)
local LocalPlayer = game:GetService(&quot;Players&quot;).LocalPlayer
local mouse = LocalPlayer:GetMouse()

function onAction()
	remote:FireServer(&quot;Activate&quot;, mouse.Hit.p)
end

function onEquipped(p1)
	onUnequipped()
	p1.Button1Down:connect(onAction)
end

function onUnequipped()
	contextActionService:UnbindAction(&quot;PenguinAttack&quot;)

	if u3 then
		u3:Destroy()
	end
end

function playAnimation(p1, ...)
	local foundChild = scriptParent:FindFirstChild(p1)
	local v3 = foundChild and scriptParent.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if v3 then
		v3:LoadAnimation(foundChild):Play(...)
	end
end

