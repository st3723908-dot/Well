		expect(v_u_1({ 1, 2, 2 }, 2)).to.equal(2)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22736"><Properties><string name="Name">findWhere</string><ProtectedString name="Source"><![CDATA[return function(p1, p2) -- name: findWhere
