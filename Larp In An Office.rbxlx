			["Bar"] = 1
		}
		local v15 = v_u_1({
			[v_u_2] = "Foo",
			["Bar"] = "BarValue"
		})
		expect(#v15).to.equal(2)
		for _, v16 in ipairs(v15) do
			expect(v14[v16]).never.to.equal(nil)
			v14[v16] = v14[v16] - 1
		end
		for _, v17 in pairs(v14) do
			expect(v17).to.equal(0)
		end
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28365"><Properties><string name="Name">values</string><ProtectedString name="Source"><![CDATA[return function(p1) -- name: values
