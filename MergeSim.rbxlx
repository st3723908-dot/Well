			expect(v_u_18).to.be.a("table")
			expect(v_u_3.isBrio(v_u_18)).to.equal(false)
			expect(v_u_18.value).to.equal(5)
			expect(v_u_18.otherValue).to.equal(25)
			v21:Destroy()
		end)
		it("should reset when the brio is killed", function()
			-- upvalues: (ref) v_u_19, (copy) v_u_15, (ref) v_u_18, (ref) v_u_3
			expect(v_u_19).to.equal(1)
