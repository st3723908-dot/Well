	local v3 = {}
	local v4 = 1
	for v5 = 1, #p1 do
		if p1[v5] == p2 then
			continue
		end
		v3[v4] = p1[v5]
		v4 = v4 + 1
	end
	return v3
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22754"><Properties><string name="Name">removeValue.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.removeValue)
