						["Size"] = UDim2.fromOffset(v287.X, v287.Y)
					}):Play()
					v_u_1:Create(v_u_38.scale, v_u_7, {
						["Scale"] = 1
					}):Play()
					local v289 = v_u_14.components.GetChatHistory:InvokeServer(p282)
					local v290 = v_u_14.auth.FetchUnsavedChats:InvokeServer(p282)
					if v290 then
						v289 = v_u_16.CombineTables(v289, v290)
					end
					if #v289 <= 0 then
