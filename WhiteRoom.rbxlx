local v_u_2 = game:GetService("ReplicatedStorage")
local v_u_3 = game:GetService("GroupService")
local v_u_4 = script.Parent
local v_u_5 = false
local v_u_6 = {
	["Dedicated"] = {
		["time"] = 500
	},
	["Loyal"] = {
		["time"] = 1000
	},
	["Godly"] = {
		["time"] = 5000
	},
	["Queen"] = {
		["time"] = 10000
	},
	["King"] = {
		["time"] = 15000
	}
}
local function v_u_10(p7) -- name: begin
	-- upvalues: (copy) v_u_4, (copy) v_u_1, (copy) v_u_6, (ref) v_u_5
	v_u_4.CanvasGroup.CurrenyRank.Text = v_u_1:GetRoleInGroup(6030362)
	v_u_4.CanvasGroup.CurrentMinutes.Text = p7 .. " Time"
	for _, v_u_8 in pairs(v_u_4.CanvasGroup.Ranks:GetChildren()) do
		if not v_u_8:IsA("Frame") or v_u_6[v_u_8.Name].time > p7 then
			continue
		end
		pcall(function()
			-- upvalues: (copy) v_u_8
			v_u_8.Frame:Destroy()
			v_u_8.Locked:Destroy()
		end)
	end
	local v9 = v_u_1:GetRankInGroup(6030362)
	if v9 > 39 then
		v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You reached the highest rank! Check back soon for more ranks."
		return
	elseif p7 >= 15000 then
		v_u_5 = true
		v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "Click to be ranked King!"
		return
	elseif p7 >= 10000 then
		if v9 > 29 then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You need " .. 15000 - p7 .. " Time to get the King rank."
		else
			v_u_5 = true
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "Click to be ranked Queen!"
		end
	elseif p7 >= 5000 then
		if v9 > 19 then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You need " .. 10000 - p7 .. " Time to get the Queen rank."
		else
			v_u_5 = true
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "Click to be ranked Godly Member!"
		end
	elseif p7 >= 1000 then
		if v9 > 9 then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You need " .. 5000 - p7 .. " Time to get the Godly Member rank."
		else
			v_u_5 = true
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "Click to be ranked Loyal Member!"
		end
	elseif p7 >= 500 then
		if v9 > 4 then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You need " .. 1000 - p7 .. " Time to get the Loyal Member rank."
		else
			v_u_5 = true
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "Click to be ranked Dedicated Member!"
		end
	else
		if p7 <= 499 then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You need " .. 500 - p7 .. " Time to get the Dedicated Member rank."
		end
		return
	end
end
v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.MouseButton1Click:Connect(function()
	-- upvalues: (ref) v_u_5, (copy) v_u_1, (copy) v_u_4, (copy) v_u_2, (copy) v_u_3
	if v_u_5 then
		if v_u_1:IsInGroup(6030362) then
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.Visible = false
			v_u_2.Whack:FireServer()
			task.wait(1)
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You should be ranked now!"
			v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.Visible = true
			return
		end
		v_u_4.CanvasGroup.CanvasGroup.AutomaticRanking.TextLabel.Text = "You must be in the Remote Security group to receive a rank."
		task.wait(3)
		v_u_3:PromptJoinAsync(6030362)
	end
end)
v_u_4:GetPropertyChangedSignal("Visible"):Connect(function()
	-- upvalues: (copy) v_u_4, (ref) v_u_5, (copy) v_u_10, (copy) v_u_1
	if v_u_4.Visible then
		v_u_5 = false
		v_u_10(v_u_1.leaderstats.Time.Value)
	end
end)]]></ProtectedString></Properties></Item><Item class="UICorner" referent="RBX1284"><Properties><UDim name="BottomLeftRadius"><S>0.0399999991</S><O>0</O></UDim><UDim name="BottomRightRadius"><S>0.0399999991</S><O>0</O></UDim><UDim name="TopLeftRadius"><S>0.0399999991</S><O>0</O></UDim><UDim name="TopRightRadius"><S>0.0399999991</S><O>0</O></UDim><string name="Name">UICorner</string></Properties></Item><Item class="UIStroke" referent="RBX1285"><Properties><Color3 name="Color"><R>0.764705956</R><G>0.764705956</G><B>0.764705956</B></Color3><float name="Thickness">2</float><string name="Name">UIStroke</string></Properties></Item><Item class="UIAspectRatioConstraint" referent="RBX1286"><Properties><float name="AspectRatio">1.72072077</float><string name="Name">UIAspectRatioConstraint</string></Properties></Item><Item class="CanvasGroup" referent="RBX1287"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><string name="Name">CanvasGroup</string></Properties><Item class="TextLabel" referent="RBX1288"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="LocalizedText">RANKS</string><string name="Text">RANKS</string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.500560999</XS><XO>0</XO><YS>0.064468734</YS><YO>0</YO></UDim2><U