function v_u_13.FormatSecondsToYWDHM(p98) -- name: FormatSecondsToYWDHM
	local v99 = {}
	for _, v100 in ipairs({
		{
			["name"] = "y",
			["seconds"] = 31536000
		},
		{
			["name"] = "w",
			["seconds"] = 604800
		},
		{
			["name"] = "d",
			["seconds"] = 86400
		},
		{
			["name"] = "h",
			["seconds"] = 3600
		},
		{
			["name"] = "m",
			["seconds"] = 60
		}
	}) do
