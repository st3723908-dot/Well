Reloading_Icon = "http://www.roblox.com/asset/?id=235619033"
Tool = script.Parent
Mouse = nil
function UpdateIcon() -- name: UpdateIcon
	if Mouse then
		Mouse.Icon = Tool.Enabled and Mouse_Icon or Reloading_Icon
	end
end
function OnEquipped(p1) -- name: OnEquipped
	Mouse = p1
	UpdateIcon()
end
function OnChanged(p2) -- name: OnChanged
	if p2 == "Enabled" then
		UpdateIcon()
	end
end
Tool.Equipped:connect(OnEquipped)
Tool.Changed:connect(OnChanged)]]></ProtectedString></Properties></Item><Item class="Part" referent="RBX6444"><Properties><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>290.836578</X><Y>-173.627396</Y><Z>-204.716415</Z><R00>0</R00><R01>1</R01><R02>0</R02><R10>-1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="CanCollide">false</bool><token name="Material">512</token><token name="TopSurface">0</token><string name="Name">Handle</string><Color3uint8 name="Color3uint8">4287723109</Color3uint8></Properties><Item class="Sound" referent="RBX6445"><Properties><Content name="AudioContent"><url>rbxassetid://9113597285</url></Content><float name="RollOffMaxDistance">100</float><Content name="SoundId"><url>rbxassetid://9113597285</url></Content><float name="Volume">0.300000012</float><string name="Name">Brush</string><int64 name="SourceAssetId">9113597285</int64></Properties></Item><Item class="ManualWeld" referent="RBX6446"><Properties><CoordinateFrame name="C0"><X>0</X><Y>0</Y><Z>0</Z><R00>0</R00><R01>-1</R01><R02>0</R02><R10>1</R10><R11>0</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><CoordinateFrame name="C1"><X>-0.00859069824</X><Y>2.22185469</Y><Z>-0.000732421875</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Ref name="Part0">RBX6444</Ref><Ref name="Part1">RBX6447</Ref><string name="Name">Weld</string></Properties></Item></Item><Item class="MeshPart" referent="RBX6447"><Properties><Content name="MeshContent"><url>rbxassetid://445956012</url></Content><Content name="MeshId"><url>rbxassetid://445956012</url></Content><token name="RenderFidelity">1</token><Content name="TextureID"><null></null></Content><Vector3 name="UnscaledCofm"><X>0</X><Y>0</Y><Z>0</Z></Vector3><Vector3 name="UnscaledVolInertiaDiags"><X>0.00211712322</X><Y>0.00144450506</Y><Z>0.00226245658</Z></Vector3><Vector3 name="UnscaledV