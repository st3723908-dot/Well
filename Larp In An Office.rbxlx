local v_u_2 = game:GetService("Players").LocalPlayer
local v3, v4 = pcall(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_2
	return v_u_1:GetPolicyInfoForPlayerAsync(v_u_2)
end)
if v3 and v4 then
	local v5 = v4.AllowedExternalLinkReferences
	local v6 = { "X", "Discord", "YouTube" }
	local v7 = 0
	for _, v8 in pairs(v5) do
		if not table.find(v6, v8) then
			continue
		end
		v7 = v7 + 1
	end
	if v7 < #v6 then
		script.Parent.Text = "See HD Admin\'s description (in Marketplace) for updates"
	end
end]]></ProtectedString></Properties></Item></Item><Item class="UICorner" referent="RBX26903"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>4</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>4</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>4</O></UDim><UDim name="TopRightRadius"><S>0</S><O>4</O></UDim><string name="Name">UICorner</string></Properties></Item></Item><Item class="UIListLayout" referent="RBX26904"><Properties><UDim name="Padding"><S>0.00999999978</S><O>0</O></UDim><token name="HorizontalAlignment">0</token><token name="SortOrder">2</token><token name="VerticalAlignment">0</token><string name="Name">UIListLayout</string></Properties></Item><Item class="Frame" referent="RBX26905"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">0.959999979</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.119999997</YS><YO>0</YO></UDim2><token name="SizeConstraint">1</token><int name="ZIndex">2003</int><string name="Name">MessageFrame</string></Properties><Item class="TextLabel" referent="RBX26906"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Roboto.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">🚀  &lt;b&gt;View Latest Updates&lt;/b&gt;</string><bool name="RichText">true</bool><string name="Text">🚀  &lt;b&gt;View Latest Updates&lt;/b&gt;</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><UDim2 name="Position"><XS>0.5</XS><