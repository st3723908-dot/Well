	local v_u_1 = require(script.Parent.keys)
	local v_u_2 = require(script.Parent.Parent.None)
	it("should not mutate the given table", function()
		-- upvalues: (copy) v_u_1
		local v3 = {
			["Foo"] = "FooValue",
			["Bar"] = "BarValue"
		}
		v_u_1(v3)
		local v4 = {
			["Foo"] = "FooValue",
			["Bar"] = "BarValue"
		}
		for v5, v6 in pairs(v3) do
			expect(v4[v5]).to.equal(v6)
		end
		for v7, v8 in pairs(v4) do
			expect(v3[v7]).to.equal(v8)
		end
	end)
	it("should return the correct keys", function()
		-- upvalues: (copy) v_u_1
		local v9 = v_u_1({
			["Foo"] = "FooValue",
			["Bar"] = "BarValue",
			["Test"] = "TestValue"
		})
		expect(#v9).to.equal(3)
		local v10 = {
			["Foo"] = 1,
			["Bar"] = 1,
			["Test"] = 1
		}
		for _, v11 in ipairs(v9) do
			expect(v10[v11]).never.to.equal(nil)
			v10[v11] = v10[v11] - 1
		end
		for _, v12 in pairs(v10) do
			expect(v12).to.equal(0)
		end
