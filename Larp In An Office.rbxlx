function v_u_50.Spectate(p258, p259) -- name: Spectate
	-- upvalues: (copy) v_u_48, (copy) v_u_5, (copy) v_u_17, (copy) v_u_14, (copy) v_u_26, (copy) v_u_18, (copy) v_u_16, (copy) v_u_1, (copy) v_u_7, (copy) v_u_10, (copy) v_u_12
