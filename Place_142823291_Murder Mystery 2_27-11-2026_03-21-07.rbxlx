local v3 = {
	v1:Create(script.Parent, v2, {
		["Color3"] = Color3.fromRGB(255, 0, 0)
	}),
	v1:Create(script.Parent, v2, {
		["Color3"] = Color3.fromRGB(255, 255, 0)
	}),
	v1:Create(script.Parent, v2, {
