function beat() -- name: beat
	-- upvalues: (copy) v_u_1
	for _ = 1, 5 do
		v_u_1.Scale = v_u_1.Scale + Vector3.new(0.03, 0.03, 0.03)
		wait(0.02)
	end
	for _ = 1, 5 do
		v_u_1.Scale = v_u_1.Scale - Vector3.new(0.03, 0.03, 0.03)
		wait(0.02)
	end
end
while true do
	wait(0.3)
	beat()
end]]></ProtectedString></Properties></Item><Item class="SpecialMesh" referent="RBX4044"><Properties><token name="MeshType">5</token><Content name="MeshContent"><url>http://www.roblox.com/asset/?id=192488915 </url></Content><Content name="MeshId"><url>http://www.roblox.com/asset/?id=192488915 </url></Content><Content name="TextureContent"><url>rbxassetid://192488947</url></Content><Content name="TextureId"><url>rbxassetid://192488947</url></Content><Vector3 name="Scale"><X>1.05999994</X><Y>1.05999994</Y><Z>1.05999994</Z></Vector3><string name="Name">Mesh</string><BinaryString name="Tags">X01pc3NpbmdOSUw=</BinaryString></Properties></Item></Item><Item class="MeshPart" referent="RBX4045"><Properties><Content name="MeshContent"><url>http://www.roblox.com/asset/?id=1185246</url></Content><Content name="MeshId"><url>http://www.roblox.com/asset/?id=1185246</url></Content><Content name="TextureID"><null></null></Content><Vector3 name="UnscaledCofm"><X>4.17716084e-09</X><Y>2.27043984e-09</Y><Z>-4.74937467e-09</Z></Vector3><Vector3 name="UnscaledVolInertiaDiags"><X>0.00848416612</X><Y>0.00848416612</Y><Z>0.0084828902</Z></Vector3><Vector3 name="UnscaledVolInertiaOffDiags"><X>-6.03860517e-10</X><Y>-9.30928834e-10</Y><Z>1.55471813e-09</Z></Vector3><float name="UnscaledVolume">0.175689906</float><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>542.576233</X><Y>55.2827797</Y><Z>-14.8713989</Z><R00>0</R00><R01>0</R01><R02>1</R02><R10>0.523747206</R10><R11>-0.851875067</R11><R12>0</R12><R20>0.851875186</R20><R21>0.523747742</R21><R22>0</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><float name="Transparency">1</float><string name="Name">PortalPart</string><Color3uint8 name="Color3uint8">4288914085</Color3uint8><Vector3 name="InitialSize"><X>0.696265996</X><Y>0.696708977</Y><Z>0.699999988</Z></Vector3></Properties><Item class="Script" referent="RBX4046"><Properties><token name="RunCo