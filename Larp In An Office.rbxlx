		end)).to.equal(4)
	end)
	it("should allow access to both value and index in the predicate function", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({
			1,
			1,
			2,
			2,
			1
		}, function(p8, p9)
			return p8 + p9 == 5
		end)).to.equal(3)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28376"><Properties><string name="Name">foldLeft</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3) -- name: foldLeft
