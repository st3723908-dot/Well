end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13613"><Properties><string name="Name">replaceIndex</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3) -- name: replaceIndex
	local v4 = #p1
	local v5 = p2 <= v4
	assert(v5, "index must be less or equal than the list length")
	local v6 = {}
	for v7 = 1, v4 do
