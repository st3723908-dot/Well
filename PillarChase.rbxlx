local function v_u_164(p149, p150, p151) -- name: Update3DModel
	-- upvalues: (copy) v_u_12, (ref) v_u_36
	for _, v152 in pairs(game.Players.LocalPlayer:GetChildren()) do
		if v152.Name ~= "3DModel" then
			continue
		end
		v152:Destroy()
	end
	for _, v153 in pairs(workspace.Viewport:GetChildren()) do
		if v153.Name ~= "3DModel" then
			continue
		end
		v153:Destroy()
	end
	if p149 == "MonsterModel" then
		local v154
		if p151 then
			v154 = p151:Clone()
			v154.Name = "3DModel"
			v154.HumanoidRootPart.Anchored = true
			v154:WaitForChild("HumanoidRootPart").CFrame = CFrame.new(0, 0, 0)
			if v154:FindFirstChild("Player") then
				v154.Player:Destroy()
			end
			if v154:FindFirstChildOfClass("AnimationController") then
				v154:FindFirstChildOfClass("AnimationController"):Destroy()
			end
			local v155 = Instance.new("Humanoid", v154)
			Instance.new("Animator", v155)
			v155.HipHeight = v154:GetAttribute("HipHeight")
			v154:SetAttribute("NewSpot", true)
			v154.Parent = game.Players.LocalPlayer
			task.wait(0.05)
		else
