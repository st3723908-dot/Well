v_u_9.ui.ConfirmationPromptClosed.Event:Connect(function(p157, p158)
	-- upvalues: (copy) v_u_11, (copy) v_u_9, (copy) v_u_30, (copy) v_u_13, (copy) v_u_12
	if p157 == "Warn" and p158 then
		v_u_11.TrackProgress(true, "Issuing Warn...")
		local v159 = v_u_9.Activities.Primary:InvokeServer("Warn", v_u_30:GetAttributes())
		if v159 then
			v_u_11.Warn(false)
			v_u_13.BannerNotify({
				["Header"] = "Warn Issued Successfully",
				["Description"] = nil,
				["Icon"] = "rbxassetid://11419712454",
				["Involved"] = nil,
				["Description"] = #v159.Success .. "/" .. #v159.All .. " has been successfully warned.",
				["Involved"] = v_u_12.ExtractTableContents(v159.Success, 1, 5)
			})
		else
			v_u_13.BannerNotify({
				["Header"] = "Issuing Warn Failed",
				["Description"] = "An error occurred while issuing a warn.",
				["Icon"] = "rbxassetid://11422144471"
			})
		end
		v_u_11.TrackProgress(false)
		return
	elseif p157 == "RemoveUnreadWarn" and not p158 then
		v_u_11.TrackProgress(true, "Removing Unread Warn...")
		local v160 = v_u_9.Activities.Primary:InvokeServer("RemoveUnreadWarn", v_u_30:GetAttributes())
		if v160 then
			v_u_11.Warn(false)
			v_u_13.BannerNotify({
				["Header"] = "Removed Unread Warnings Successfully",
				["Description"] = nil,
				["Icon"] = "rbxassetid://11419712454",
				["Involved"] = nil,
				["Description"] = #v160.Success .. "/" .. #v160.All .. " has been successfully warned.",
				["Involved"] = v_u_12.ExtractTableContents(v160.Success, 1, 5)
			})
		else
			v_u_13.BannerNotify({
				["Header"] = "Removing Unread Warnings Failed",
				["Description"] = "An error occurred while issuing a warn.",
				["Icon"] = "rbxassetid://11422144471"
			})
		end
		v_u_11.TrackProgress(false)
	elseif p157 == "Warn" and not p158 then
		v_u_13.BannerNotify({
			["Header"] = "Issuing Warn Failed",
			["Description"] = "An error occurred while attempting to warn.",
			["Icon"] = "rbxassetid://11422144471"
		})
	end
end)
