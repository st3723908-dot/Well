Tool = script.Parent
Plugin = Tool.Parent:IsA("Plugin") and Tool.Parent or nil
Mode = Plugin and "Plugin" or "Tool"
local v2 = Tool:WaitForChild("Loaded")
while not v2.Value do
	v2.Changed:Wait()
