operties><ColorSequence name="Color">0 1 1 1 0 0.776816607 1 1 1 0 0.870242238 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">90</float><string name="Name">UIGradient</string></Properties></Item></Item><Item class="Folder" referent="RBX13462"><Properties><string name="Name">Descs</string></Properties><Item class="ImageLabel" referent="RBX13463"><Properties><Content name="Image"><url>rbxassetid://82078639876371</url></Content><Content name="ImageContent"><url>rbxassetid://82078639876371</url></Content><token name="ResampleMode">1</token><token name="ScaleType">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><bool name="Interactable">false</bool><UDim2 name="Position"><XS>0.0820923746</XS><XO>0</XO><YS>0.162002981</YS><YO>0</YO></UDim2><float name="Rotation">0.5</float><UDim2 name="Size"><XS>0.407226086</XS><XO>0</XO><YS>0.555915713</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><string name="Name">Vapor</string></Properties><Item class="UIGradient" referent="RBX13464"><Properties><NumberSequence name="Transparency">0 0 0 0.753117204 0 0 1 1 0 </NumberSequence><string name="Name">UIGradient</string></Properties></Item><Item class="TextLabel" referent="RBX13465"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">In life Vapor was a secluded and angry man who lived out in the countryside. He loved to play with the flames, and many people fell victim to his obsession and hatred. 

It wasn&apos;t much longer until he ended up being the cause of his own demise, but while the flames consumed him, he heard a voice and decided to make a deal that ultimately sealed his fate.

Vapor is now a demonic soldier; after years of being punished for his actions, he is a pawn for the demons above him to use as they see fit.</string><string name="Text">In life Vapor was a secluded and angry man who lived out in the countryside. He loved to play with the flames, and many people fell victim to his obsession and hatred. 

It wasn&apos;t much longer until he ended up being the cause of his own demise, but while the flames consumed him, he heard a voice and decided to make a deal that ultimately sealed his fate.

Vapor is now a demonic soldier; after years of being punished for his actions, he is a pawn for the demons above him to use as they see fit.</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><UDim2 name="Position"><XS>0.720625341</XS><XO>0</XO><YS>0.479152769</YS><YO>0</YO></UDim2><float name="Rotation">-1</float><UDim2 name="Size"><XS>0.409380138</XS><XO>0</XO><YS>0.847833157</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><int name="ZIndex">55</int><string name="Name">Desc</string></Properties><Item class="UIGradient" referent="RBX13466"><Properties><ColorSequence name="Color">0 1 1 1 0 0.961937726 1 1 1 0 0.984429121 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">-90</float><string name="Name">UIGradient</string></Properties></Item></Item><Item class="TextLabel" referent="RBX13467"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">★★★★</string><string name="Text">★★★★</string><Color3 name="TextColor3"><R>1</R><G>0.70588237</G><B>0.117647067</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float>