local function v_u_239() -- name: PurchaseGo
	-- upvalues: (ref) v_u_25, (ref) v_u_23, (ref) v_u_22, (ref) v_u_26, (copy) v_u_10, (copy) v_u_11
	if v_u_25 == false and (script.ShopStuff.Item.Value and (v_u_23 == false and v_u_22 == false)) then
