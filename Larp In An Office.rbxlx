return function(...) -- name: join
	-- upvalues: (copy) v_u_1
	local v2 = {}
	for v3 = 1, select("#", ...) do
		local v4 = select(v3, ...)
		local v5 = #v2
		for v6 = 1, #v4 do
			if v4[v6] == v_u_1 then
				v5 = v5 - 1
			else
				v2[v5 + v6] = v4[v6]
			end
		end
	end
	return v2
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28384"><Properties><string name="Name">join.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.join)
	local v_u_2 = require(script.Parent.Parent.None)
	it("should return a new table", function()
		-- upvalues: (copy) v_u_1
		local v3 = {}
		expect(v_u_1(v3)).never.to.equal(v3)
	end)
	it("should remove elements equal to None", function()
		-- upvalues: (copy) v_u_2, (copy) v_u_1
		local v4 = v_u_1({ "foo-a" }, { v_u_2, "foo-b" })
		expect(v4[1]).to.equal("foo-a")
		expect(v4[2]).to.equal("foo-b")
		expect(v4[3]).to.equal(nil)
	end)
	it("should accept arbitrary numbers of tables", function()
		-- upvalues: (copy) v_u_1
		local v5 = v_u_1({ 1 }, { 2 }, { 3 })
		expect(#v5).to.equal(3)
		expect(v5[1]).to.equal(1)
		expect(v5[2]).to.equal(2)
		expect(v5[3]).to.equal(3)
	end)
	it("should accept zero tables", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1()).to.be.a("table")
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28385"><Properties><string name="Name">map</string><ProtectedString name="Source"><![CDATA[return function(p1, p2) -- name: map
