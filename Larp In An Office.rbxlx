	local v3 = {}
	local v4 = 1
	for v5 = 1, #p1 do
		local v6 = p1[v5]
		if not p2(v6, v5) then
			continue
		end
		v3[v4] = v6
		v4 = v4 + 1
	end
	return v3
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22731"><Properties><string name="Name">filter.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.filter)
	it("should call the callback for each element", function()
		-- upvalues: (copy) v_u_1
		local v2 = { "foo1", "foo2", "foo3" }
		local v_u_3 = {}
		v_u_1(v2, function(p4, p5) -- name: copyCallback
			-- upvalues: (copy) v_u_3
			v_u_3[p5] = p4
			return true
		end)
		for v6, v7 in pairs(v2) do
			expect(v_u_3[v6]).to.equal(v7)
		end
		for v8, v9 in pairs(v_u_3) do
			expect(v9).to.equal(v2[v8])
		end
	end)
	it("should correctly use the filter callback", function()
		-- upvalues: (copy) v_u_1
		local v11 = v_u_1({
			1,
			2,
			3,
			4,
			5
		}, function(p10) -- name: evenOnly
			return p10 % 2 == 0
		end)
		expect(#v11).to.equal(2)
		expect(v11[1]).to.equal(2)
		expect(v11[2]).to.equal(4)
	end)
	it("should copy the list correctly", function()
		-- upvalues: (copy) v_u_1
		local v12 = { 1, 2, 3 }
		local v13 = v_u_1(v12, function() -- name: keepAll
			return true
		end)
		expect(v13).never.to.equal(v12)
		for v14, v15 in pairs(v12) do
			expect(v13[v14]).to.equal(v15)
		end
		for v16, v17 in pairs(v13) do
			expect(v17).to.equal(v12[v16])
		end
	end)
	it("should work with an empty table", function()
		-- upvalues: (copy) v_u_1
		local v_u_18 = false
		local v19 = v_u_1({}, function() -- name: callback
			-- upvalues: (ref) v_u_18
			v_u_18 = true
			return true
		end)
		expect(#v19).to.equal(0)
		expect(v_u_18).to.equal(false)
	end)
	it("should remove all element from a list when callback return always false", function()
		-- upvalues: (copy) v_u_1
		local v20 = v_u_1({
			6,
			2,
			8,
			6,
			7
		}, function() -- name: removeAll
			return false
		end)
		expect(#v20).to.equal(0)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22732"><Properties><string name="Name">filterMap</string><ProtectedString name="Source"><![CDATA[return function(p1, p2) -- name: filterMap
	local v3 = {}
	local v4 = 1
	for v5 = 1, #p1 do
		local v6 = p2(p1[v5], v5)
		if v6 == nil then
			continue
		end
		v3[v4] = v6
		v4 = v4 + 1
	end
	return v3
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22733"><Properties><string name="Name">filterMap.spec</string><ProtectedString name="Source"><![CDATA[return function()
