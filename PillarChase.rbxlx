script.Parent.Visible = v_u_1.Value
v_u_1.Changed:Connect(function()
	-- upvalues: (copy) v_u_1
	script.Parent.Visible = v_u_1.Value
end)]]></ProtectedString></Properties></Item></Item><Item class="ImageLabel" referent="RBX13537"><Properties><Content name="Image"><url>rbxassetid://96713433513790</url></Content><Content name="ImageContent"><url>rbxassetid://96713433513790</url></Content><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.512951851</XS><XO>0</XO><YS>0.500139117</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><token name="SizeConstraint">2</token><bool name="Visible">false</bool><int name="ZIndex">99999999</int><string name="Name">VoteGUI</string></Properties><Item class="LocalScript" referent="RBX13538"><Properties><bool name="Disabled">true</bool><string name="Name">WorkVOTE</string><ProtectedString name="Source"><![CDATA[game:GetService("TweenService")
game.Players.LocalPlayer:WaitForChild("InvLoaded")
repeat
	task.wait(0.05)
until game.Players.LocalPlayer.PlayerGui and game.Players.LocalPlayer.PlayerGui:FindFirstChild("LoadingGUI") == nil
if game.Players.LocalPlayer.Inventory.VoteNumber.Value ~= script.Parent:GetAttribute("VoteNumber") then
	workspace.VoteGiver.VoteAttach.AlertFX.Enabled = true
	workspace.VoteGiver.ProximityPrompt.Enabled = true
	if game.Players.LocalPlayer.Inventory.ProfileStats.Playtime.Value < 10800 then
		workspace.VoteGiver.ProximityPrompt.ActionText = "You must have atleast 3 hours of playtime!"
	end
end
local v_u_1 = false
script.Parent.Close.MouseButton1Down:Connect(function()
	-- upvalues: (ref) v_u_1
	if v_u_1 == false then
		v_u_1 = true
		if script.Parent.Visible then
			script.Parent:TweenSize(UDim2.new(0, 0, 0, 0), "InOut", "Sine", 0.15, true)
			task.wait(0.15)
			script.Parent.Visible = false
		else
			script.Parent:TweenSize(UDim2.new(0.88, 0, 0.88, 0), "InOut", "Sine", 0.15, true)
			script.Parent.Visible = true
		end
		v_u_1 = false
	end
end)
workspace.VoteGiver.ProximityPrompt.Triggered:Connect(function()
	-- upvalues: (ref) v_u_1
	if v_u_1 == false and game.Players.LocalPlayer.Inventory.ProfileStats.Playtime.Value >= 10800 then
		v_u_1 = true
		if script.Parent.Visible then
			script.Parent:TweenSize(UDim2.new(0, 0, 0, 0), "InOut", "Sine", 0.15, true)
			task.wait(0.15)
			script.Parent.Visible = false
		else
			script.Parent:TweenSize(UDim2.new(0.88, 0, 0.88, 0), "InOut", "Sine", 0.15, true)
			script.Parent.Visible = true
		end
		v_u_1 = false
	end
end)
for _, v_u_2 in pairs(script.Parent.VoteSelect.ScrollingFrame:GetDescendants()) do
	if not (v_u_2:IsA("ImageButton") and workspace.VoteData:FindFirstChild(v_u_2.Parent.Name)) then
		continue
	end
	if game.Players.LocalPlayer.Inventory.PollData[v_u_2.Parent.Name].Value then
		v_u_2.Parent.Visible = false
	end
	v_u_2.MouseButton1Down:Connect(function()
		-- upvalues: (copy) v_u_2
		v_u_2.Parent.Visible = false
		workspace.VoteData[v_u_2.Parent.Name]:FireServer(v_u_2.TXT.Text)
	end)
end]]></ProtectedString></Properties></Item><Item class="Frame" referent="RBX13539"><Properties><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.660000026</XS><XO>0</XO><YS>0.699999988</YS><YO>0</YO></UDim2><int name="ZIndex">9999</int><string name="Name">VoteSelect</string></Properties><Item class="ScrollingFrame" referent="RBX13540"><Properties><token name="AutomaticCanvasSize">2</token><UDim2 name="CanvasSize"><XS>0</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><bool name="Active">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">456456</int><string name="Name">ScrollingFrame</string></Properties><Item class="UIListLayout" referent="RBX13541"><Properties><UDim name="Padding"><S>0.00999999978</S><O>0</O></UDim><token name="SortOrder">2</token><string name="Name">UIListLayout</string></Properties></Item><Item class="Frame" referent="RBX13542"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>0.879999995</XS><XO>0</XO><YS>0.100000001</YS><YO>0</YO></UDim2><string name="Name">Thoughts on client sided task set?</string></Properties><Item class="ImageButton" referent="RBX13543"><Properties><Cont