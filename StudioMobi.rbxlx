local v_u_2 = v1:FindFirstAncestor("AIFrame")
local v_u_3 = v1:WaitForChild("MCP")
v_u_3:GetPropertyChangedSignal("Text"):Connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	v_u_2:SetAttribute("MCP", v_u_3.Text)
end)
v_u_2:GetAttributeChangedSignal("MCP"):Connect(function()
