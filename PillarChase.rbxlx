cal v1 = game.Players.LocalPlayer
local v_u_2 = game:GetService("TeleportService")
local v_u_3 = require(game.ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CreateFunctions"))
v1:WaitForChild("InvLoaded")
script.Parent:GetPropertyChangedSignal("Visible"):Connect(function()
	if script.Parent.Visible then
		for _, v4 in pairs(script.Parent.Holder:GetChildren()) do
			if not v4:IsA("TextButton") then
				continue
			end
			v4:Destroy()
		end
		script.GetServers:FireServer()
	end
end)
script.Parent:WaitForChild("Reset").MouseButton1Down:Connect(function()
	for _, v5 in pairs(script.Parent.Holder:GetChildren()) do
		if not v5:IsA("TextButton") then
			continue
		end
		v5:Destroy()
	end
	script.GetServers:FireServer()
end)
script.Parent:WaitForChild("Holder").ChildAdded:Connect(function(p_u_6)
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	p_u_6.MouseButton1Down:Connect(function()
		-- upvalues: (ref) v_u_2, (copy) p_u_6, (ref) v_u_3
		v_u_2:TeleportToPlaceInstance(p_u_6:GetAttribute("PlaceId"), p_u_6:GetAttribute("ServerId"), game.Players.LocalPlayer)
		v_u_3.CreateNotificationBigMessage(game.Players.LocalPlayer, "Attemping to teleport, please wait!")
	end)
end)
script:WaitForChild("GetServers").OnClientEvent:Connect(function(p7, p8, p9, p10, p11, p12)
	local v13 = script.Server:Clone()
	v13.Players.Text = p7 .. "/" .. game.Players.MaxPlayers
	v13.Region.Text = p8
	v13.Round.Text = tostring(p9)
	if not p9 then
		v13.Round.TextColor3 = Color3.fromRGB(255, 0, 0)
	end
	v13.Uptime.Text = math.ceil(p10)
	v13:SetAttribute("ServerId", p11)
	v13:SetAttribute("PlaceId", p12)
	v13.Parent = script.Parent.Holder
	v13.LayoutOrder = -p7
end)]]></ProtectedString></Properties><Item class="RemoteEvent" referent="RBX17062"><Properties><string name="Name">GetServers</string></Properties><Item class="Script" referent="RBX17063"><Properties><string name="Name">Script</string><ProtectedString name="Source"><![CDATA[-- source not available for Script]]></ProtectedString></Properties></Item></Item><Item class="TextButton" referent="RBX17064"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0</float><float name="TextTransparency">1</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.22787863</XS><XO>0</XO><YS>0.190943807</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.0799999982</YS><YO>0</YO></UDim2><int name="ZIndex">3</int><string name="Name">Server</string></Properties><Item class="UIGradient" referent="RBX17065"><Properties><ColorSequence name="Color">0 1 1 1 0 0.384083062 1 1 1 0 1 0.384313732 0.384313732 0.384313732 0 </ColorSequence><float name="Rotation">90</float><string name="Name">UIGradient</string></Properties></Item><Item class="UIScale" referent="RBX17066"><Properties><string name="Name">UIScale</string></Properties></Item><Item class="TextButton" referent="RBX17067"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Unknown</string><stri