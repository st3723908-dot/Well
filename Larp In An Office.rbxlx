	local v_u_1 = require(script.Parent.findWhere)
	it("should return the correct index", function()
		-- upvalues: (copy) v_u_1
		local v2 = {
			1,
			5,
			10,
			7
		}
		expect(v_u_1(v2, function(p3)
			return p3 % 2 == 0
		end)).to.equal(3)
		expect(v_u_1(v2, function(p4)
			return p4 % 2 == 1
		end)).to.equal(1)
	end)
	it("should work with an empty table", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({}, function()
			return true
		end)).to.equal(nil)
	end)
	it("should return nil when the when no value satisfies the predicate", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({ 1, 2, 3 }, function(p5)
			return p5 == 4
		end)).to.equal(nil)
	end)
	it("should return the index of the first value for which the predicate is true", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({
			1,
			1,
			1,
			2,
			2
		}, function(p6)
			return p6 == 2
		end)).to.equal(4)
	end)
	it("should allow access to table index in the predicate function", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({
			5,
			4,
			3,
			2,
			1
		}, function(_, p7)
			return p7 == 4
		end)).to.equal(4)
	end)
	it("should allow access to both value and index in the predicate function", function()
		-- upvalues: (copy) v_u_1
		expect(v_u_1({
			1,
			1,
			2,
			2,
			1
		}, function(p8, p9)
			return p8 + p9 == 5
		end)).to.equal(3)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13596"><Properties><string name="Name">foldLeft</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3) -- name: foldLeft
