	else
		v_u_6.MenuFrame.Output.Text = v18
	end
end
function v_u_6.Enable() -- name: Enable
	-- upvalues: (copy) v_u_6
	if not v_u_6.Enabled then
		v_u_6.Enabled = true
		v_u_6.Reset()
	end
end
function v_u_6.Disable() -- name: Disable
	-- upvalues: (copy) v_u_6
	if v_u_6.Enabled then
		v_u_6.Enabled = false
	end
end
v_u_6.MenuFrame.ExecuteButton.MouseButton1Click:Connect(v_u_6.Execute)
