							local v298 = v297.list.chat:Clone()
							v297.header.header.label.Text = v293.Calender.Month.Long .. " " .. v293.Calender.Day .. ", " .. v293.Calender.Year.Long
							v297.Name = v294
							v297.LayoutOrder = -v_u_16.GetEpochStats(v292.Timestamp, "days", "year")
							v297.Parent = v_u_38.frame.content.scroll
							v298.time.label.Text = v293.Time.Hour .. ":" .. v293.Time.Minutes .. v293.Time.Period
							v298.message.Text = v292.Message
							v298.Name = v293.Time.Hour .. v293.Time.Minutes .. v293.Time.Seconds .. v293.Time.Period
							v298.LayoutOrder = -v_u_16.GetEpochStats(v292.Timestamp, "minutes", "day")
