<ProtectedString name="Source"><![CDATA[local v_u_1 = game.ReplicatedStorage:WaitForChild("SMFX"):WaitForChild("Play")
game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
local v_u_2 = game.Players.LocalPlayer
local v_u_3 = script.Parent
v_u_2:GetAttributeChangedSignal("SMFXPlay"):Connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	if v_u_2:GetAttribute("SMFXRun") then
		return
	elseif v_u_2:GetAttribute("SMFXPlay") == true then
		v_u_3.Visible = true
		game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	else
		v_u_3.Visible = false
		game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
	end
end)
v_u_3.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_1
	v_u_1:FireServer(false)
end)]]></ProtectedString></Properties></Item><Item class="TextButton" referent="RBX715"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">18</float><Color3 name="BackgroundColor3"><R>0.160784319</R><G>0.180392161</G><B>0.215686277</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>1.20000005</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.449999988</YS><YO>0</YO></UDim2><int name="ZIndex">99999</int><string name="Name">Console</string></Properties><Item class="LocalScript" referent="RBX716"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = script.Parent
