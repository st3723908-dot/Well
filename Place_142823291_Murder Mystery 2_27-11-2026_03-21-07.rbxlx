local v_u_2 = {
	["Weapons"] = true,
	["Pets"] = true
}
local v_u_3 = require(game:GetService("ReplicatedStorage"):WaitForChild("Database"):WaitForChild("Sync")).Rarities
function v1.GetImage(p4) -- name: GetImage
	if _G.Cache[p4] ~= nil then
		return _G.Cache[p4]
	end
	local v5
	if tonumber(p4) then
		v5 = "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=250&height=250&assetId=" .. p4 or p4
	else
		v5 = p4
	end
	local v6 = v5 .. "&bust=" .. math.random(1, 10000)
	_G.Cache[p4] = v6
	return v6
end
function v1.GetImageSmall(p7) -- name: GetImageSmall
	if _G.SmallCache[p7] ~= nil then
		return _G.SmallCache[p7]
	end
	local v8
	if tonumber(p7) then
		v8 = "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=110&height=110&assetId=" .. p7 or p7
	else
		v8 = p7
	end
	local v9 = v8 .. "&bust=" .. math.random(1, 10000)
	_G.SmallCache[p7] = v9
	return v9
end
local v_u_20 = {
	["Chroma"] = function(p10, p11)
		p10.Tags.Chroma.Visible = p11.Chroma == true
	end,
	["FX"] = function(p12, p13)
		p12.Tags.FX.Visible = p13.FX == true
	end,
	["Evo"] = function(p14, p15)
		p14.Tags.Evo.Visible = p15.EvoBaseID ~= nil
	end,
	["Halloween"] = function(p16, p17)
		-- upvalues: (copy) v_u_2
		if not v_u_2[p17.DataType] then
			p16.Tags.Halloween.Visible = p17.Event == "Halloween"
			p16.Tags.Halloween.Year.Text = p17.Year or ""
		end
	end,
	["Christmas"] = function(p18, p19)
		-- upvalues: (copy) v_u_2
		if not v_u_2[p19.DataType] then
			p18.Tags.Christmas.Visible = p19.Event == "Christmas"
			p18.Tags.Christmas.Year.Text = p19.Year or ""
		end
	end
}
function v1.DisplayItem(p_u_21, p_u_22, p23, p24)
	-- upvalues: (copy) v_u_3, (copy) v_u_20
	if p_u_22 == nil then
		p_u_21.ItemName.Label.Text = ""
		p_u_21.Container.Icon.Image = ""
		p_u_21.Container.Amount.Text = ""
		p_u_21.ItemName.BackgroundColor3 = Color3.fromRGB(95, 95, 95)
		for _, v25 in pairs(p_u_21.Tags:GetChildren()) do
			if not v25:IsA("Frame") then
				continue
			end
			v25.Visible = false
		end
	else
		p_u_21.ItemName.Label.Text = p_u_22.ItemName or p_u_22.Name
		p_u_22.Rarity = p_u_22.Rarity or "Common"
		local v26 = v_u_3[p_u_22.Rarity].Color
		local v27 = Color3.fromRGB(v26.r, v26.g, v26.b) or Color3.new(1, 1, 1)
		p_u_21.ItemName.BackgroundColor3 = v27
		local v28 = p_u_21.Container.Icon
		local v29 = p_u_22.Image
		local v30
		if _G.Cache[v29] == nil then
			local v31
			if tonumber(v29) then
				v31 = "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=250&height=250&assetId=" .. v29 or v29
			else
				v31 = v29
			end
			v30 = v31 .. "&bust=" .. math.random(1, 10000)
			_G.Cache[v29] = v30
		else
			v30 = _G.Cache[v29]
		end
		v28.Image = v30
		if p_u_21.Container:FindFirstChild("Amount") then
			local v32 = p23 or p_u_22.Amount
			p_u_21.Container.Amount.Text = v32 and (v32 > 1 and "x" .. v32) or ""
		end
		if p_u_21.Container:FindFirstChild("Classic") then
			p_u_21.Container.Classic.Visible = p_u_22.Classic ~= nil
		end
		if p_u_21.ItemName:FindFirstChild("ColoredName") then
			p_u_21.ItemName.ColoredName.Text = p_u_22.ItemName or p_u_22.Name
			if p_u_22.Rarity == "Common" then
				v27 = Color3.new(1, 1, 1)
			end
			p_u_21.ItemName.ColoredName.TextColor3 = v27
			p_u_21.ItemName.RarityBar.BackgroundColor3 = v27
		end
		if p_u_21:FindFirstChild("Tags") then
			for v33, v34 in pairs(v_u_20) do
				if not p_u_21.Tags:FindFirstChild(v33) then
					continue
				end
				v34(p_u_21, p_u_22)
			end
		end
		if p_u_22.Signature then
			local v35 = p_u_22.Signature
			if v35 ~= "" then
				p_u_21.Tags.Unique.PlayerName.Text = v35 .. "\'s"
				p_u_21.Tags.Unique.Visible = true
				if tonumber(v35) then
					spawn(function()
						-- upvalues: (copy) p_u_21, (copy) p_u_22
						local v36 = p_u_21.Tags.Unique.PlayerName
						local v37 = game.Players
						local v38 = p_u_22.Signature
						v36.Text = v37:GetNameFromUserIdAsync((math.abs(v38))) .. "\'s"
					end)
				end
			end
			p_u_21.Container.Amount.Text = p_u_22.Rank and "#" .. p_u_22.Rank or ""
		end
		if p24 and p_u_21:FindFirstChild("Tags") then
			for _, v39 in pairs(p_u_21.Tags:GetChildren()) do
				if not v39:IsA("Frame") or v39.Visible ~= false then
					continue
				end
				v39:Destroy()
			end
			if #p_u_21.Tags:GetChildren() == 1 then
				p_u_21.Tags:Destroy()
			end
		end
	end
end
function v1.Commafy(p40)
	local v41 = tostring(p40)
	repeat
		local v42
		v41, v42 = string.gsub(v41, "^(-?%d+)(%d%d%d)", "%1,%2")
		k = v42
	until k == 0
	return v41
end
function v1.AnimateItemIconIntoInventory(p43, p_u_44, p45)
	local v_u_46 = p43:Clone()
