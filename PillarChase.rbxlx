local v2 = script:WaitForChild("StunAnim")
local v3 = v1.Animator:LoadAnimation(v2)
local v4 = script:WaitForChild("Time").Value
local v5 = script.Parent:WaitForChild("Aspects")
for _, v6 in pairs(script.Parent:GetChildren()) do
	if v6.Name ~= "Stun" or v6 == script then
		continue
	end
	v6:Destroy()
end
for _, v7 in pairs(script.Parent:GetDescendants()) do
	if not v7:IsA("LinearVelocity") then
		continue
	end
	v7:Destroy()
end
v5.Stunned.Value = true
v1.WalkSpeed = 0
v1.AutoRotate = false
v3:Play()
task.wait(v4)
v3:Stop()
v5.Stunned.Value = false
if v5.BeingGrabbed.Value == nil and v5.Health.Value > 0 then
	v1.WalkSpeed = v5.WalkSpeed.Value
	v1.AutoRotate = true
	script:Destroy()
end]]></ProtectedString></Properties><Item class="Animation" referent="RBX10595"><Properties><string name="Name">StunAnim</string></Properties></Item><Item class="NumberValue" referent="RBX10596"><Properties><string name="Name">Time</string></Properties></Item></Item><Item class="Script" referent="RBX10597"><Properties><bool name="Disabled">true</bool><string name="Name">SpeedUp</string><ProtectedString name="Source"><![CDATA[-- source not available for SpeedUp]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX10598"><Properties><bool name="Disabled">true</bool><string name="Name">Invisible</string><ProtectedString name="Source"><![CDATA[-- source not available for Invisible]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX10599"><Properties><string name="Name">ValemGUI</string></Properties><Item class="LocalScript" referent="RBX10600"><Properties><string name="Name">GuiEffect</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game.TweenService
