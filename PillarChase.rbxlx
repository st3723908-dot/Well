	end)
end]]></ProtectedString></Properties></Item><Item class="TextLabel" referent="RBX16673"><Properties><Font name="FontFace"><Family><url>rbxassetid://12187375194</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Click on a button to view rundown</string><string name="Text">Click on a button to view rundown</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0.25</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.513235867</XS><XO>0</XO><YS>0.121555842</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.623528302</XS><XO>0</XO><YS>0.0570825785</YS><YO>0</YO></UDim2><string name="Name">InvName</string></Properties><Item class="UIGradient" referent="RBX16674"><Properties><ColorSequence name="Color">0 1 1 1 0 0.384083062 1 1 1 0 1 0.384313732 0.384313732 0.384313732 0 </ColorSequence><float name="Rotation">90</float><string name="Name">UIGradient</string></Properties></Item><Item class="UIScale" referent="RBX16675"><Properties><string name="Name">UIScale</string></Properties></Item></Item><Item class="ImageLabel" referent="RBX16676"><Properties><Content name="Image"><url>rbxassetid://96713433513790</url></Content><Content name="ImageContent"><url>rbxassetid://96713433513790</url></Content><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><bool name="Interactable">false</bool><UDim2 name="Position"><X