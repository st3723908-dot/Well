function setPlaybackSpeed(p1)
	remote:FireServer(&quot;SetPlaybackSpeed&quot;, p1 or 1)
end

function setTimePosition(p1)
	remote:FireServer(&quot;SetTimePosition&quot;, p1 or 0)
end

function setPitch(p1)
	remote:FireServer(&quot;SetPitch&quot;, p1 or 1)
end

function onRemote(p1, ...)
	if p1 == &quot;PlayAnimation&quot; then
		playAnimation(...)
	end

	if p1 == &quot;ChooseSong&quot; then
		chooseSong()
	end
end

scriptParent.Equipped:connect(onEquipped)
scriptParent.Unequipped:connect(onUnequipped)
remote.OnClientEvent:connect(onRemote)
