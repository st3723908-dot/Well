local v_u_1 = game:GetService("UserInputService")
local v_u_2 = game.Players.LocalPlayer:WaitForChild("Settings")
if v_u_1.MouseEnabled or v_u_1.GamepadEnabled then
	game.Players.LocalPlayer:SetAttribute("HasMouse", true)
	script.Parent:WaitForChild("Mouse").Visible = true
end
local function v_u_3() -- name: AutoCheck
	-- upvalues: (copy) v_u_1
	if v_u_1.TouchEnabled then
		game.Players.LocalPlayer:SetAttribute("InputType", "Mobile")
	end
	if v_u_1.KeyboardEnabled and v_u_1.MouseEnabled then
		game.Players.LocalPlayer:SetAttribute("InputType", "Keyboard")
	end
	if v_u_1.GamepadEnabled then
		game.Players.LocalPlayer:SetAttribute("InputType", "Gamepad")
	end
	if v_u_1.GamepadEnabled and not v_u_1.MouseEnabled then
		script.Parent:WaitForChild("Mouse").Visible = false
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Keyboard" then
		script.Parent.Image = "rbxassetid://11710306232"
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Mobile" then
		script.Parent.Image = "rbxassetid://13021320268"
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Gamepad" then
		script.Parent.Image = "rbxassetid://11894535915"
	end
	script:WaitForChild("SetType"):FireServer(game.Players.LocalPlayer:GetAttribute("InputType"))
end
local function v4() -- name: CheckPrefer
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	if v_u_2.CONTROLS["Prefer Keyboard"].Value then
		game.Players.LocalPlayer:SetAttribute("InputType", "Keyboard")
	end
	if v_u_2.CONTROLS["Prefer Gamepad"].Value then
		game.Players.LocalPlayer:SetAttribute("InputType", "Gamepad")
	end
	if v_u_2.CONTROLS["Prefer Touch"].Value then
		game.Players.LocalPlayer:SetAttribute("InputType", "Mobile")
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Keyboard" then
		script.Parent.Image = "rbxassetid://11710306232"
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Mobile" then
		script.Parent.Image = "rbxassetid://13021320268"
	end
	if game.Players.LocalPlayer:GetAttribute("InputType") == "Gamepad" then
		script.Parent.Image = "rbxassetid://11894535915"
	end
	if v_u_2.CONTROLS["Prefer Keyboard"].Value == false and (v_u_2.CONTROLS["Prefer Touch"].Value == false and v_u_2.CONTROLS["Prefer Gamepad"].Value == false) then
		v_u_3()
	end
	script:WaitForChild("SetType"):FireServer(game.Players.LocalPlayer:GetAttribute("InputType"))
end
v_u_2:WaitForChild("CONTROLS"):WaitForChild("Prefer Touch").Changed:Connect(v4)
v_u_2:WaitForChild("CONTROLS"):WaitForChild("Prefer Gamepad").Changed:Connect(v4)
v_u_2:WaitForChild("CONTROLS"):WaitForChild("Prefer Keyboard").Changed:Connect(v4)
v_u_3()
v4()
