end
function Disable() -- name: Disable
	if (IsEnabled or IsEnabling) and not IsDisabling then
		if IsEnabling then
			Enabled:Wait()
			return Disable()
		end
		IsDisabling = true
		Disabling:Fire()
		if Mode == "Tool" then
			coroutine.resume(coroutine.create(function()
				SyncAPI:Invoke("SetMouseLockEnabled", true)
			end))
		end
		if UI then
			UI.Parent = script
		end
		if CurrentTool then
			CurrentTool:Unequip()
			CurrentTool.Equipped = false
		end
		ClearConnections()
		IsEnabled = false
		IsDisabling = false
		Disabled:Fire()
	end
end
