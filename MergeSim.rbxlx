			expect(v_u_6:IsDead()).to.equal(true)
			v8:Destroy()
		end)
	end)
	describe("RxBrioUtils.combineLatest({ value = Observable(Brio(5)) })", function()
		-- upvalues: (ref) v_u_2, (ref) v_u_4, (ref) v_u_3
		it("should execute immediately", function()
			-- upvalues: (ref) v_u_2, (ref) v_u_4, (ref) v_u_3
