local function v_u_27(p25) -- name: UpdateWeaponsForMode
	-- upvalues: (ref) v_u_24
	local v26 = p25:GetAttribute("Team")
	if v_u_24 == "KnifeVsGun" then
		if v26 == "Team1" then
			p25.Weapon.Icon.Image = "rbxassetid://584555920"
		else
			p25.Weapon.Icon.Image = "rbxassetid://197518111"
		end
		p25.Knife:SetAttribute("Enabled", v26 == "Team1")
		p25.Gun:SetAttribute("Enabled", v26 == "Team2")
	elseif v_u_24 == "KnifeVsKnife" then
		p25.Weapon.Icon.Image = "rbxassetid://584555920"
		p25.Knife:SetAttribute("Enabled", true)
		p25.Gun:SetAttribute("Enabled", false)
	elseif v_u_24 == "GunVsGun" then
		p25.Weapon.Icon.Image = "rbxassetid://197518111"
		p25.Knife:SetAttribute("Enabled", false)
		p25.Gun:SetAttribute("Enabled", true)
	elseif v_u_24 == "BothVsBoth" then
		p25.Weapon.Icon.Image = "rbxassetid://18147380345"
		p25.Knife:SetAttribute("Enabled", true)
		p25.Gun:SetAttribute("Enabled", true)
	end
	p25.Weapon.Visible = v_u_24 ~= "Custom"
	p25.Gun.Visible = v_u_24 == "Custom"
	p25.Knife.Visible = v_u_24 == "Custom"
end
