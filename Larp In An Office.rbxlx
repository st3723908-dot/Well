	local v2 = {}
	for v3 = 1, select("#", ...) do
		local v4 = select(v3, ...)
		local v5 = #v2
		for v6 = 1, #v4 do
			if v4[v6] == v_u_1 then
				v5 = v5 - 1
			else
				v2[v5 + v6] = v4[v6]
			end
		end
	end
	return v2
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22746"><Properties><string name="Name">join.spec</string><ProtectedString name="Source"><![CDATA[return function()
