end
function run() -- name: run
	-- upvalues: (copy) v_u_11, (copy) v_u_8, (copy) v_u_10
	for _, v_u_14 in pairs(v_u_11:GetDescendants()) do
		if not (v_u_14:IsA("ImageButton") and v_u_14:HasTag("Exe6ScreenButton")) then
			continue
		end
		v_u_14.MouseButton1Click:Connect(function()
			-- upvalues: (copy) v_u_14, (ref) v_u_8, (ref) v_u_10
			if v_u_14.util.screen_directory.Value ~= v_u_8.CurrentScreen() then
				v_u_8.GoToScreen(v_u_14.util.screen_directory.Value)
				if v_u_10.Parent.Parent:GetAttribute("PortraitMode") then
					v_u_8.NavigationMenu(false)
				end
			end
		end)
	end
end
v_u_10.fixed_buttons.system.MouseButton1Click:Connect(function()
	-- upvalues: (copy) v_u_8, (copy) v_u_10
	v_u_8.GoToScreen(v_u_10.Parent.screen.system)
end)
function CalibratePermissions() -- name: CalibratePermissions
	-- upvalues: (copy) v_u_7, (copy) v_u_5, (copy) v_u_10
	local v15 = v_u_7.auth.Auth:InvokeServer("IsAuthorized", v_u_5.UserId)
	if v_u_7.auth.Auth:InvokeServer("GetRoleSetting", v15.Role.Alias, "ViewAuditLogs") then
		v_u_10.directory.primary.audits.Visible = true
	else
		v_u_10.directory.primary.audits.Visible = false
	end
end
display_role()
