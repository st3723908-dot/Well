	},
	[&quot;intro.2&quot;] = {
		[&quot;en&quot;] = &quot;Long ago, a meteorite dug this giant crater. Now baby animals sleep in its dirt!&quot;,
		[&quot;fr&quot;] = &quot;Il y a longtemps, une m\195\169t\195\169orite a creus\195\169 ce crat\195\168re. Des b\195\169b\195\169s animaux dorment dans sa terre !&quot;
	},
	[&quot;intro.3&quot;] = {
		[&quot;en&quot;] = &quot;Dig, wake them up and bring them to your burrow. They\&apos;ll make you rich!&quot;,
