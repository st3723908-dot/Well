-- discord.gg/pHTnqmmWzk
game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;CustomEmote&quot;).OnClientEvent:Connect(function(p1)
	if p1 == &quot;FlipEmote&quot; then
		local Humanoid = game.Players.LocalPlayer.Character.Humanoid
		local animation = Instance.new(&quot;Animation&quot;)

		if Humanoid.RigType == Enum.HumanoidRigType.R6 then
			animation.AnimationId = &quot;rbxassetid://84683947894054&quot;
		else
			animation.AnimationId = &quot;rbxassetid://131773031491951&quot;
		end

		local animationTrack = Humanoid:FindFirstChildOfClass(&quot;Animator&quot;):LoadAnimation(animation)
		animationTrack:Play()
		task.wait(30)
		animationTrack:Stop()
	end
end)
</ProtectedString>
