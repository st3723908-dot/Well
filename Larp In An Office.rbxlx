local v2 = {
	["Notices"] = true
}
for _, v3 in pairs(v1:GetChildren()) do
	if v3:IsA("Frame") then
		if v2[v3.Name] then
			v3.Visible = true
		else
			v3.Visible = false
		end
	else
		if not v3:IsA("Folder") then
			continue
