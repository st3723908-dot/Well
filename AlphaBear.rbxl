		v14.PlayerName.Text = v_u_13.Name
		v14.PlayerImage.Image = "rbxthumb://type=AvatarHeadShot&id=" .. v_u_13.UserId .. "&w=420&h=420"
		v_u_7[v_u_13.UserId] = v14
		v14.MouseButton1Click:Connect(function()
			-- upvalues: (ref) v_u_6, (copy) v_u_13
			local v15 = v_u_6
			local v16
			if v_u_6.payload == v_u_13 then
				v16 = nil
			else
