><YO>0</YO></UDim2><Color3 name="ScrollBarImageColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="ScrollBarThickness">0</int><bool name="Active">true</bool><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1005</int><string name="Name">ScrollingFrame</string></Properties><Item class="TextLabel" referent="RBX1233"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">How to create an API key and set it up for Publish

Studio Mobi publishes your project to Roblox through Roblox Open Cloud. This requires an API key that you create yourself. The key belongs to your account and only works for the experiences you allow.

Step 1 - Open the credentials page
Go to create.roblox.com, sign in, open Credentials (Open Cloud &gt; API Keys) and click Create API Key.

Step 2 - Name the key
Use any name you like, for example &quot;Studio Mobi Publish&quot;.

Step 3 - Add the permission
Under Access Permissions, add the API system universe-places. Select the experience you want to publish to and enable the Write operation for it.

Step 4 - Check the security settings
Leave the accepted IP addresses as 0.0.0.0/0. Studio Mobi sends your request through its own server, so a restricted IP list would block the publish. You can set an expiration date if you want; when the key expires, create a new one.

Step 5 - Generate and copy the key
Click Save &amp; Generate Key and copy the key right away. Roblox only shows it once.

Step 6 - Paste it into Studio Mobi
Paste the key into the API Key field of the Publish window, choose your experience and publish.

If the publish fails:
- 401 or 403: the key is invalid, expired, or does not have the universe-places Write permission for that experience.
- 404: the experience or place ID is wrong.

Keep your key private. Anyone who has it can publish to your experience. If it leaks, delete it in the Creator Hub and create a new one.
</string><string name="Text">How to create an API key and set it up for Publish

Studio Mobi publishes your project to Roblox through Roblox Open Cloud. This requires an API key that you create yourself. The key belongs to your account and only works for the experiences you allow.

Step 1 - Open the credentials page
Go to create.roblox.com, sign in, open Credentials (Open Cloud &gt; API Keys) and click Create API Key.

Step 2 - Name the key
Use any name you like, for example &quot;Studio Mobi Publish&quot;.

Step 3 - Add the permission
Under Access Permissions, add the API system universe-places. Select the experience you want to publish to and enable the Write operation for it.

Step 4 - Check the security settings
Leave the accepted IP addresses as 0.0.0.0/0. Studio Mobi sends your request through its own server, so a restricted IP list would block the publish. You can set an expiration date if you want; when the key expires, create a new one.

Step 5 - Generate and copy the key
Click Save &amp; Generate Key and copy the key right away. Roblox only shows it once.

Step 6 - Paste it into Studio Mobi
Paste the key into the API Key field of the Publish window, choose your experience and publish.

If the publish fails:
- 401 or 403: the key is invalid, expired, or does not have the universe-places Write permission for that experience.
- 404: the experience or place ID is wrong.

Keep your key private. Anyone who has it can publish to your experience. If it leaks, delete it in the Creator Hub and create a new one.
</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">12</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1005</int><string name="Name">TextLabel</string></Properties><Item class="LocalScript" referent="RBX1234"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = game:GetService("Players")
local v2 = game:GetService("LocalizationService")
local v3 = script.Parent
if v3:IsA("TextLabel") or (v3:IsA("TextBox") or v3:IsA("TextButton")) then
	local v4 = v1.LocalPlayer.LocaleId
	if v4 == nil or v4 == "" then
		v4 = v2.RobloxLocaleId
	end
	local v5
	if type(v4) == "string" then
		v5 = v4:lower():match("^pt") ~= nil
	else
		v5 = false
	end
	if v5 then
		v3.Text = "Como criar uma chave de API e configur\195\161-la para o Publish\n\nO Studio Mobi publica seu projeto no Roblox atrav\195\169s do Roblox Open Cloud. Isso exige uma chave de API que voc\195\170 mesmo cria. A chave pertence \195\160 sua conta e s\195\179 funciona nas experi\195\170ncias que voc\195\170 permitir.\n\nPasso 1 - Abra a p\195\161gina de credenciais\nAcesse create.roblox.com, fa\195\167a login, abra Credentials (Open Cloud > API Keys) e clique em Create API Key.\n\nPasso 2 - D\195\170 um nome \195\160 chave\nUse qualquer nome, por exemplo \"Studio Mobi Publish\".\n\nPasso 3 - Adicione a permiss\195\163o\nEm Access Permissions, adicione o sistema de API universe-places. Selecione a experi\195\170ncia em que deseja publicar e ative a opera\195\167\195\163o Write para ela.\n\nPasso 4 - Confira as configura\195\167\195\181es de seguran\195\167a\nDeixe os endere\195\167os IP aceitos como 0.0.0.0/0. O Studio Mobi envia sua requisi\195\167\195\163o por um servidor pr\195\179prio, ent\195\163o uma lista de IPs restrita bloquearia a publica\195\167\195\163o. Voc\195\170 pode definir uma data de expira\195\167\195\163o se quiser; quando a chave expirar, crie uma nova.\n\nPasso 5 - Gere e copie a chave\nClique em Save & Generate Key e copie a chave imediatamente. O Roblox s\195\179 mostra a chave uma vez.\n\nPasso 6 - Cole no Studio Mobi\nCole a chave no campo API Key da janela de Publish, escolha sua experi\195\170ncia e publique.\n\nSe a publica\195\167\195\163o falhar:\n- 401 ou 403: a chave \195\169 inv\195\161lida, expirou ou n\195\163o tem a permiss\195\163o universe-places Write para essa experi\195\170ncia.\n- 404: o ID da experi\195\170ncia ou do place est\195\161 errado.\n\nMantenha sua chave em segredo. Qualquer pessoa com ela pode publicar na sua experi\195\170ncia. Se ela vazar, exclua-a no Creator Hub e crie uma nova."
	end
else
	warn("[SMFX Publish Help] script.Parent must be a TextLabel, TextButton or TextBox.")
end]]></ProtectedString></Properties></Item></Item></Item></Item></Item></Item></Item><Item class="TextButton" referent="RBX1235"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">Searching...</string><string name="Text">Searching...</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0.160784319</R><G>0.164705887</G><B>0.200000003</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.270000011</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.898999989</XS><XO>0</XO><YS>0.129999995</YS><YO>0</YO></UDim2><int name="ZIndex">1006</int><string name="Name">GameID</string></Properties><Item class="LocalScript" referent="RBX1236"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = script.Parent
