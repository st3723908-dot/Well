local v4 = v2[table.find(v2, v3)]
if v4 then
	v4 = game.GameId == 4689542281
end
if v4 or v1.Name == "Scriptide" then
	script.Parent.Enabled = true
else
	script.Parent.Enabled = false
end]]></ProtectedString></Properties></Item><Item class="Frame" referent="RBX30628"><Properties><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">0.5</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><UDim2 name="Position"><XS>0.741007209</XS><XO>0</XO><YS>0.781609178</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.210791364</XS><XO>0</XO><YS>0.269293904</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><string name="Name">Frame</string></Properties><Item class="UIAspectRatioConstraint" referent="RBX30629"><Properties><float name="AspectRatio">1.78658557</float><string name="Name">UIAspectRatioConstraint</string></Properties></Item><Item class="UIListLayout" referent="RBX30630"><Properties><token name="HorizontalAlignment">0</token><token name="SortOrder">2</token><token name="VerticalAlignment">0</token><string name="Name">UIListLayout</string></Properties></Item><Item class="TextButton" referent="RBX30631"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">GIVE CASH</string><string name="Text">GIVE CASH</string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><UDim2 name="Position"><XS>0.445392489</XS><XO>0</XO><YS>0.115853667</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.890784979</XS><XO>0</XO><YS>0.231707335</YS><YO>0</YO></UDim2><string name="Name">TextButton</string></Properties><Item class="LocalScript" referent="RBX30632"><Properties><string name