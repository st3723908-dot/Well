v_u_1.Activated:Connect(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_3, (ref) v_u_2
	if not enabled then
		return
	end
	local v4 = nil
	local v5
	if v4 then
		v4 = v_u_1.Parent:FindFirstChild("UpperTorso").RightShoulderRigAttachment.CFrame.Position.X - v_u_1.Parent:FindFirstChild("RightUpperArm").RightShoulderRigAttachment.CFrame.Position.X
		if v4 >= 1.13 then
			v4 = v_u_3.Character
			v4 = v4 or v_u_3.CharacterAdded:Wait()
			v5 = v4:FindFirstChild("Humanoid")
			if v5.RigType == Enum.HumanoidRigType.R6 then
				v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR6"))
			else
				v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR15"))
			end
			enabled = false
			v_u_2:Play()
			task.wait(2.5)
			enabled = true
			return
		else
			v4 = v_u_1.Parent:FindFirstChild("Torso")
			if v4 then
				v4 = v_u_3.Character
				v4 = v4 or v_u_3.CharacterAdded:Wait()
				v5 = v4:FindFirstChild("Humanoid")
				if v5.RigType == Enum.HumanoidRigType.R6 then
					v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR6"))
				else
					v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR15"))
				end
				enabled = false
				v_u_2:Play()
				task.wait(2.5)
				enabled = true
			end
		end
	else
		v4 = v_u_1.Parent:FindFirstChild("Torso")
		if v4 then
			v4 = v_u_3.Character
			v4 = v4 or v_u_3.CharacterAdded:Wait()
			v5 = v4:FindFirstChild("Humanoid")
			if v5.RigType == Enum.HumanoidRigType.R6 then
				v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR6"))
			else
				v_u_2 = v5:LoadAnimation(script:WaitForChild("AnimationR15"))
			end
			enabled = false
			v_u_2:Play()
			task.wait(2.5)
			enabled = true
		end
	end
end)
v_u_1.Unequipped:Connect(function()
