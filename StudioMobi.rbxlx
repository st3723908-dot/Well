		v_u_1.Text = ""
	end
end)]]></ProtectedString></Properties></Item><Item class="TextBox" referent="RBX1758"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/Inconsolata.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.423529416</R><G>0.454901963</G><B>0.501960814</B></Color3><string name="PlaceholderText">Type...</string><string name="Text"></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0.164705887</R><G>0.176470593</G><B>0.235294119</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.898000002</YS><YO>0</YO></UDim2><int name="ZIndex">9999</int><string name="Name">Type</string></Properties><Item class="ImageButton" referent="RBX1759"><Properties><Content name="Image"><url>rbxthumb://type=Asset&amp;id=18517619094&amp;w=420&amp;h=420</url></Content><Content name="ImageContent"><url>rbxthumb://type=Asset&amp;id=18517619094&amp;w=420&amp;h=420</url></Content><float name="ImageTransparency">1</float><Vector2 name="AnchorPoint"><X>1</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0.254901975</R><G>0.274509817</G><B>0.368627459</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>1</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">9999</int><string name="Name">Send</string></Properties><Item class="UICorner" referen