="LeftLegColor3"><R>0.97647059</R><G>0.97647059</G><B>0.97647059</B></Color3><Color3 name="RightArmColor3"><R>0.97647059</R><G>0.97647059</G><B>0.97647059</B></Color3><Color3 name="RightLegColor3"><R>0.97647059</R><G>0.97647059</G><B>0.97647059</B></Color3><Color3 name="TorsoColor3"><R>0.97647059</R><G>0.97647059</G><B>0.97647059</B></Color3><string name="Name">Body Colors</string></Properties></Item></Item></Item><Item class="Lighting" referent="RBX7590"><Properties><Color3 name="Ambient"><R>0</R><G>0</G><B>0</B></Color3><float name="Brightness">3</float><Color3 name="ColorShift_Bottom"><R>0</R><G>0</G><B>0</B></Color3><Color3 name="ColorShift_Top"><R>0</R><G>0</G><B>0</B></Color3><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><float name="ExposureCompensation">0</float><token name="ExtendLightRangeTo120">0</token><Color3 name="FogColor"><R>0</R><G>0</G><B>0</B></Color3><float name="FogEnd">99999</float><float name="FogStart">999999</float><float name="GeographicLatitude">0</float><bool name="GlobalShadows">true</bool><token name="LightingStyle">0</token><Color3 name="OutdoorAmbient"><R>0</R><G>0</G><B>0</B></Color3><bool name="PrioritizeLightingQuality">true</bool><float name="ShadowSoftness">0.100000001</float><string name="TimeOfDay">00:00:00</string><string name="Name">Lighting</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="DepthOfFieldEffect" referent="RBX7591"><Properties><float name="FarIntensity">0</float><float name="FocusDistance">0</float><float name="InFocusRadius">125</float><float name="NearIntensity">0</float><string name="Name">DepthOfField</string></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX7592"><Properties><float name="Brightness">0.0329999998</float><float name="Contrast">0.180000007</float><float name="Saturation">0.100000001</float><string name="Name">ColorCorrection</string><int64 name="SourceAssetId">4951222008</int64></Properties></Item><Item class="BlurEffect" referent="RBX7593"><Properties><float name="Size">3</float><string name="Name">Blur</string></Properties></Item><Item class="Atmosphere" referent="RBX7594"><Properties><Color3 name="Color"><R>0.725490212</R><G>0.725490212</G><B>0.725490212</B></Color3><Color3 name="Decay"><R>0</R><G>0</G><B>0</B></Color3><float name="Density">0.600000024</float><float name="Haze">2.25</float><float name="Offset">0.0399999991</float><string name="Name">Atmosphere</string></Properties></Item><Item class="BloomEffect" referent="RBX7595"><Properties><float name="Intensity">0.850000024</float><float name="Size">0</float><float name="Threshold">2</float><string name="Name">Bloom</string></Properties></Item><Item class="Sky" referent="RBX7596"><Properties><bool name="CelestialBodiesShown">false</bool><Content name="SkyboxBackContent"><url>http://www.roblox.com/Asset/?ID=12064107</url></Content><Content name="SkyboxBk"><url>http://www.roblox.com/Asset/?ID=12064107</url></Content><Content name="SkyboxDn"><url>http://www.roblox.com/Asset/?ID=12064152</url></Content><Content name="SkyboxDownContent"><url>http://www.roblox.com/Asset/?ID=12064152</url></Content><Content name="SkyboxFrontContent"><url>http://www.roblox.com/Asset/?ID=12064121</url></Content><Content name="SkyboxFt"><url>http://www.roblox.com/Asset/?ID=12064121</url></Content><Content name="SkyboxLeftContent"><url>http://www.roblox.com/Asset/?ID=12063984</url></Content><Content name="SkyboxLf"><url>http://www.roblox.com/Asset/?ID=12063984</url></Content><Content name="SkyboxRightContent"><url>http://www.roblox.com/Asset/?ID=12064115</url></Content><Content name="SkyboxRt"><url>http://www.roblox.com/Asset/?ID=12064115</url></Content><Content name="SkyboxUp"><url>http://www.roblox.com/Asset/?ID=12064131</url></Content><Content name="SkyboxUpContent"><url>http://www.roblox.com/Asset/?ID=12064131</url></Content><int name="StarCount">0</int><string name="Name">Sky</string><int64 name="SourceAssetId">143962526</int64></Properties></Item></Item><Item class="ReplicatedFirst" referent="RBX7597"><Properties><string name="Name">ReplicatedFirst</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="LocalScript" referent="RBX7598"><Properties><bool name="Disabled">true</bool><string name="Name">Loading</string><ProtectedString name="Source"><![CDATA[game.ReplicatedFirst:RemoveDefaultLoadingScreen()
game.Players.LocalPlayer.CharacterAdded:Connect(function()
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	workspace.CurrentCamera.CFrame = CFrame.new(9999, 9949, 9969)
end)
local v_u_1 = game:GetService("TweenService")
local v_u_2 = script:WaitForChild("LoadingGUI")
v_u_2.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
v_u_2:WaitForChild("Load")
script:WaitForChild("Sound")
script.Sound:Play()
local v3 = workspace:WaitForChild("Camera")
v3.CameraType = Enum.CameraType.Scriptable
v3.CFrame = CFrame.new(9999, 9949, 9969)
local v_u_4 = true
repeat
	task.wait(0.05)
until game.ReplicatedFirst:FindFirstChild("Renders") and #game.ReplicatedFirst.Renders:GetChildren() >= 7
v_u_2:WaitForChild("Load")
v_u_2.Load:WaitForChild("Logo")
v_u_2.Load:WaitForChild("Monsters")
v_u_2.Load:WaitForChild("Vignette")
v_u_2.Load.Monsters.Image = game.ReplicatedFirst.Renders:GetChildren()[math.random(1, #game.ReplicatedFirst.Renders:GetChildren())].Image
v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(0.35), {
	["TextTransparency"] = 0
}):Play()
task.spawn(function()
	-- upvalues: (ref) v_u_4
	task.wait(4.5)
	v_u_4 = false
end)
repeat
	v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(0.2), {
		["TextStrokeTransparency"] = 0.5
	}):Play()
	task.wait(0.2)
	v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(0.2), {
		["TextStrokeTransparency"] = 0
	}):Play()
	task.wait(0.2)
until not v_u_4
v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(1.5), {
	["Position"] = UDim2.new(0.5, 0, 0.15, 0)
}):Play()
v_u_1:Create(v_u_2.Load.Monsters, TweenInfo.new(0.35), {
	["ImageTransparency"] = 0
}):Play()
v_u_1:Create(v_u_2.Load.Logo, TweenInfo.new(0.35), {
	["ImageTransparency"] = 0
}):Play()
v_u_1:Create(v_u_2.Load.Vignette, TweenInfo.new(0.35), {
	["ImageTransparency"] = 0
}):Play()
task.wait(0.35)
v_u_4 = true
task.spawn(function()
	-- upvalues: (ref) v_u_4
	task.wait(2)
	v_u_4 = false
end)
task.spawn(function()
	-- upvalues: (copy) v_u_1, (copy) v_u_2, (ref) v_u_4
	repeat
		task.wait(0.06)
		v_u_1:Create(v_u_2.Load.Monsters, TweenInfo.new(0.06, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			["Rotation"] = 5.1
		}):Play()
		task.wait(0.06)
		v_u_1:Create(v_u_2.Load.Monsters, TweenInfo.new(0.06, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			["Rotation"] = 5
		}):Play()
	until game.Players.LocalPlayer:FindFirstChild("InvLoaded") and not v_u_4
end)
repeat
	v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(0.5), {
		["TextStrokeTransparency"] = 0.5
	}):Play()
	v_u_1:Create(v_u_2.Load.Logo, TweenInfo.new(0.44, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		["Size"] = UDim2.new(0.47570999999999997, 0, 0.17170000000000002, 0)
	}):Play()
	v_u_1:Create(v_u_2.Load.Logo, TweenInfo.new(0.38), {
		["ImageTransparency"] = 0.3
	}):Play()
	task.wait(0.5)
	v_u_1:Create(v_u_2.Load.TextLabel, TweenInfo.new(0.5), {
		["TextStrokeTransparency"] = 0
	}):Play()
	v_u_1:Create(v_u_2.Load.Logo, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		["Size"] = UDim2.new(0.471, 0, 0.17, 0)
	}):Play()
	v_u_1:Create(v_u_2.Load.Logo, TweenInfo.new(0.5), {
		["ImageTransparency"] = 0
	}):Play()
	task.wait(0.5)
until game.Players.LocalPlayer:FindFirstChild("InvLoaded") and not v_u_4
script:WaitForChild("Fade"):Play()
v_u_1:Create(v_u_2.Load, TweenInfo.new(1.25), {
	["ImageTransparency"] = 1
