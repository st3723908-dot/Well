		local v2 = {}
		if p1 then
			p1 = p1:GetAttribute("Zonas")
		end
		if type(p1) == "string" then
			for v3 in string.gmatch(p1, "[^;]+") do
				local v4, v5, v6 = string.match(v3, "([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)")
				if not v4 then
					continue
				end
				local v7 = {
					["x"] = tonumber(v4),
					["z"] = tonumber(v5),
					["r"] = tonumber(v6)
				}
				table.insert(v2, v7)
			end
		end
		return v2
	end,
