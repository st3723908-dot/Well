local v_u_182 = {
	["collect"] = function(p163) -- name: collect
		local v164 = {}
		local v165 = {}
		for _, v166 in ipairs(p163:GetDescendants()) do
			if v166:IsA("Motor6D") then
				local v167 = v166.Part1
				if not v167 or v164[v167.Name] then
					continue
				end
				v164[v167.Name] = true
				local v168 = {
					["track"] = nil,
					["label"] = nil,
					["joint"] = nil,
					["kind"] = "Motor6D",
					["track"] = v167.Name,
					["label"] = v166.Parent and v166.Parent.Name or v166.Name,
					["joint"] = v166
				}
				table.insert(v165, v168)
			else
				if not v166:IsA("Bone") or v164[v166.Name] then
					continue
				end
				v164[v166.Name] = true
				local v169 = {
					["track"] = nil,
					["label"] = nil,
					["joint"] = nil,
					["kind"] = "Bone",
					["track"] = v166.Name,
					["label"] = v166.Parent and v166.Parent.Name or v166.Name,
					["joint"] = v166
				}
				table.insert(v165, v169)
			end
		end
		return v165
	end,
	["parentMap"] = function(p170) -- name: parentMap
		local v171 = {}
		for _, v172 in ipairs(p170) do
			local v173 = v172.joint
			if v172.kind == "Motor6D" then
				if not v173.Part0 then
					continue
				end
				v171[v172.track] = v173.Part0.Name
			else
				if not v173.Parent then
					continue
				end
				v171[v172.track] = v173.Parent.Name
			end
		end
		return v171
	end,
	["getTransform"] = function(p174) -- name: getTransform
		return p174.joint.Transform
	end,
	["setTransform"] = function(p175, p176) -- name: setTransform
		if p175.joint.Parent then
			p175.joint.Transform = p176
		end
	end,
	["resetAll"] = function(p177) -- name: resetAll
		-- upvalues: (copy) v_u_182
		for _, v178 in ipairs(p177) do
			v_u_182.setTransform(v178, CFrame.new())
		end
	end,
	["stopPlayingTracks"] = function(p179) -- name: stopPlayingTracks
		for _, v180 in ipairs(p179:GetDescendants()) do
			if not v180:IsA("Animator") then
				continue
			end
			for _, v181 in ipairs(v180:GetPlayingAnimationTracks()) do
				v181:Stop(0)
			end
		end
	end
}
