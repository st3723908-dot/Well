BUY.</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17268"><Properties><string name="Value">Ever seen a Lemon rap? It&apos;s sour to say the least.</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17269"><Properties><string name="Value">You ever just, stare? Like what you&apos;re doing right now.</string><string name="Name">Random</string></Properties></Item></Item><Item class="Folder" referent="RBX17270"><Properties><string name="Name">LeaveBank</string></Properties><Item class="StringValue" referent="RBX17271"><Properties><string name="Value">Come back later!</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17272"><Properties><string name="Value">Give me more money!</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17273"><Properties><string name="Value">I&apos;ll still be here.</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17274"><Properties><string name="Value">Don&apos;t die!</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17275"><Properties><string name="Value">HaVE FUN CHASING PILLARS!!!</string><string name="Name">Random</string></Properties></Item></Item><Item class="Folder" referent="RBX17276"><Properties><string name="Name">OpenBank</string></Properties><Item class="StringValue" referent="RBX17277"><Properties><string name="Value">What can I get ya?</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17278"><Properties><string name="Value">Welcome!</string><string name="Name">Random</string></Properties></Item><Item class="StringValue" referent="RBX17279"><Properties><string name="Value">Make it quick, got stuff to do.</string><string name="Name">Random</string></Properties></Item><Item cl