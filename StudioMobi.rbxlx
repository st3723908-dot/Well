v_u_6.Visible = false
local function v_u_15(p7, p8, p9) -- name: populateList
	-- upvalues: (copy) v_u_3
	for _, v10 in ipairs(p7:GetChildren()) do
		if v10 == p8 or not v10:IsA("GuiObject") then
			continue
		end
		v10:Destroy()
	end
	for v11, v_u_12 in ipairs(p9 or {}) do
		local v13 = p8:Clone()
		v13.Name = "GameEntry"
		v13.LayoutOrder = v11
		v13.Visible = true
		v13:WaitForChild("TextLabel").Text = v_u_12.name or "Untitled"
		v13:WaitForChild("Image").Image = v_u_12.icon or "rbxthumb://type=Asset&id=83622636792684&w=420&h=420"
		v13:WaitForChild("Play").MouseButton1Click:Connect(function()
			-- upvalues: (copy) v_u_12, (ref) v_u_3
			local v14 = v_u_12.placeId
			if v14 then
				v_u_3:FireServer(v14)
			else
				warn("[SMFX Games] This entry has no place id, cannot teleport.")
			end
		end)
		v13.Parent = p7
	end
end
