script.Parent.ChildAdded:Connect(function(p2)
	-- upvalues: (copy) v_u_1
	p2.TextSize = game.Players.LocalPlayer.PlayerGui.LobbyGUI.Darkness.AbsoluteSize.Y * 0.02
	task.wait(0.05)
	v_u_1:Create(p2, TweenInfo.new(0.35), {
		["TextTransparency"] = 0
	}):Play()
	v_u_1:Create(p2:WaitForChild("UIStroke"), TweenInfo.new(0.35), {
		["Transparency"] = 0.25
	}):Play()
	local v3 = p2.Text
	local v4 = string.len(v3) * 0.25
	local v5 = v4 > 8 and 8 or v4
	task.wait(v5)
	v_u_1:Create(p2, TweenInfo.new(0.35), {
		["TextTransparency"] = 1
	}):Play()
	v_u_1:Create(p2:WaitForChild("UIStroke"), TweenInfo.new(0.35), {
		["Transparency"] = 1
	}):Play()
