function SetFiltersForPeoplePage(p156) -- name: SetFiltersForPeoplePage
	-- upvalues: (ref) v_u_155, (copy) v_u_24, (copy) v_u_2, (copy) v_u_154, (copy) v_u_9
	if p156.Category then
		v_u_155 = p156.Category
	end
	if p156.Category == "All" then
		for _, v157 in v_u_24.scroll.display.scroll:GetChildren() do
			if not v157:IsA("ImageButton") then
				continue
			end
			v157.Visible = true
		end
		v_u_2:Create(v_u_154.categories.All, v_u_9, {
			["BackgroundTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.Team, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.Others, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.All.icon, v_u_9, {
			["ImageTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.Team.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
		v_u_2:Create(v_u_154.categories.Others.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
		return
	elseif p156.Category == "Team" then
		for _, v158 in v_u_24.scroll.display.scroll:GetChildren() do
			if not v158:IsA("ImageButton") then
				continue
			end
			v158.Visible = v158.role.Visible
		end
		v_u_2:Create(v_u_154.categories.Team, v_u_9, {
			["BackgroundTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.All, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.Others, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.Team.icon, v_u_9, {
			["ImageTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.All.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
		v_u_2:Create(v_u_154.categories.Others.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
	elseif p156.Category == "Others" then
		for _, v159 in v_u_24.scroll.display.scroll:GetChildren() do
			if not v159:IsA("ImageButton") then
				continue
			end
			v159.Visible = not v159.role.Visible
		end
		v_u_2:Create(v_u_154.categories.Others, v_u_9, {
			["BackgroundTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.All, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.Team, v_u_9, {
			["BackgroundTransparency"] = 1
		}):Play()
		v_u_2:Create(v_u_154.categories.Others.icon, v_u_9, {
			["ImageTransparency"] = 0
		}):Play()
		v_u_2:Create(v_u_154.categories.All.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
		v_u_2:Create(v_u_154.categories.Team.icon, v_u_9, {
			["ImageTransparency"] = 0.5
		}):Play()
	end
end
function SearchKeywordForPeoplePage() -- name: SearchKeywordForPeoplePage
	-- upvalues: (copy) v_u_154, (copy) v_u_24, (copy) v_u_6
	local v160 = string.lower(v_u_154.search.textbox.Text)
	for _, v161 in v_u_24.scroll.display.scroll:GetChildren() do
		if not (v161:IsA("ImageButton") and (v161:HasTag("Exe6PersonItem") and v161.Visible)) then
			continue
		end
		if v160 == "" then
			if v161.Name == v_u_6.LocalPlayer.Name then
				v161.LayoutOrder = 1
			else
				v161.LayoutOrder = 2
			end
		else
			local v162 = {
				v161.Name,
				v161.info.display.Text,
				v161.info.username.Text,
				v161.role.Text
			}
			local v163 = string.lower(table.concat(v162, ","))
			if string.find(v163, v160) then
				v161.LayoutOrder = 1
			else
				v161.LayoutOrder = 2
			end
		end
	end
end
