end
function PeoplePageSelection(p114, p115, p116) -- name: PeoplePageSelection
	-- upvalues: (copy) v_u_30, (copy) v_u_2, (copy) v_u_9, (copy) v_u_17
	if p116 then
		if #v_u_30.PeopleSelection < 50 then
			p114:SetAttribute("selected", true)
			local v117 = v_u_30.PeopleSelection
			local v118 = p115.UserId
			table.insert(v117, v118)
			v_u_2:Create(p114, v_u_9, {
				["BackgroundColor3"] = Color3.fromRGB(27, 27, 27)
			}):Play()
			v_u_2:Create(p114.select.blue.scale, v_u_9, {
				["Scale"] = 1
			}):Play()
		else
			v_u_17.BannerNotify({
				["Header"] = "Bulk Selection Limit Reached",
				["Description"] = "You can only select 50 players at a time.",
				["Icon"] = "rbxassetid://12974220720"
			})
		end
	else
		p114:SetAttribute("selected", false)
		table.remove(v_u_30.PeopleSelection, table.find(v_u_30.PeopleSelection, p115.UserId) or 0)
		v_u_2:Create(p114.select.blue.scale, v_u_9, {
			["Scale"] = 0
		}):Play()
		v_u_2:Create(p114, v_u_9, {
			["BackgroundColor3"] = Color3.fromRGB(27, 27, 27)
		}):Play()
	end
	UpdatePeopleSelection()
end
function OptionChosenActivation(p119, p120) -- name: OptionChosenActivation
	-- upvalues: (copy) v_u_15, (copy) v_u_22
	if p120 then
		if p120 == "View Profile" then
			v_u_15.Profile(true, p119)
			return
		end
		if p120 == "Ban" then
			v_u_15.Ban(true, { p119 })
			return
		end
		if p120 == "Kick" then
			v_u_15.Kick(true, { p119 })
			return
		end
		if p120 == "Warn" then
			v_u_15.Warn(true, { p119 })
			return
		end
		if p120 == "Notify" then
			v_u_15.Notify(true, { p119 })
			return
		end
		if p120 == "Chat History" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
				v_u_15.Profile(false)
			end
			v_u_15.ChatHistory(true, p119)
			return
		end
		if p120 == "Ban History" then
			v_u_15.BanHistory(true, false, p119)
			return
		end
		if p120 == "Warn History" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
				v_u_15.Profile(false)
			end
			v_u_15.WarnHistory(true, p119)
			return
		end
		if p120 == "Spectate" then
			if v_u_22.profile:GetAttribute("UserId") ~= p119 then
				v_u_15.Profile(true, p119)
