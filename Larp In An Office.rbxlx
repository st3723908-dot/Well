local v_u_2 = v_u_1:WaitForChild("Handle")
local v_u_3 = game.Players.LocalPlayer
local v_u_4 = v_u_3:GetMouse()
local v_u_5 = Workspace.CurrentCamera
local v_u_6 = Workspace:WaitForChild(v_u_3.Name)
local v_u_7 = v_u_6:WaitForChild("Humanoid")
script.Parent:WaitForChild("VisualizeBullet")
