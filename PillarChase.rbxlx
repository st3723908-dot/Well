			local v270 = v_u_12.MonsterSpot.CFrame.Position.Y + p266.Humanoid.HipHeight + p266.HumanoidRootPart.Size.Y * 0.5
			local v271 = v_u_12.CamPart.Position.Z
			v268.Position = Vector3.new(v269, v270, v271)
			local v272 = v_u_12.CamPart.CFrame * CFrame.new(0, 0, p266.HumanoidRootPart.Size.Y + p266.Humanoid.HipHeight * 1.25)
			if p266:GetAttribute("ExtraOffset") then
