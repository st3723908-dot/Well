end
function onEquippedLocal(p2) -- name: onEquippedLocal
	p2.Icon = ""
	p2.KeyDown:connect(onKeyDown)
end
function onKeyDown(p3) -- name: onKeyDown
	if p3 ~= nil and p3:lower() == "e" then
		if Holstered == true then
			script.Parent.Parent.Humanoid.WalkSpeed = 16
			GunUp()
			return
		end
		if Holstered == false then
			script.Parent.Parent.Humanoid.WalkSpeed = 20
			GunDown()
		end
