t="RBX10239"><Properties><string name="Name">Voice_OfPain</string></Properties></Item><Item class="StringValue" referent="RBX10240"><Properties><string name="Name">Distant_Thunder</string></Properties></Item><Item class="StringValue" referent="RBX10241"><Properties><string name="Name">FoggyMain483</string></Properties></Item><Item class="StringValue" referent="RBX10242"><Properties><string name="Name">SCORCHING_SOLDIER</string></Properties></Item><Item class="StringValue" referent="RBX10243"><Properties><string name="Name">BURNMASTER4712</string></Properties></Item><Item class="StringValue" referent="RBX10244"><Properties><string name="Name">I_AmTruth</string></Properties></Item><Item class="StringValue" referent="RBX10245"><Properties><string name="Name">The_PerfectCreation</string></Properties></Item><Item class="StringValue" referent="RBX10246"><Properties><string name="Name">Trickerys_Silence99</string></Properties></Item><Item class="StringValue" referent="RBX10247"><Properties><string name="Name">BlueberryMonster5884</string></Properties></Item><Item class="StringValue" referent="RBX10248"><Properties><string name="Name">A_RealMonster</string></Properties></Item><Item class="StringValue" referent="RBX10249"><Properties><string name="Name">C00lestInSch00l</string></Properties></Item><Item class="StringValue" referent="RBX10250"><Properties><string name="Name">RobotBuddy6767</string></Properties></Item><Item class="StringValue" referent="RBX10251"><Properties><string name="Name">Your_BestPal</string></Properties></Item><Item class="StringValue" referent="RBX10252"><Properties><string name="Name">woooBumperCars</string></Properties></Item></Item><Item class="TextLabel" referent="RBX10253"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Italic</Style></Font><string name="LocalizedText">&lt;Valem&gt; : I am peaceful.</string><int name="MaxVisibleGraphemes">999999999</int><string name="Text">&lt;Valem&gt; : I am peaceful.</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">24</float><float name="TextStrokeTransparency">0</float><float name="TextTransparency">1</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><string name="Name">Dialogue</string></Properties><Item class="Folder" referent="RBX10254"><Properties><string name="Name">Folder</string></Properties></Item><Item class="UIStroke" referent="RBX10255"><Properties><token name="StrokeSizingMode">1</token><float name="Thickness">0.0649999976</float><float name="Transparency">1</float><string name="Name">UIStroke</string></Properties></Item></Item><Item class="Folder" referent="RBX10256"><Properties><string name="Name">Tips</string></Properties><Item class="Folder" referent="RBX10257"><Properties><string name="Name">Vapor</string></Properties><Item class="StringValue" referent="RBX10258"><Properties><string name="Value">Vapor can charge up and then lunge forward, dodge out of the way or else you will be set on fire!</string><string name="Name">Scorching Grip</string></Properties></Item><Item class="StringValue" referent="RBX10259"><Properties><string name="Value">Vapor can convert players into Spider Skull minions, repeatedly interact with them to destroy them.</string><string name="Name">Spider Skulls</string></Properties></Item><Item class="StringValue" referent="RBX10260"><Properties><string name="Value">When trapped in a Blazing Cage, don&apos;t run into the walls, or else you will take massive damage.</string><string name="Name">Blazing Cage</string></Properties></Item><Item class="StringValue" referent="RBX10261"><Properties><string name="Value">Look out for Vapor&apos;s blazing demonic portal; he can teleport to it at will.</string><string name="Name">Demonic Shift</string></Properties></Item></Item><Item class="Folder" referent="RBX10262"><Properties><string name="Name">Rosemary</string></Properties><Item class="StringValue" referent="RBX10263"><Properties><string name="Value">Rosemary&apos;s Demonic Shriek can go through walls. Keep your ears open for loud approaching screaming and attempt to dodge.</string><string name="Name">Demonic Shriek</string></Properties></Item><Item class="StringValue" referent="RBX10264"><Properties><string name="Value">Avoid being touched by Rosemary&apos;s pink Soul; it will cause you to take more damage and give her better stamina near you.</string><string name="Name">Soul Traversal</string></Properties></Item><Item class="StringValue" referent="RBX10265"><Properties><string name="Value">When affected by Withering, avoid getting close to other players, as doing so will cause it to spread to them.</string><string name="Name">Withering</string></Properties></Item></Item><Item class="Folder" referent="RBX10266"><Properties><string name="Name">Valem</string></Properties><Item class="StringValue" referent="RBX10267"><Properties><string name="Value">When affected by You are safe, you will take increased damage and have your vision obscured. Valem can also see you during it.</string><string name="Name">You are safe</string></Properties></Item><Item class="StringValue" referent="RBX10268"><Properties><string name="Value">Collide with an illusion to de-spawn it; be careful though, as it will apply &quot;You are safe&quot; to you.</string><string name="Name">Trickery</string></Properties></Item><Item class="StringValue" referent="RBX10269"><Properties><string name="Value">Stay out of Valem&apos;s line of sight during his Truth Bind, it will fill up his Boredom meter and empower him, as well as applying &quot;You are safe&quot; to you.</string><string name="Name">Truth Bind</string></Properties></Item><Item class="StringValue" referent="RBX10270"><Properties><string name="Value">It is best to keep your distance from Valem&apos;s pink Demonic Warps; he can cause them to explode at will.</string><string name="Name">Demonic Warp</string></Properties></Item><Item class="StringValue" referent="RBX10271"><Properties><string name="Value">Valem can perform Execution while he is in his actualized state, avoid moving in predictable straight lines; or else you will take massive damage.</string><string name="Name">Execution</string></Properties></Item></Item><Item class="Folder" referent="RBX10272"><Properties><string name="Name">The Fogborn</string></Properties><Item class="StringValue" referent="RBX10273"><Properties><string name="Value">Avoid staying in Fogborns line of sight while he is shaking his gills; or else he will paralyze you.</string><string name="Name">Paralyzing Gaze</string></Properties></Item><Item class="StringValue" referent="RBX10274"><Properties><string name="Value">Keep your ears open for the sounds of thunder and beams of light, this indicates that Fogborn is about to appear and strike with lightning.</string><string name="Name">Staticbiosis</string></Properties></Item><Item class="StringValue" referent="RBX10275"><Properties><string name="Value">Fogborn is capable of silencing his audio and crawling, don&apos;t let him catch you offguard.</string><string name="Name">Stalking Stance</string></Properties></Item><Item class="StringValue" referent="RBX10276"><Properties><string name="Value">Fogborn will get drastically stronger when his Exposure meter is full, avoid getting paralyzed.</string><string name="Name">Exposure</string></Properties></Item></Item><Item class="Folder" referent="RBX10277"><Properties><string name="Name">Ao Oni</string></Properties><Item class="StringValue" referent="RBX10278"><Properties><string name="Value">Ao Oni can convert infested players into Mini Onis, be wary around other players; they might not be what they seem.</string><string name="Name">Mini Onis</string></Properties></Item><Item class="StringValue" referent="RBX10279"><Properties><string name="Value">Keep your eyes and ears out for rumbling debris piles on the ground, this indicates that Ao Oni is burrowing in the ground.</string><string name="Name">Burrowing</string></Properties></Item><Item class="StringValue" referent="RBX10280"><Properties><string name="Value">Ao Oni can smash the ground causing shockwaves that stun players. Avoid them by attempting to get around corners before they reach you.</string><string name="Name">Groundbreak</string></Properties></Item><Item class="StringValue" referent="RBX10281"><Properties><string name="Value">Avoid Ao Oni at all costs while he has Oni Vision active; he will deal increased damage to you.</string><string name="Name">Oni Vision</string></Properties></Item><Item class="StringValue" referent="RBX10282"><Properties><string name="Value">Ao Oni can shoot out onified grasshoppers that infest players. Avoid getting hit so you don&apos;t turn into a Mini Oni.</string><string name="Name">Infestation</string></Properties></Item></Item><Item class="Folder" referent="RBX10283"><Properties><string name="Name">Brutum</string></Properties><Item class="StringValue" referent="RBX10284"><Properties><string name="Value">Brutum can create walls that block off escape routes, try to avoid narrow areas like hallways.</string><string name="Name">Crumbling Route</string></Properties></Item><Item class="StringValue" referent="RBX10285"><Properties><string name="Value">Pay attention when Brutum is using Goliathan Leapl if you don&apos;t dodge when he hits the ground, you will be stunned for a few seconds.</string><string name="Name">Goliathan Leap</string></Properties></Item><Item class="StringValue" referent="RBX10286"><Properties><string name="Value">Brutum can pick up players with Goliathan Leap and use them as a weapon. Hitting him with knockback will cause him to drop them.</string><string name="Name">Living Weapon</string></Properties></Item><Item class="StringValue" referent="RBX10287"><Properties><string name="Value">Stay out of the way of Brutum&apos;s Charging Demise. If you get pinned, he can ram you into a wall for massive damage.</string><string name="Name">Charging Demise</string></Properties></Item></Item><Item class="Folder" referent="RBX10288"><Properties><string name="Name">Pal Percy</string></Properties><Item class="StringValue" referent="RBX10289"><Properties><string name="Value">Look out for Wirepiles on the floor, stepping in them slows you down and alerts Pal Percy. He can also cause them to erupt which will lock you in place.</string><string name="Name">Wireterror</string></Properties></Item><Item class="StringValue" referent="RBX10290"><Properties><string name="Value">Avoid moving in predictable patterns like straight lines when close to Pal Percy, or else risk getting grabbed and pulled to him.</string><string name="Name">Together Forever</string></Properties></Item><Item class="StringValue" referent="RBX10291"><Properties><string name="Value">Avoid Pal Percy while he is laughing maniacally, this means he is empowered and moves much faster.</string><string name="Name">Empowered</string></Properties></Item><Item class="StringValue" referent="RBX10292"><Properties><string name="Value">The TamaTerrorz are present on the map alongside Pal Percy, avoid them and do the QTEs when needed to break free.</string><string name="Name">TamaTerrorz</string></Properties></Item><Item class="StringValue" referent="RBX10293"><Properties><string name="Value">Make sure to equip your Pal Percy Toy and keep it happy when it cries; or else Pal Percy will be notified of your location.</string><string name="Name">Pal Percy Toy</string></Properties></Item></Item><Item class="Folder" referent="RBX10294"><Properties><string name="Name">Agatha</string></Properties><Item class="StringValue" referent="RBX10295"><Properties><string name="Value">Purple around your screen indicates Agatha is close and will appear near you. Avoid getting hit or else she can use Telekinesis on you.</string><string name="Name">Peekaboo</string></Properties></Item><Item class="StringValue" referent="RBX10296"><Properties><string name="Value">When affected by Telekinesis; Agatha can push you forward for extra damage or pull you close.</string><string name="Name">Telekinesis</string></Properties></Item><Item class="StringValue" referent="RBX10297"><Properties><string name="Value">Avoid moving in predictable patterns when being chased by Agatha, she can rush forward and grab you.</string><string name="Name">You&apos;re It</string></Properties></Item><Item class="StringValue" referent="RBX10298"><Properties><string name="Value">Keep your ears open for Agatha&apos;s rage mode, she becomes stronger and quicker during it, but also much louder.</string><string name="Name">Childish Rage</string></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX10299"><Properties><string name="Name">RankStuff</string></Properties><Item class="Folder" referent="RBX10300"><Properties><string name="Name">RankNumbers</string></Properties><Item class="NumberValue" referent="RBX10301"><Properties><double name="Value">20</double><string name="Name">I</string></Properties></Item><Item class="NumberValue" referent="RBX10302"><Properties><double name="Value">40</double><string name="Name">II</string></Properties></Item><Item class="NumberValue" referent="RBX10303"><Properties><double name="Value">65</double><string name="Name">III</string></Properties></Item><Item class="NumberValue" referent="RBX10304"><Properties><double name="Value">90</double><string name="Name">IV</string></Properties></Item></Item><Item class="Folder" referent="RBX10305"><Properties><string name="Name">Colors</string></Properties><Item class="Color3Value" referent="RBX10306"><Properties><Color3 name="Value"><R>0.474509805</R><G>0.545098066</G><B>0.607843161</B></Color3><string name="Name">I</string></Properties></Item><Item class="Color3Value" referent="RBX10307"><Properties><Color3 name="Value"><R>0.564705908</R><G>0.670588255</G><B>0.36470589</B></Color3><string name="Name">II</string></Properties></Item><Item class="Color3Value" referent="RBX10308"><Properties><Color3 name="Value"><R>0.764705896</R><G>0.494117647</G><B>0.164705887</B></Color3><string name="Name">III</string></Properties></Item><Item class="Color3Value" referent="RBX10309"><Properties><Color3 name="Value"><R>0.843137264</R><G>0.0980392173</G><B>0.0588235296</B></Color3><string name="Name">IV</string></Properties></Item><Item class="Color3Value" referent="RBX10310"><Properties><Color3 name="Value"><R>0.333333343</R><G>0.352941185</G><B>0.411764711</B></Color3><string name="Name">NUL</string></Properties></Item></Item></Item><Item class="Folder" referent="RBX10311"><Properties><string name="Name">Sounds</string></Properties><Item class="Folder" referent="RBX10312"><Properties><string name="Name">MonsterSteps</string></Properties><Item class="Sound" referent="RBX10313"><Properties><Content name="AudioContent"><url>rbxassetid://138373593041465</url></Content><float name="RollOffMaxDistance">75</float><float name="RollOffMinDistance">2.70000005</float><token name="RollOffMode">3</token><Ref name="SoundGroup">RBX17582</Ref><Content name="SoundId"><url>rbxassetid://138373593041465</url></Content><float name="Volume">0.150000006</float><string name="Name">Artelurr2</string></Properties></Item><Item class="Sound" referent="RBX10314"><Properties><Content name="AudioContent"><url>rbxassetid://131673887219233</url></Content><float name="RollOffMaxDistance">75</float><float name="RollOffMinDistance">2.70000005</float><token name="RollOffMode">3</token><Ref name="SoundGroup">RBX17582</Ref><Content name="SoundId"><url>rbxassetid://131673887219233</url></Content><float name="Volume">0.550000012</float><string name="Name">Tank2</string></Properties></Item><Ite