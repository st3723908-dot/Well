>0</XO><YS>0.449999988</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><int name="ZIndex">45000</int><string name="Name">Perks</string></Properties><Item class="LocalScript" referent="RBX16946"><Properties><string name="Name">WorkPerks</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game.Players.LocalPlayer
v_u_1:WaitForChild("Inventory")
local v_u_2 = game:GetService("TweenService")
v_u_1:WaitForChild("InvLoaded")
for _, v_u_3 in pairs(script.Parent.PerksFrame:GetChildren()) do
	if not v_u_3:IsA("ImageLabel") then
		continue
	end
	v_u_3.Pick.MouseEnter:Connect(function()
		-- upvalues: (copy) v_u_2, (copy) v_u_3
		v_u_2:Create(v_u_3.UIScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			["Scale"] = 1.05
		}):Play()
	end)
	v_u_3.Pick.MouseLeave:Connect(function()
		-- upvalues: (copy) v_u_2, (copy) v_u_3
		v_u_2:Create(v_u_3.UIScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			["Scale"] = 1
		}):Play()
	end)
	v_u_3.Pick.MouseButton1Down:Connect(function()
		-- upvalues: (copy) v_u_3
		script.PickPerk:FireServer(v_u_3.Name)
	end)
end
task.spawn(function()
	-- upvalues: (copy) v_u_1
	repeat
		task.wait()
	until v_u_1:GetAttribute("Perk1")
