	v_u_37 = v98
	if v98 and not v_u_35.Visible then
		v_u_40 = true
	end
	v_u_35.Visible = v98 ~= nil
	v_u_77("At the top of your screen, there\'s the TopBar, which contains various buttons, tools, and other features.")
	v_u_77("We have the main build modes: Select, Move, Scale, and Rotate. Let\'s try each one!")
	v_u_96("Select", "Tap the Select button to enter Select Mode.", "Now tap any part in the world to select it!", "Nice! A selected part gets outlined, and its info shows up in the Properties panel.")
