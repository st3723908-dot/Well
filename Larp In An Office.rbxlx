function PositionContextMenu() -- name: PositionContextMenu
	-- upvalues: (copy) v_u_49, (copy) v_u_4, (copy) v_u_1, (copy) v_u_7, (copy) v_u_8, (copy) v_u_9
	local v442 = v_u_49.SizeReference
	local v443 = v_u_49.Frame
	local v444 = v_u_4:GetMouseLocation()
	local v445 = workspace.CurrentCamera.ViewportSize
	local v446 = v442.AbsoluteSize
	local v447 = Vector2.new(v446.X * 0.2, v446.Y * 0.2)
	local v448 = v444.X + 8
	local v449 = v444.Y + 8
	if v448 + v446.X > v445.X then
		v448 = v445.X - v446.X - 8
	end
	if v449 + v446.Y > v445.Y then
		v449 = v445.Y - v446.Y - 8
	end
	local v450 = v448 < 8 and 8 or v448
	local v451 = v449 < 8 and 8 or v449
	local _ = v451 + (v451 + v446.Y > v445.Y and 12 or -12)
	v443.Position = UDim2.fromOffset(v444.X - v447.X, v444.Y)
	v443.Size = UDim2.fromOffset(v447.X, v447.Y)
	v443.ImageTransparency = 1
	v443.Visible = true
	v443.Content.padding.PaddingTop = UDim.new(0, 50)
	v443.Content.list.Padding = UDim.new(1, 0)
	v_u_1:Create(v443, v_u_7, {
		["Position"] = UDim2.fromOffset(v450 - 30, v451 - 30)
	}):Play()
	v_u_1:Create(v443, v_u_7, {
		["ImageTransparency"] = 0
	}):Play()
	v_u_1:Create(v443, v_u_8, {
		["Size"] = UDim2.fromOffset(v446.X, v446.Y)
	}):Play()
	v_u_1:Create(v443.Content.padding, v_u_9, {
		["PaddingTop"] = UDim.new(0, 10)
	}):Play()
	v_u_1:Create(v443.Content.list, v_u_7, {
		["Padding"] = UDim.new(0, 5)
	}):Play()
end
