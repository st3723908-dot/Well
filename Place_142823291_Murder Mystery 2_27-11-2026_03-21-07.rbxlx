local v_u_2 = script:WaitForChild("EquipContainer")
local v_u_3 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("ProfileData"))
local v_u_4 = game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
local v5 = game:GetService("ReplicatedStorage"):WaitForChild("ClientServices")
local v_u_6 = require(v5:WaitForChild("ItemService"))
local v_u_7 = {
	["Perks"] = true,
	["Knife"] = true,
	["Gun"] = true
}
local v_u_8 = {}
v_u_1.EquippedChanged = script:WaitForChild("EquippedChanged")
function v_u_1.EquipItem(_, p9, p10) -- name: EquipItem
	-- upvalues: (copy) v_u_6, (copy) v_u_3, (copy) v_u_1, (copy) v_u_4
	local v11 = v_u_6:GetItemInfo(p9, p10)
	if p9 == "Weapons" then
		local v12 = v11.ItemType
		v_u_3.Weapons.Equipped[v12] = p10
		v_u_1.EquippedChanged:Fire(v12, p10)
	else
		v_u_3[p9].Equipped = { p10 }
		v_u_1.EquippedChanged:Fire(p9, p10)
	end
	v_u_4.Inventory.Equip:FireServer(p10, p9)
end
function v_u_1.UnequipItem(_, p13) -- name: UnequipItem
	-- upvalues: (copy) v_u_3, (copy) v_u_4, (copy) v_u_1
	if p13 == "Knife" then
		v_u_3.Weapons.Equipped.Knife = "DefaultKnife"
	elseif p13 == "Gun" then
		v_u_3.Weapons.Equipped.Gun = "DefaultGun"
	else
		v_u_3[p13].Equipped = {}
		v_u_4.Inventory.Unequip:FireServer(1, p13)
	end
	v_u_1.EquippedChanged:Fire(p13, nil)
end
function v_u_1.GetEquipped(_, p14) -- name: GetEquipped
	-- upvalues: (copy) v_u_3
	if p14 == "Knife" then
		return v_u_3.Weapons.Equipped.Knife
	elseif p14 == "Gun" then
		return v_u_3.Weapons.Equipped.Gun
	else
		return v_u_3[p14].Equipped[1]
	end
end
function v_u_1.CreateEquipContainer(_, p15) -- name: CreateEquipContainer
	-- upvalues: (copy) v_u_2, (copy) v_u_6, (copy) v_u_7, (copy) v_u_8
	local v16 = v_u_2:Clone()
	v16.ItemFrame:Destroy()
	local v17 = v_u_6.BaseItemFrame:Clone()
	v17.Parent = v16
	if v_u_7[p15] then
		v17.UIPadding:Destroy()
	end
	v_u_8[p15] = v16
	return v16
end
local function v_u_26(p18, p19) -- name: onEquippedChanged
	-- upvalues: (copy) v_u_8, (copy) v_u_6
	local v20 = v_u_8[p18]
	if v20 then
		local v21 = p18 == "Knife" and "Weapons" or (p18 == "Gun" and "Weapons" or p18)
		local v22
		if p19 then
			v22 = v_u_6:GetItemInfo(v21, p19)
		else
			v22 = nil
		end
		local v23 = v20:WaitForChild("ItemFrame")
		v23.Visible = p19 ~= nil
		local v24 = v20.Unequip
		local v25
		if p19 == nil or v21 == "Perks" then
			v25 = false
		else
			v25 = v21 ~= "Weapons"
		end
		v24.Visible = v25
		v_u_6:ApplyItemToFrame(v23, v22)
		v_u_6:UpdateTags(v23, v22)
	end
end
function v_u_1.BindEquipContainer(_, p27, p28) -- name: BindEquipContainer
	-- upvalues: (copy) v_u_8, (copy) v_u_26, (copy) v_u_1
	v_u_8[p27] = p28
	v_u_26(p27, v_u_1:GetEquipped(p27))
end
v_u_1.EquippedChanged.Event:Connect(v_u_26)
return v_u_1]]></ProtectedString></Properties><Item class="BindableEvent" referent="RBX14344"><Properties><string name="Name">EquippedChanged</string></Properties></Item><Item class="Frame" referent="RBX14345"><Properties><Color3 name="BackgroundColor3"><R>0.227450997</R><G>0.227450997</G><B>0.227450997</B></Color3><float name="BackgroundTransparency">0.300000012</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1.17999995</YS><YO>0</YO></UDim2><token name="SizeConstraint">1</token><string name="Name">EquipContainer</string></Properties><Item class="TextButton" referent="RBX14346"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"></string><float name="TextSize">14</float><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">5</int><string name="Name">Button</string></Properties></Item><Item class="Frame" referent="RBX14347"><Properties><Vector2 name="AnchorPoint"><X>1</X><Y>0</Y></Vector2><Color3 name="BackgroundColor3"><R>0.184313729</R><G>0.184313729</G><B>0.184313729</B></Color3><Color3 name="BorderColor3"><R>0.0235294141</R><G>0.0235294141</G><B>0.0235294141</B></Color3><int name="BorderSizePixel">2</int><int name="LayoutOrder">3</int><UDim2 name="Position"><XS>1</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.200000003</XS><XO>0</XO><YS>0.200000003</YS><YO>0</YO></UDim2><token name="SizeConstraint">1</token><int name="ZIndex">2</int><string name="Name">Unequip</string></Properties><Item class="TextLabel" referent="RBX14348"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><We