local v_u_2 = game:GetService("SoundService"):WaitForChild("Music")
game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("AudioService"))
local v_u_3 = v1:WaitForChild("Icon"):WaitForChild("MutedIcon")
local v_u_4 = v1:WaitForChild("Icon"):WaitForChild("UnmutedIcon")
v_u_3.Visible = v_u_2.Volume <= 0
v_u_4.Visible = v_u_2.Volume > 0
v1:WaitForChild("Button").Activated:Connect(function() -- name: onMuteToggled
	-- upvalues: (copy) v_u_2, (copy) v_u_3, (copy) v_u_4
	if v_u_2.Volume > 0 then
		v_u_2.Volume = 0
	else
		v_u_2.Volume = 1
	end
	v_u_3.Visible = v_u_2.Volume <= 0
	v_u_4.Visible = v_u_2.Volume > 0
end)]]></ProtectedString></Properties></Item><Item class="Frame" referent="RBX26380"><Properties><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><UDim2 name="Position"><XS>0</XS><XO>154</XO><YS>0</YS><YO>12</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0</YS><YO>44</YO></UDim2><string name="Name">Container</string></Properties><Item class="Frame" referent="RBX26381"><Properties><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>0</XS><XO>44</XO><YS>0</YS><YO>44</YO></UDim2><token name="SelectionBehaviorLeft">1</token><token name="SelectionBehaviorRight">1</token><token name="SelectionBehaviorUp">1</token><bool name="SelectionGroup">true</bool><string name="Name">MouseLock</string></Properties><Item class="Frame" referent="RBX26382"><Properties><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><bool name="SelectionGroup">true</bool><string name="Name">Container</string></Properties><Item class="Frame" referent="RBX26383"><Properties><Color3 name="BackgroundColor3"><R>0.0705882385</R><G>0.0705882385</G><B>0.0823529437</B></Color3><float name="BackgroundTransparency">0.0799999982</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">0</int><string name="Name">Background</string></Properties><Item class="UICorner" referent="RBX26384"><Properties><UDim name="BottomLeftRadius"><S>1</S><O>0</O></UDim><UDim name="BottomRightRadius"><S>1</S><O>0</O></UDim><UDim name="TopLeftRadius"><S>1</S>