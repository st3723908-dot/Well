		v3:SetAttribute("CratesRestricted", true)
	elseif v4 then
		return
	end
else
	warn("PolicyService error: " .. v7)
end]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX8391"><Properties><string name="Name">ReplicatedStorage</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX8392"><Properties><string name="Name">RankIcons</string><ProtectedString name="Source"><![CDATA[local v1 = {}
