		end)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13665"><Properties><string name="Name">Component</string><ProtectedString name="Source"><![CDATA[local v_u_1 = require(script.Parent.assign)
