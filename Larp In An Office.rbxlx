local v_u_2 = false
script.Parent.Activated:Connect(function()
	-- upvalues: (ref) v_u_2, (copy) v_u_1
	if not v_u_2 then
		v_u_2 = true
		script.Parent.Fire:Play()
		script.Parent.MuzzleFlash.MainSplash.Enabled = true
		task.wait(0.1)
		script.Parent.MuzzleFlash.MainSplash.Enabled = false
		local v3 = script.Parent:FindFirstChild("MuzzleFlash")
		local v4 = v3 and v3.Position or script.Parent.Handle.Position
		local v5 = v_u_1.Hit.Position
		game.ReplicatedStorage.ToolEvents.WaterGunEvent:FireServer(v4, v5)
		task.wait(0.5)
		v_u_2 = false
