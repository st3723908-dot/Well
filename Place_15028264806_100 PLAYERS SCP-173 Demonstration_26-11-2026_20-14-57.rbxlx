end)]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX2187"><Properties><bool name="Disabled">true</bool><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- source not available for Health]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX2188"><Properties><string name="Name">NoClimb</string><ProtectedString name="Source"><![CDATA[local v_u_1 = script.Parent:WaitForChild("Humanoid")
