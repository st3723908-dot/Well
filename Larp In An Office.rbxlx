		else
			v6[v7] = p1[v7]
		end
	end
	return v6
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22756"><Properties><string name="Name">replaceIndex.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.replaceIndex)
	it("should return a new table", function()
		-- upvalues: (copy) v_u_1
		local v2 = { 1, 2, 3 }
		expect(v_u_1(v2, 2, 0)).never.to.equal(v2)
	end)
	it("should not mutate the original list", function()
		-- upvalues: (copy) v_u_1
		local v3 = { false, "foo", 3 }
		v_u_1(v3, 2, {})
		expect(#v3).to.equal(3)
		expect(v3[1]).to.equal(false)
		expect(v3[2]).to.equal("foo")
		expect(v3[3]).to.equal(3)
	end)
	it("should replace the value at the given index", function()
		-- upvalues: (copy) v_u_1
		local v4 = {}
		local v5 = v_u_1({ 1, 2, 3 }, 2, v4)
		expect(v5[1]).to.equal(1)
		expect(v5[2]).to.equal(v4)
		expect(v5[3]).to.equal(3)
		expect(next(v5[2])).to.equal(nil)
	end)
	it("should throw if the given index is higher than the list length", function()
		-- upvalues: (copy) v_u_1
		local v_u_6 = { 1 }
		expect(function()
			-- upvalues: (ref) v_u_1, (copy) v_u_6
			v_u_1(v_u_6, #v_u_6 + 1, {})
		end).to.throw()
	end)
	it("should be able to replace to a falsy value", function()
		-- upvalues: (copy) v_u_1
		local v7 = {}
		local v8 = v_u_1({
			v7,
			false,
			"value",
			true
		}, 3, false)
		expect(v8[1]).to.equal(v7)
		expect(v8[2]).to.equal(false)
		expect(v8[3]).to.equal(false)
		expect(v8[4]).to.equal(true)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22757"><Properties><string name="Name">reverse</string><ProtectedString name="Source"><![CDATA[return function(p1) -- name: reverse
	local v2 = #p1
	local v3 = v2 + 1
	local v4 = {}
	for v5 = 1, v2 do
		v4[v5] = p1[v3 - v5]
	end
	return v4
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22758"><Properties><string name="Name">reverse.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.reverse)
	it("should return a new table", function()
		-- upvalues: (copy) v_u_1
		local v2 = { 1, 2, 3 }
		expect(v_u_1(v2)).never.to.equal(v2)
	end)
	it("should not mutate the given table", function()
		-- upvalues: (copy) v_u_1
		local v3 = { 1, 2, 3 }
		v_u_1(v3)
		expect(#v3).to.equal(3)
		expect(v3[1]).to.equal(1)
		expect(v3[2]).to.equal(2)
		expect(v3[3]).to.equal(3)
	end)
	it("should contain the same elements", function()
		-- upvalues: (copy) v_u_1
		local v4 = v_u_1({ "Foo", "Bar" })
		expect(#v4).to.equal(2)
		local v5 = {
			["Foo"] = true,
			["Bar"] = true
		}
		for _, v6 in ipairs(v4) do
			expect(v5[v6]).to.equal(true)
		end
	end)
	it("should reverse the list", function()
		-- upvalues: (copy) v_u_1
		local v7 = v_u_1({
			1,
			2,
			3,
			4
		})
		expect(v7[1]).to.equal(4)
		expect(v7[2]).to.equal(3)
		expect(v7[3]).to.equal(2)
		expect(v7[4]).to.equal(1)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22759"><Properties><string name="Name">sort</string><ProtectedString name="Source"><![CDATA[return function(p1, p2) -- name: sort
	local v3 = {}
	for v4 = 1, #p1 do
		v3[v4] = p1[v4]
	end
	table.sort(v3, p2)
	return v3
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22760"><Properties><string name="Name">sort.spec</string><ProtectedString name="Source"><![CDATA[return function()
	local v_u_1 = require(script.Parent.sort)
	it("should return a new table", function()
		-- upvalues: (copy) v_u_1
		local v2 = {}
		expect(v_u_1(v2)).never.to.equal(v2)
	end)
	it("should not mutate the given table", function()
		-- upvalues: (copy) v_u_1
		local v3 = { 77, "foo", 2 }
		v_u_1(v3, function(p4, p5) -- name: order
			return tostring(p4) < tostring(p5)
		end)
		expect(#v3).to.equal(3)
		expect(v3[1]).to.equal(77)
		expect(v3[2]).to.equal("foo")
		expect(v3[3]).to.equal(2)
	end)
	it("should contain the same elements from the given table", function()
		-- upvalues: (copy) v_u_1
		local v6 = v_u_1({ "Foo", "Bar", "Test" })
		expect(#v6).to.equal(3)
		local v7 = {
			["Foo"] = true,
			["Bar"] = true,
			["Test"] = true
		}
		for _, v8 in ipairs(v6) do
			expect(v7[v8]).to.equal(true)
		end
	end)
	it("should sort with the default table.sort when no callback is given", function()
		-- upvalues: (copy) v_u_1
		local v9 = {
			4,
			2,
			5,
			3,
			1
		}
		local v10 = v_u_1(v9)
		table.sort(v9)
		expect(#v10).to.equal(#v9)
		for v11 = 1, #v9 do
			expect(v10[v11]).to.equal(v9[v11])
		end
	end)
	it("should sort with the given callback", function()
		-- upvalues: (copy) v_u_1
		local v12 = {
			1,
			2,
			5,
			3,
			4
		}
		local function v15(p13, p14) -- name: order
			return p14 < p13
		end
		local v16 = v_u_1(v12, v15)
		table.sort(v12, v15)
