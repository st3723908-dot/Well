	return v_u_44
end
function OnClientInvoke(p46, p47) -- name: OnClientInvoke
	if p46 == "PlayAnimation" and (p47 and (ToolEquipped and Humanoid)) then
		SetAnimation("PlayAnimation", p47)
		return
	elseif p46 == "StopAnimation" and p47 then
		SetAnimation("StopAnimation", p47)
		return
	elseif p46 == "PlaySound" and p47 then
		p47:Play()
	elseif p46 == "StopSound" and p47 then
		p47:Stop()
	end
end
ClientControl.OnClientInvoke = OnClientInvoke
Tool.Equipped:connect(Equipped)
Tool.Unequipped:connect(Unequipped)]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX6987"><Properties><string name="Name">MouseIcon</string><ProtectedString name="Source"><![CDATA[Mouse_Icon = "rbxasset://textures/GunCursor.png"
Reloading_Icon = "rbxasset://textures/GunWaitCursor.png"
Tool = script.Parent
Mouse = nil
function UpdateIcon() -- name: UpdateIcon
	if Mouse then
		Mouse.Icon = Tool.Enabled and Mouse_Icon or Reloading_Icon
	end
end
function OnEquipped(p1) -- name: OnEquipped
	Mouse = p1
	UpdateIcon()
end
function OnChanged(p2) -- name: OnChanged
	if p2 == "Enabled" then
		UpdateIcon()
	end
end
Tool.Equipped:connect(OnEquipped)
Tool.Changed:connect(OnChanged)]]></ProtectedString></Properties></Item><Item class="Animation" referent="RBX6988"><Properties><Content name="AnimationContent"><url>http://www.roblox.com/asset/?id=225279725</url></Content><Content name="AnimationId"><url>http://www.roblox.com/asset/?id=225279725</url></Content><string name="Name">Sit</string></Properties></Item><Item class="Animation" referent="RBX6989"><Properties><Content name="AnimationContent"><url>rbxassetid://1239927101</url></Content><Content name="AnimationId"><url>rbxassetid://1239927101</url></Content><string name="Name">SitR15</string></Properties></Item><Item class="Part" referent="RBX6990"><Properties><token name="BottomSurface">0</token><CoordinateFrame name="CFrame"><X>-464.851471</X><Y>-154.448105</Y><Z>20.3069916</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Locked">true</bool><token name="TopSurface">0</token><string name="Name">Handle</string><Color3uint8 name="Color3uint8">4288914085</Color3uint8></Properties><Item class="SpecialMesh" referent="RBX6991"><Properties><token name="MeshType">5</token><Content name="MeshContent"><url>http://www.roblox.com/asset/?id=223079737</url></Content><Content name="MeshId"><url>http://www.roblox.com/asset/?id=223079737</url></Content><Content name="TextureContent"><url>http://www.roblox.com/asset/?id=223080038</url></Content><Content name="TextureId"><url>http://www.roblox.com/asset/?id=223080038</url></Content><Vector3 name="Scale"><X>1.125</X><Y>1.125</Y><Z>1.125</Z></Vector3><string name="Name">Mesh</string></Properties></Item></Item></Item><Item class="Tool" referent="RBX6992"><Properties><bool name="CanBeDropped">false</bool><CoordinateFrame name="Grip"><X>-3.39994735e-08</X><Y>3.39994877e-08</Y><Z>-0.99999994</Z><R00>-0.707134247</R00><R01>-0.707079291</R01><R02>0</R02><R10>0.707079291</R10><R11>-0.707134247</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></