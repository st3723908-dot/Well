v_u_4.PlayerRemoving:Connect(function(p43)
	-- upvalues: (copy) v_u_19, (copy) v_u_11, (copy) v_u_13
	if v_u_19:GetAttribute("UserId") == p43.UserId and v_u_19.Visible then
		local v44 = p43.UserId
		v_u_11.Profile(false)
		task.wait(1)
		v_u_11.Profile(true, v44)
		v_u_13.BannerNotify({
			["Header"] = "This Player has Left.",
			["Description"] = "Reopened Profile menu with offline features.",
			["Icon"] = "rbxassetid://11963361597",
			["Involved"] = nil,
			["Involved"] = { v44 }
		})
	end
end)
