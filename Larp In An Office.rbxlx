		for _, v4 in pairs(v3:GetChildren()) do
			if not v4:IsA("Frame") then
				continue
			end
			v4.Visible = false
		end
	end
end]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX29410"><Properties><string name="Name">MenuTemplates</string></Properties><Item class="CanvasGroup" referent="RBX29411"><Properties><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>1</XS><XO>-215</XO><YS>1</YS><YO>-130</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>210</XO><YS>0</YS><YO>125</YO></UDim2><bool name="Visible">false</bool><bool name="AutoLocalize">false</bool><string name="Name">Template1</string></Properties><Item class="Frame" referent="RBX29412"><Properties><Color3 name="BackgroundColor3"><R>0.368627459</R><G>0.337254912</G><B>0.835294127</B></Color3><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.189999998</YS><YO>0</YO></UDim2><int name="ZIndex">2</int><string name="Name">DragBar</string></Properties><Item class="TextLabel" referent="RBX29413"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Roboto.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Command</string><string name="Text">Command</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">18</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Vector2 name="AnchorPoint"><X>0</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.105882362</R><G>0.164705887</G><B>0.207843155</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.0450000018</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.600000