function EnterKeyforPeoplePage(p_u_164) -- name: EnterKeyforPeoplePage
	-- upvalues: (copy) v_u_154, (copy) v_u_2, (copy) v_u_10, (copy) v_u_11, (copy) v_u_9
	task.spawn(function()
		-- upvalues: (copy) p_u_164, (ref) v_u_154, (ref) v_u_2, (ref) v_u_10, (ref) v_u_11, (ref) v_u_9
		if p_u_164 then
			if not v_u_154.search.EnterKey:GetAttribute("Shown") then
				v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_10, {
					["Position"] = UDim2.fromScale(0, 1.5)
				}):Play()
				task.wait()
			end
			v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_11, {
				["Position"] = UDim2.fromScale(0, 0.5)
			}):Play()
		else
			if v_u_154.search.EnterKey:GetAttribute("Shown") then
				v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_10, {
					["Position"] = UDim2.fromScale(0, 0.5)
				}):Play()
				task.wait()
			end
			v_u_2:Create(v_u_154.search.EnterKey.Frame, v_u_9, {
				["Position"] = UDim2.fromScale(0, 1.5)
			}):Play()
		end
		v_u_154.search.EnterKey:SetAttribute("Shown", p_u_164)
	end)
end
