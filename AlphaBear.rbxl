Hints = { "You must hide from Bear at all costs. Do not let him see you.", "If you complete a Puzzle, the timer will be reduced, decreasing the amount of Time Bear has to Kill you.", "If Bear touches you, you will start to take damage. Lose all your health and it\'s Game Over." }
Main = script.Parent:WaitForChild("Main")
GUI = Main:WaitForChild("SurfaceGui")
ImageLabel = GUI:WaitForChild("Image")
HintLabel = GUI:WaitForChild("Hint")
Slide = 1
while true do
	wait(5)
	Slide = Slide + 1
	if Slide > #Images then
		Slide = 1
	end
	Main.SurfaceGui.Hint:TweenPosition(UDim2.new(0, 0, 1.25, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 1)
	for _ = 1, 20 do
		wait()
		ImageLabel.ImageTransparency = ImageLabel.ImageTransparency + 0.05
	end
	ImageLabel.Image = Images[Slide]
	wait(0.5)
	HintLabel.Text = Hints[Slide]
	Main.SurfaceGui.Hint:TweenPosition(UDim2.new(0, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 1)
	for _ = 1, 20 do
		wait()
		ImageLabel.ImageTransparency = ImageLabel.ImageTransparency - 0.05
	end
