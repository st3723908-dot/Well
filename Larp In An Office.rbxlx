	if v_u_2 then
		v_u_2:Stop()
	end
end)
inputListener = game:GetService("UserInputService").InputEnded:Connect(function(p5)
	-- upvalues: (ref) v_u_2
	if p5.UserInputType == Enum.UserInputType.MouseButton1 then
		if not v_u_2 then
			return
		end
		v_u_2:Stop()
		script.Parent.Handle.UseSound:Stop()
	end
end)]]></ProtectedString></Properties><Item class="Animation" referent="RBX6561"><Properties><Content name="AnimationContent"><url>rbxassetid://104544469100777</url></Content><Content name="AnimationId"><url>rbxassetid://104544469100777</url></Content><string name="Name">AnimationR6</string></Properties></Item><Item class="Animation" referent="RBX6562"><Properties><Content name="AnimationContent"><url>rbxassetid://102386815707833</url></Content><Content name="AnimationId"><url>rbxassetid://102386815707833</url></Content><string name="Name">AnimationR15</string></Properties></Item></Item><Item class="LocalScript" referent="RBX6563"><Properties><string name="Name">MobileButton</string><ProtectedString name="Source"><![CDATA[local v_u_1 = script.Parent
