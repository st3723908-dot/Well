function GunUp() -- name: GunUp
	-- upvalues: (copy) v_u_1
	Holstered = false
	v_u_1.Enabled = true
	torso = v_u_1.Parent:FindFirstChild("Torso")
	if torso ~= nil then
		torso.weld1.C1 = CFrame.new(-0.1, 1.25, 0.6) * CFrame.fromEulerAnglesXYZ(5.061454830783556, 0.17453292519943295, -1.5707963267948966)
		torso.weld2.C1 = CFrame.new(-1, -0.2, 0.35) * CFrame.fromEulerAnglesXYZ(-1.5707963267948966, -0.2617993877991494, 0)
	end
end
function GunDown() -- name: GunDown
	-- upvalues: (copy) v_u_1
	Holstered = true
	v_u_1.Enabled = false
	torso = v_u_1.Parent:FindFirstChild("Torso")
	if torso ~= nil then
		torso.weld1.C1 = CFrame.new(-0.1, 1.25, 0.6) * CFrame.fromEulerAnglesXYZ(4.886921905584122, -0.17453292519943295, -1.3962634015954636)
