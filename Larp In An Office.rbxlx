end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13710"><Properties><string name="Name">internalAssert</string><ProtectedString name="Source"><![CDATA[return function(p1, p2) -- name: internalAssert
	if not p1 then
