local v2 = game:GetService("ReplicatedStorage")
local _ = v1.LocalPlayer
local v3 = v2:WaitForChild("EXE6_STORAGE")
local _ = v3.events
local v4 = require(v3.modules.CustomCommands)
local v5 = v4:RegisterCommand("Tools")
v5.Alias = "Tools"
v5.Description = "Distribute Tools."
v5.Icon = "rbxassetid://11432855214"
v5.Event = v3.utilities.custom_commands.Tools
local v6 = {
	["Name"] = "Tools",
	["Items"] = nil,
	["SelectionRange"] = nil,
	["Items"] = v3.utilities.tools:GetChildren()
}
local v7 = NumberRange.new
local v8 = #v3.utilities.tools:GetChildren()
v6.SelectionRange = v7(1, (math.clamp(v8, 1, 999)))
v5:AddParameter("Enum", v6)
v5:AddParameter("Player", {
	["Name"] = "Recipient",
	["SelectionRange"] = nil,
	["SelectionRange"] = NumberRange.new(1, v1.MaxPlayers)
})
local v9 = v4:RegisterCommand("Clear Tools")
v9.Description = "Clears the backpack of a player."
v9.Icon = "rbxassetid://11326877264"
v9.Event = v3.utilities.custom_commands.ClearTools
v9:AddParameter("Player", {
	["Name"] = "Recipient",
	["SelectionRange"] = nil,
	["SelectionRange"] = NumberRange.new(1, v1.MaxPlayers)
})
local v10 = v4:RegisterCommand("Time")
v10.Description = "Change in-game time."
v10.Icon = "rbxassetid://11963371162"
v10.Event = v3.utilities.custom_commands.ChangeTime
v10:AddParameter("Boolean", {
	["Name"] = "Animate"
})
v10:AddParameter("Slider", {
	["Name"] = "Time",
	["SliderRange"] = nil,
	["SliderDefault"] = nil,
	["SliderIncrement"] = 0.01,
	["SliderRange"] = NumberRange.new(1, 24),
	["SliderDefault"] = game.Lighting.ClockTime
})
local v11 = v4:RegisterCommand("Clear Accessories")
v11.Alias = "Clear Accessories"
v11.Description = "Clear all of the accessories of a player."
v11.Icon = "rbxassetid://11432846321"
v11.Event = v3.utilities.custom_commands.ClearAccessories
v11:AddParameter("Boolean", {
	["Name"] = "IncludeHair",
	["StartingValue"] = true
})
v11:AddParameter("Player", {
	["Name"] = "Recipient",
	["SelectionRange"] = nil,
	["SelectionRange"] = NumberRange.new(1, v1.MaxPlayers)
})
local v12 = v4:RegisterCommand("Fling")
v12.Alias = "Fling"
v12.Description = "Send them out."
v12.Icon = "rbxassetid://97980406805013"
v12.Event = v3.events.misc.Fling
v5:AddParameter("Player", {
	["Name"] = "Victim",
	["SelectionRange"] = nil,
	["SelectionRange"] = NumberRange.new(1, v1.MaxPlayers)
})]]></ProtectedString></Properties></Item></Item></Item></Item></Item><Item class="Folder" referent="RBX21783"><Properties><string name="Name">EXE6_STORAGE</string><BinaryString name="Tags">RXhlNg==</BinaryString></Properties><Item class="Folder" referent="RBX21784"><Properties><string name="Name">events</string><BinaryString name="Tags">ZXZlbnRz</BinaryString></Properties><Item class="Folder" referent="RBX21785"><Properties><string name="Name">ui</string></Properties><Item class="BindableEvent" referent="RBX21786"><Properties><string name="Name">ExeToggled</string></Properties></Item><Item class="BindableEvent" referent="RBX21787"><Properties><string name="Name">ModalToggled</string></Properties></Item><Item class="RemoteEvent" referent="RBX21788"><Properties><string name="Name">AlertsModuleEvent</string></Properties></Item><Item class="BindableEvent" referent="RBX21789"><Properties><string name="Name">RecordedUserIdsSelectionUpdate</string></Properties></Item><Item class="RemoteEvent" referent="RBX21790"><Properties><string name="Name">ExeInterfaceLoaded</string></Properties></Item><Item class="BindableEvent" referent="RBX21791"><Properties><string name="Name">ForceCloseModals</string></Properties></Item><Item class="RemoteFunction" referent="RBX21792"><Properties><string name="Name">GetGameDesignTable</string></Properties></Item><Item class="BindableEvent" referent="RBX21793"><Properties><string name="Name">ConfirmationPromptClosed</string></Properties></Item><Item class="BindableEvent" referent="RBX21794"><Properties><string name="Name">Recalibrate</string></Properties></Item><Item class="RemoteEvent" referent="RBX21795"><Properties><string name="Name">NotifyEveryone</string></Properties></Item><Item class="RemoteEvent" referent="RBX21796"><Properties><string name="Name">ChangePrivacy</string></Properties></Item><Item class="RemoteEvent" referent="RBX21797"><Properties><string name="Name">WarningPrompt</string></Properties></Item><Item class="RemoteFunction" re