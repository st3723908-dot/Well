local function v_u_23(p15) -- name: separarLinhas
	local v16 = {}
	local v17 = {}
	for _, v18 in ipairs(p15) do
		if v18.type == "other" and v18.text == "\n" then
			table.insert(v16, v17)
			v17 = {}
		elseif (v18.type == "comment" or v18.type == "string") and string.find(v18.text, "\n") then
			local v19 = true
			for v20 in (v18.text .. "\n"):gmatch("(.-)\n") do
				if not v19 then
					table.insert(v16, v17)
					v17 = {
						["raw"] = true
					}
				end
				local v21 = {
					["type"] = v18.type,
					["text"] = v20
				}
				local v22 = v17
				table.insert(v22, v21)
				v19 = false
			end
		else
			table.insert(v17, v18)
		end
	end
	table.insert(v16, v17)
	v17 = {}
	return v16
end
local function v_u_40(p24, p25) -- name: nivelLua
	-- upvalues: (copy) v_u_12, (copy) v_u_13, (copy) v_u_14
	local v26 = 0
	local v27 = 0
	local v28 = 0
	local v29 = true
	local v30
	if p24[1] and p24[1].type == "word" then
		v30 = p24[1].text or nil
	else
		v30 = nil
	end
	for _, v31 in ipairs(p24) do
		local v32
		if v31.type == "word" then
			v32 = v31.text or nil
		else
			v32 = nil
		end
		local v33 = false
		if v32 then
			if v32 == "for" or v32 == "while" then
				p25.pendenteDo = true
				v26 = v26 + 1
			elseif v32 == "do" then
				if p25.pendenteDo then
					p25.pendenteDo = false
				else
					v26 = v26 + 1
				end
			elseif v_u_12[v32] then
				v26 = v26 + 1
			elseif v_u_13[v32] then
				v27 = v27 + 1
				v33 = true
			end
		else
			local v34
			if v31.type == "other" and v31.text == "{" then
				v34 = not v31.interp
			else
				v34 = false
			end
			if v34 then
