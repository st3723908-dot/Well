wait(1)
for v2, _ in pairs(v1.commandSpeeds) do
	if not v1.commandsActive[v2] then
		continue
	end
	v1.commandsActive[v2] = nil
	v1:GetModule("cf"):ActivateClientCommand(v2)
end]]></ProtectedString></Properties></Item></Item></Item><Item class="SoundService" referent="RBX31039"><Properties><bool name="AcousticSimulationEnabled">false</bool><token name="AmbientReverb">0</token><token name="AudioApiByDefault">0</token><token name="CharacterSoundsUseNewApi">0</token><token name="DefaultListenerLocation">3</token><bool name="DiffractionEnabled">true</bool><float name="DistanceFactor">3.32999992</float><float name="DopplerScale">1</float><bool name="IsNewExpForAudioApiByDefault">false</bool><CoordinateFrame name="ListenerCFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="ListenerObject">null</Ref><token name="ListenerType">0</token><bool name="OcclusionEnabled">true</bool><bool name="RespectFilteringEnabled">true</bool><bool name="ReverbEnabled">true</bool><float name="RolloffScale">1</float><token name="VolumetricAudio">1</token><string name="Name">SoundService</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Sound" referent="RBX31040"><Properties><Content name="AudioContent"><url>rbxassetid://1842205471</url></Content><bool name="Looped">true</bool><token name="RollOffMode">1</token><Content name="SoundId"><url>rbxassetid://1842205471</url></Content><float name="Volume">0.25</float><string name="Name">OldMusic</string><int64 name="SourceAssetId">120641373697997</int64></Properties></Item><Item class="Sound" referent="RBX31041"><Properties><Content name="AudioContent"><url>rbxassetid://1836686862</url></Content><bool name="Looped">true</bool><bool name="Playing">true</bool><token name="RollOffMode">1</token><Content name="SoundId"><url>rbxassetid://1836686862</url></Content><double name="TimePosition">52.506</double><float name="Volume">0.25</float><string name="Name">Music</string><int64 name="SourceAssetId">120641373697997</int64></Properties></Item><Item class="AudioDeviceOutput" referent="RBX31042"