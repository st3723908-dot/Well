	end
	return v8 + v10 * v11
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16890"><Properties><string name="Name">SpringConstraint</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3, p4, p5)
	local v6 = p4.Settings
