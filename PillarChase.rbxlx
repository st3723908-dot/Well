tring><Color3 name="TextColor3"><R>1</R><G>0.741176486</G><B>0.290196091</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><float name="TextStrokeTransparency">0.75</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><UDim2 name="Position"><XS>0.278904349</XS><XO>0</XO><YS>0.83409673</YS><YO>0</YO></UDim2><float name="Rotation">0.5</float><UDim2 name="Size"><XS>0.417938292</XS><XO>0</XO><YS>0.0747390687</YS><YO>0</YO></UDim2><int name="ZIndex">55</int><string name="Name">Stars</string></Properties><Item class="UIGradient" referent="RBX13496"><Properties><ColorSequence name="Color">0 1 1 1 0 0.776816607 1 1 1 0 0.870242238 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">90</float><string name="Name">UIGradient</string></Properties></Item></Item><Item class="TextLabel" referent="RBX13497"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">An entity made up of pure energy, taking the form of a bad photocopy of Man. Seeing humanity as nothing more than canvases for his work, Brutum relies on his resourcefulness, his tools, and his materials to create his twisted version of &quot;art.&quot; 

Using a handyman&apos;s workshop as a Venus flytrap, he has managed to create many of these projects; the town it resided in has become a ghost town. 
Rumors of the place having a &quot;death curse&quot; haunt it, driving people away and keeping them safe. 

But there will always be people wanting to stick their noses where they don&apos;t belong.</string><string name="Text">An entity made up of pure energy, taking the form of a bad photocopy of Man. Seeing humanity as nothing more than canvases for his work, Brutum relies on his resourcefulness, his tools, and his materials to create his twisted version of &quot;art.&quot; 

Using a handyman&apos;s workshop as a Venus flytrap, he has managed to create many of these projects; the town it resided in has become a ghost town. 
Rumors of the place having a &quot;death curse&quot; haunt it, driving people away and keeping them safe. 

But there will always be people wanting to stick their noses where they don&apos;t belong.</string><Color3 name="TextColor3"><R>0.23137255</R><G>0.215686277</G><B>0.188235298</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0.549019635</R><G>0.466666669</G><B>0.337254912</B></Color3><float name="TextStrokeTransparency">0.949999988</float><bool name="TextWrapped">true</bool><token name="TextYAlignment">0</token><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><UDim2 name="Position"><XS>0.720625341</XS><XO>0</XO><YS>0.479152769</YS><YO>0</YO></UDim2><float name="Rotation">-1</float><UDim2 name="Size"><XS>0.409380138</XS><XO>0</XO><YS>0.847833157</YS><YO>0</YO></UDim2><int name="ZIndex">55</int><string name="Name">Desc</string></Properties><Item class="UIGradient" referent="RBX13498"><Properties><ColorSequence name="Color">0 1 1 1 0 0.961937726 1 1 1 0 0.984429121 0.490196079 0.490196079 0.490196079 0 1 0.247058824 0.247058824 0.247058824 0 </ColorSequence><float name="Rotation">-90</float><string name="Name">UIGradient</string></Properties></Item></Item></Item><Item class="ImageLabel" referent="RBX13499"><Properties><Content name="Image"><url>rbxassetid://135738673694516</url></Content><Content name="ImageContent"><url>rbxassetid://135738673694516</url></Content><token name="ResampleMode">1</token><token name="ScaleType">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><bool name="Interactable">false</bool><UDim2 name="Position"><XS>0.0820923746</XS><XO>0</XO><YS>0