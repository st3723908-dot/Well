function NormalizedCursorPosition(p40) -- name: NormalizedCursorPosition
	-- upvalues: (copy) v_u_2
	local v41 = v_u_2:GetMouseLocation()
	local v42 = game:GetService("GuiService"):GetGuiInset().Y
