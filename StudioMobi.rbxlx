end)]]></ProtectedString></Properties></Item><Item class="UIAspectRatioConstraint" referent="RBX490"><Properties><string name="Name">UIAspectRatioConstraint</string></Properties></Item><Item class="UICorner" referent="RBX491"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>2</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>2</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>2</O></UDim><UDim name="TopRightRadius"><S>0</S><O>2</O></UDim><string name="Name">UICorner</string></Properties></Item></Item><Item class="TextLabel" referent="RBX492"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">Animation Editor</string><string name="Text">Animation Editor</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Vector2 name="AnchorPoint"><X>0</X><Y>0.5</Y></Vector2><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.074000001</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.400000006</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1001</int><string name="Name">TextLabel</string></Properties></Item></Item><Item class="ScrollingFrame" referent="RBX493"><Properties><Vector2 name="AbsoluteCanvasSize"><X>126.360008</X><Y>956</Y></Vector2><Vector2 name="AbsoluteWindowSize"><X>125.360008</X><Y>337.856415</Y></Vector2><token name="AutomaticCanvasSize">2</token><Color3 name="ScrollBarImageColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="ScrollBarThickness">1</int><bool name="Active">true</bool><Color3 name="BackgroundColor3"><R>0.227450982</R><G>0.250980407</G><B>0.294117659</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>0.174999997</XS><XO>0</XO><YS>0.150000006</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.648000002</XS><XO>0</XO><YS>0.899999976</YS><YO>0</YO></UDim2><bool name="Visible">false</bool><int name="ZIndex">1001</int><string name="Name">TutorialFrame</string></Properties><Item class="UIStroke" referent="RBX494"><Properties><Color3 name="Color"><R>0.141176477</R><G>0.149019614</G><B>0.192156866</B></Color3><string name="Name">UIStroke</string></Properties></Item><Item class="TextLabel" referent="RBX495"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/BuilderSans.json</url></Family><Weight>500</Weight><Style>Normal</Style></Font><string name="LocalizedText">&lt;font size=&quot;22&quot;&gt;&lt;b&gt;Animation Help&lt;/b&gt;&lt;/font&gt;

&lt;b&gt;Playing an animation&lt;/b&gt;
Use the &lt;font color=&quot;#5ABEFF&quot;&gt;&lt;b&gt;SMFXAnimator&lt;/b&gt;&lt;/font&gt; module in a script:

&lt;font color=&quot;#A0A8B8&quot;&gt;local Anim = require(game.ReplicatedStorage.SMFX.Anim.SMFXAnimator)
local data = Anim.fromEditorPayload(payload)
local track = Anim.play(model, data, { Looped = true, Priority = &quot;Action&quot;, Speed = 1, Weight = 1, Fade = 0.1 })&lt;/font&gt;

&lt;b&gt;Controlling the track&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;track:AdjustSpeed(2)
track:AdjustWeight(0.5, 0.2)
track:Stop(0.2)&lt;/font&gt;

&lt;b&gt;Events&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;track.Ended:Connect(function()
end)
track.KeyframeReached:Connect(function(name)
end)
track:GetMarkerReachedSignal(&quot;Name&quot;):Connect(function(value)
end)&lt;/font&gt;

&lt;b&gt;Camera animation&lt;/b&gt;
Add &lt;font color=&quot;#5ABEFF&quot;&gt;&lt;b&gt;Camera = true&lt;/b&gt;&lt;/font&gt; to the options to play the camera track:
&lt;font color=&quot;#A0A8B8&quot;&gt;Anim.play(model, data, { Camera = true })&lt;/font&gt;
Use &lt;b&gt;Camera = player&lt;/b&gt; or &lt;b&gt;Camera = { player1, player2 }&lt;/b&gt; to affect only those players. Without this option the camera is not played.

&lt;b&gt;Server and client&lt;/b&gt;
Animations played from the server are shown to players through a remote, but only clients that already required the &lt;b&gt;SMFXAnimator&lt;/b&gt; will see them. In a published game, add a LocalScript that requires the module.

&lt;b&gt;Priorities&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;Core, Idle, Movement, Action, Action2, Action3, Action4&lt;/font&gt;
Higher priorities override lower ones on the same joint.

&lt;b&gt;Tips&lt;/b&gt;
&lt;font color=&quot;#FFAA28&quot;&gt;Keep the first and the last key equal for smooth loops.&lt;/font&gt;
If a joint does not move, check that its row has keys and that the part name matches the joint of the rig.
Messages starting with &lt;b&gt;[SMFXAnim]&lt;/b&gt; in the Console explain what went wrong.
</string><bool name="RichText">true</bool><string name="Text">&lt;font size=&quot;22&quot;&gt;&lt;b&gt;Animation Help&lt;/b&gt;&lt;/font&gt;

&lt;b&gt;Playing an animation&lt;/b&gt;
Use the &lt;font color=&quot;#5ABEFF&quot;&gt;&lt;b&gt;SMFXAnimator&lt;/b&gt;&lt;/font&gt; module in a script:

&lt;font color=&quot;#A0A8B8&quot;&gt;local Anim = require(game.ReplicatedStorage.SMFX.Anim.SMFXAnimator)
local data = Anim.fromEditorPayload(payload)
local track = Anim.play(model, data, { Looped = true, Priority = &quot;Action&quot;, Speed = 1, Weight = 1, Fade = 0.1 })&lt;/font&gt;

&lt;b&gt;Controlling the track&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;track:AdjustSpeed(2)
track:AdjustWeight(0.5, 0.2)
track:Stop(0.2)&lt;/font&gt;

&lt;b&gt;Events&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;track.Ended:Connect(function()
end)
track.KeyframeReached:Connect(function(name)
end)
track:GetMarkerReachedSignal(&quot;Name&quot;):Connect(function(value)
end)&lt;/font&gt;

&lt;b&gt;Camera animation&lt;/b&gt;
Add &lt;font color=&quot;#5ABEFF&quot;&gt;&lt;b&gt;Camera = true&lt;/b&gt;&lt;/font&gt; to the options to play the camera track:
&lt;font color=&quot;#A0A8B8&quot;&gt;Anim.play(model, data, { Camera = true })&lt;/font&gt;
Use &lt;b&gt;Camera = player&lt;/b&gt; or &lt;b&gt;Camera = { player1, player2 }&lt;/b&gt; to affect only those players. Without this option the camera is not played.

&lt;b&gt;Server and client&lt;/b&gt;
Animations played from the server are shown to players through a remote, but only clients that already required the &lt;b&gt;SMFXAnimator&lt;/b&gt; will see them. In a published game, add a LocalScript that requires the module.

&lt;b&gt;Priorities&lt;/b&gt;
&lt;font color=&quot;#A0A8B8&quot;&gt;Core, Idle, Movement, Action, Action2, Action3, Action4&lt;/font&gt;
Higher priorities override lower ones on the same joint.

&lt;b&gt;Tips&lt;/b&gt;
&lt;font color=&quot;#FFAA28&quot;&gt;Keep the first and the last key equal for smooth loops.&lt;/font&gt;
If a joint does not move, check that its row has keys and that the part name matches the joint of the rig.
Messages starting with &lt;b&gt;[SMFXAnim]&lt;/b&gt; in the Console explain what went wrong.
</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">12</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>0.635294139</R><G>0.635294139</G><B>0.635294139</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">1001</int><string name="Name">TextLabel</string></Properties></Item><Item class="UICorner" referent="RBX496"><Properties><UDim name="BottomLeftRadius"><S>0</S><O>3</O></UDim><UDim name="BottomRightRadius"><S>0</S><O>3</O></UDim><UDim name="TopLeftRadius"><S>0</S><O>3</O></UDim><UDim name="TopRightRadius"><S>0</S><O>3</O></UDim><string name="Name">UICorner</string></Properties></Item></Item><Item class="ImageButton" referent="RBX497"><Properties><Content name="Image"><url>rbxthumb://type=Asset&amp;id=115443342386366&amp;w=420&amp;h=420</url></Content><Content name="ImageContent"><url>rbxthumb://type=Asset&amp;id=115443342386366&amp;w=420&amp;h=420</url></Content><Vector2 name="AnchorPoint"><X>1</X><Y>1</Y></Vector2><Color3 name="BackgroundColor3"><R>0.200000003</R><G>0.223529413</G><B>0.250980407</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><UDim2 name="Position"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>15</XO><YS>0</YS><YO>15</YO></UDim2><int name="ZIndex">1001</int><string name="Name">Resize</string></Properties><Item class="LocalScript" referent="RBX498"><Properties><string name="Name">LocalScript</string><ProtectedString name="Source"><![CDATA[local v1 = game:GetService("UserInputService")
local v2 = script.Parent
local v_u_3 = v2.Parent
local v_u_4 = nil
local function v_u_20(p5) -- name: resizeTo
	-- upvalues: (copy) v_u_3, (ref) v_u_4
	local v6 = v_u_3:FindFirstAncestorWhichIsA("LayerCollector")
	local v7, v8
	if v6 then
		local v9 = v_u_3.AbsolutePosition - v6.AbsolutePosition
		local v10 = v6.AbsoluteSize.X - v9.X - 8
		local v11 = v6.AbsoluteSize.Y - v9.Y - 8
		v7 = math.max(v10, 100)
		v8 = math.max(v11, 100)
	else
		v7 = (1 / 0)
		v8 = (1 / 0)
	end
	local v12 = Vector2.new(p5.Position.X, p5.Position.Y) - v_u_4.start
	local v13 = v_u_4.size.X + v12.X
	local v14 = math.clamp(v13, 100, v7)
	local v15 = v_u_4.size.Y + v12.Y
	local v16 = math.clamp(v15, 100, v8)
	local v17 = v_u_3
	local v18 = 1
	while v17 do
		local v19 = v17:FindFirstChildOfClass("UIScale")
		if v19 then
			v18 = v18 * v19.Scale
		end
		v17 = v17.Parent
	end
	v_u_3.Size = UDim2.fromOffset(v14 / v18, v16 / v18)
end
v2.InputBegan:Connect(function(p21)
	-- upvalues: (ref) v_u_4, (copy) v_u_3
