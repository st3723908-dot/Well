v_u_1.ChildAdded:Connect(function(p_u_2)
	-- upvalues: (copy) v_u_1
	p_u_2:WaitForChild("UIStroke")
	p_u_2.MouseButton1Down:Connect(function()
		-- upvalues: (ref) v_u_1, (copy) p_u_2
		if v_u_1:FindFirstChild("Selected", true) == nil then
			game.ReplicatedStorage.GlobalEvents.PickMap:FireServer(p_u_2.Name)
			p_u_2.UIStroke.Color = Color3.fromRGB(0, 255, 0)
			local v3 = script.Parent.Parent.Sounds.Click:Clone()
			v3.Parent = script
			v3.PlayOnRemove = true
			v3:Destroy()
			Instance.new("BoolValue", p_u_2).Name = "Selected"
			for _, v_u_4 in pairs(v_u_1:GetChildren()) do
				if v_u_4 == p_u_2 or not v_u_4:IsA("ImageButton") then
					continue
				end
				v_u_4:TweenSize(UDim2.new(0, 0, 0, 0), "InOut", "Sine", 0.1, true)
				task.spawn(function()
					-- upvalues: (copy) v_u_4
					task.wait(0.1)
					v_u_4:Destroy()
				end)
			end
		end
	end)
	p_u_2.MouseEnter:Connect(function()
		-- upvalues: (copy) p_u_2
		p_u_2:TweenSize(UDim2.new(1.3, 0, 1.05, 0), "InOut", "Sine", 0.1, true)
		local v5 = script.Parent.Parent.Sounds.Hover:Clone()
		v5.Parent = script
		v5.PlayOnRemove = true
		v5:Destroy()
	end)
	p_u_2.MouseLeave:Connect(function()
		-- upvalues: (copy) p_u_2
		p_u_2:TweenSize(UDim2.new(1.25, 0, 1, 0), "InOut", "Sine", 0.1, true)
	end)
end)
script.Big.Changed:Connect(function()
	if script.Big.Value == true then
		script.Parent:TweenSize(UDim2.new(0.7, 0, 0.7, 0), "InOut", "Sine", 0.2, true)
		script.Parent.Visible = true
	else
		task.wait(0.1)
		script.Parent:TweenSize(UDim2.new(0, 0, 0, 0), "InOut", "Sine", 0.2, true)
		task.wait(0.2)
		script.Parent.Visible = false
