function RemovePerson(p136, p137) -- name: RemovePerson
	-- upvalues: (copy) v_u_23, (copy) v_u_24, (copy) v_u_30, (copy) v_u_17
	local v138 = p136.UserId
	update_meter()
	update_counts_overview()
	local v139 = v_u_23.scroll.people:FindFirstChild(tostring(v138), true)
	local v140 = v_u_24.scroll.display.scroll:FindFirstChild((tostring(v138)))
	if v139 and v139:IsA("ImageButton") then
		v139:Destroy()
	end
	if v140 then
		if table.find(v_u_30.PeopleSelection, p136.UserId) and not p137 then
			v_u_17.BannerNotify({
				["Header"] = "Current Selection Updated",
				["Description"] = nil,
				["Icon"] = "rbxassetid://12974235428",
				["Involved"] = nil,
				["Description"] = p136.DisplayName .. " has left the game therefore your selection has been updated.",
				["Involved"] = { v138 }
			})
		end
		PeoplePageSelection(v140, p136, false)
		v140:Destroy()
	end
end
function InitiatePeople() -- name: InitiatePeople
	-- upvalues: (copy) v_u_6, (copy) v_u_23, (copy) v_u_24
	for _, v141 in v_u_6:GetPlayers() do
		local v142 = { v_u_23, v_u_24 }
		AddPerson(v141, v142)
	end
end
