		end
		v_u_13 = {
			["Header"] = v_u_20:GetAttribute("Header"),
			["Description"] = v_u_20:GetAttribute("Description")
		}
		task.spawn(function()
			-- upvalues: (ref) v_u_18, (copy) p_u_15, (copy) v_u_20, (ref) v_u_9
			if not v_u_18 then
