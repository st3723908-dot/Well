	["FAQ"] = {
		["g1"] = {
			["Title"] = "\"How do I get the game ID?\"",
			["Description"] = "To find your game ID, open the game in the Roblox website and look at the URL.\n\nThe game ID is the number shown after /games/ in the URL.\n\nExample:\nroblox.com/games/123456789/GameName\n\nIn this example, 123456789 is the game ID."
		},
		["g2"] = {
			["Title"] = "\"How do i get my API Key?\"",
			["Description"] = "To create an API Key for Studio Mobi, open the Roblox Creator Dashboard and go to Creations > API Keys.\n\nClick Create API Key and give it a name such as Studio Mobi.\n\nUnder Access Permissions, select the permissions required to manage your experience through Open Cloud, including the \"universe-places\" write permission needed by Studio Mobi.\n\nUnder Experiences, select the game you want Studio Mobi to publish to.\n\nAfter creating the API Key, copy it and paste it into Studio Mobi.\n\nNever share your API Key with anyone. Keep it private, because it can be used to access your Roblox experience through Open Cloud."
		},
		["g3"] = {
			["Title"] = "\"How do i update the sub-place of my game?\"",
			["Description"] = "To update a sub-place, go to the Game ID field and enter the main game ID followed by the sub-place ID, separated by a comma.\n\nExample:\n123456789, 987654321\n\nThe first number is the Game ID and the second number is the Sub-place ID."
		},
		["g4"] = {
			["Title"] = "\"Why is my game incomplete?\"",
			["Description"] = "Your game may be incomplete because the project is too large. Each project has a 4 MB limit, so if your project exceeds this limit, some of its data may not be saved."
		},
		["g5"] = {
			["Title"] = "\"Why does Studio Mobi require an API Key to publish a game?\"",
			["Description"] = "Studio Mobi requires an API Key to securely communicate with Roblox\'s Open Cloud API and publish your project to the selected game. The API Key allows Studio Mobi to authenticate the request without requiring access to your Roblox account."
		}
	}
}
return v1]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX163"><Properties><string name="Name">SMFXAlignCore</string><ProtectedString name="Source"><![CDATA[local v_u_1 = game:GetService("Players")
