			v_u_10:TweenSize(v_u_10:GetAttribute("FullSize"), "InOut", "Sine", 0.2, true)
			v_u_10.WhatDo.Text = "Finish Purchase"
		end
		if script.ShopStuff.Item.Value and (script.ShopStuff.Item.Value:GetAttribute("CostRobux") and (script.ShopStuff.Item.Value:GetAttribute("OnSale") and (script.ShopStuff.Item.Value.Value == false and v_u_26 == false))) then
			v_u_26 = true
			v_u_11.Visible = true
			v_u_11:TweenSize(v_u_11:GetAttribute("FullSize"), "InOut", "Sine", 0.2, true)
		end
