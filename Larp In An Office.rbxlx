		expect(#v6).to.equal(3)
		expect(v6[1]).to.equal(true)
		expect(v6[2]).to.equal(true)
		expect(v6[3]).to.equal(true)
		expect(v6[4]).to.equal(nil)
		expect(v6.a).to.equal(true)
		expect(v6.b).to.equal(true)
		expect(v6.c).to.equal(true)
	end)
