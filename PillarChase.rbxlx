		local v6 = script.Parent.BanLength.Text
		if tonumber(v6) then
			v4 = script.Parent.BanLength.Text
		end
	end
	script.Parent.AdminUI.Ban:FireServer(v5, v3, v4, v_u_2, v_u_1)
end)
