	local v1 = script.Parent.Parent.Parent.Percent
	local v2 = script.Parent.Position.X.Scale / 1 * 100
	v1.Text = math.round(v2) .. "%"
	if script.Parent.Position.X.Scale > 1 then
		script.Parent.Position = UDim2.new(1, 0, 0.5, 0)
	end
	if script.Parent.Position.X.Scale < 0 then
		script.Parent.Position = UDim2.new(0, 0, 0.5, 0)
	end
end)
script.Parent.UIDragDetector.DragStart:Connect(function()
	script.Parent.UIStroke.Thickness = 6
end)
script.Parent.UIDragDetector.DragEnd:Connect(function()
	script.Parent.UIStroke.Thickness = 4
	game.Players.LocalPlayer.PlayerGui.LobbyGUI.ButtonFrames.BaseMenu.WorkMenu.Events.ChangeSetting:FireServer("ChaseVolume", script.Parent.Position.X.Scale)
end)]]></ProtectedString></Properties></Item><Item class="UICorner" referent="RBX15492"><Properties><UDim name="BottomLeftRadius"><S>15</S><O>0</O></UDim><UDim name="BottomRightRadius"><S>15</S><O>0</O></UDim><UDim name="TopLeftRadius"><S>15</S><O>0</O></UDim><UDim name="TopRightRadius"><S>15</S><O>0</O></UDim><string name="Name">UICorner</string></Properties></Item><Item class="UIDragDetector" referent="RBX15493"><Properties><token name="BoundingBehavior">2</token><Ref name="BoundingUI">RBX15487</Ref><token name="DragStyle">1</token><Ref name="ReferenceUIInstance">RBX15487</Ref><token name="ResponseStyle">1</token><UDim2 name="SelectionModeDragSpeed"><XS>1</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><token name="UIDragSpeedAxisMapping">1</token><string name="Name">UIDragDetector</string></Properties></Item><Item class="UIStroke" referent="RBX15494"><Properties><token name="ApplyStrokeMode">1</token><Color3 name="Color"><R>1</R><G>1</G><B>1</B></Color3><float name="Thickness">4</float><float name="Transparency">0.5</float><string name="Name">UIStroke</string></Properties></Item></Item></Item><Item class="TextLabel" referent="RBX15495"><Properties><Font name="FontFace"><Family><url>rbxasset://fonts/families/Merriweather.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="LocalizedText">Character Volume</string><string name="Text">Character Volume</string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">0.5</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><token name="GuiState">3</token><bool name="Interactable">false</bool><UDim2 name="Position"><XS>-0.913841426</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1.16838336</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDi