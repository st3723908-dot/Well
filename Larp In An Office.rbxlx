		expect(v3[1]).to.equal("first")
		expect(v3[2]).to.equal("third")
	end)
	it("should not remove any element if index is out of bound", function()
		-- upvalues: (copy) v_u_1
		local v4 = { "first", "second", "third" }
		local v5 = v_u_1(v4, 4)
		expect(#v5).to.equal(#v4)
		for v6 = 1, #v4 do
			expect(v5[v6]).to.equal(v4[v6])
		end
		local v7 = v_u_1(v4, -2)
		expect(#v7).to.equal(#v4)
		for v8 = 1, #v4 do
			expect(v7[v8]).to.equal(v4[v8])
		end
	end)
	it("should work with a None element", function()
		-- upvalues: (copy) v_u_2, (copy) v_u_1
		local v9 = v_u_1({ "first", v_u_2, "third" }, 1)
		expect(#v9).to.equal(2)
		expect(v9[1]).to.equal(v_u_2)
		expect(v9[2]).to.equal("third")
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28389"><Properties><string name="Name">removeRange</string><ProtectedString name="Source"><![CDATA[return function(p1, p2, p3) -- name: removeRange
	local v4 = p2 <= p3
	assert(v4, "startIndex must be less than or equal to endIndex")
