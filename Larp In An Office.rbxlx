	local v_u_1 = require(script.Parent.join)
	local v_u_2 = require(script.Parent.Parent.None)
	it("should return a new table", function()
		-- upvalues: (copy) v_u_1
		local v3 = {}
		expect(v_u_1(v3)).never.to.equal(v3)
	end)
	it("should merge tables, overwriting previous values", function()
		-- upvalues: (copy) v_u_1
		local v4 = {
			["foo"] = "foo-a",
			["bar"] = "bar-a"
		}
		local v5 = {
			["foo"] = "foo-b",
			["baz"] = "baz-b"
		}
		local v6 = v_u_1(v4, v5)
		expect(v6.foo).to.equal(v5.foo)
		expect(v6.bar).to.equal(v4.bar)
		expect(v6.baz).to.equal(v5.baz)
	end)
	it("should remove values set to None", function()
		-- upvalues: (copy) v_u_2, (copy) v_u_1
		local v7 = v_u_1({
			["foo"] = "foo-a"
		}, {
			["foo"] = v_u_2
		})
		expect(v7.foo).to.equal(nil)
	end)
	it("should not mutate passed in tables", function()
		-- upvalues: (copy) v_u_1
		local v_u_8 = 0
		local v_u_9 = 0
		local v10 = {}
		local v11 = {
			["foo"] = "foo-b"
		}
		local v12 = {
			["__newindex"] = function() -- name: __newindex
				-- upvalues: (ref) v_u_8
				v_u_8 = v_u_8 + 1
			end
		}
		setmetatable(v10, v12)
		local v13 = {
			["__newindex"] = function() -- name: __newindex
				-- upvalues: (ref) v_u_9
				v_u_9 = v_u_9 + 1
			end
		}
		setmetatable(v11, v13)
		v_u_1(v10, v11)
		expect(v_u_8).to.equal(0)
		expect(v_u_9).to.equal(0)
		expect(v11.foo).to.equal("foo-b")
	end)
	it("should accept arbitrary numbers of tables", function()
		-- upvalues: (copy) v_u_1
		local v14 = {
			["foo"] = "foo-a"
		}
		local v15 = {
			["bar"] = "bar-b"
		}
		local v16 = {
			["baz"] = "baz-c"
		}
		local v17 = v_u_1(v14, v15, v16)
		expect(v17.foo).to.equal(v14.foo)
		expect(v17.bar).to.equal(v15.bar)
		expect(v17.baz).to.equal(v16.baz)
