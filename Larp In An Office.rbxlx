function PromptRoleOfProfile(p41) -- name: PromptRoleOfProfile
	-- upvalues: (copy) v_u_9, (copy) v_u_19, (copy) v_u_11, (copy) v_u_13
	local v42 = v_u_9.auth.Auth:InvokeServer("IsAuthorized", v_u_19:GetAttribute("UserId"))
	if v42 then
		v_u_11.RoleInfo(true, v42.Role.Alias, p41)
	else
		v_u_13.BannerNotify({
			["Header"] = "Failed To Fetch Role Details",
			["Description"] = "An error occurred upon fetching role information.",
			["Icon"] = "rbxassetid://11422145135",
			["Involved"] = nil,
			["Involved"] = { v_u_19:GetAttribute("UserId") }
		})
	end
end
