local v1 = script.Parent.Parent:WaitForChild("Humanoid")
script.Parent.Parent:WaitForChild("HumanoidRootPart")
local v2 = require(game.ReplicatedStorage.Modules.CreateFunctions)
while true do
	v2.NewWait(0.05)
	if v1.MoveDirection ~= Vector3.new(0, 0, 0) and (script.Parent:WaitForChild("SkatingSound").IsPlaying == false and game.Players.LocalPlayer.Character:GetAttribute("DeadSilent") == nil) then
		v2.PlaySound(script.Parent.SkatingSound, 0, true, true, nil)
	end
	if v1.MoveDirection ~= Vector3.new(0, 0, 0) or script.Parent:WaitForChild("SkatingSound").IsPlaying ~= true then
		continue
	end
	v2.PlaySound(script.Parent.SkatingSound, 0, false, true, nil)
end]]></ProtectedString></Properties></Item><Item class="Sound" referent="RBX10573"><Properties><Content name="AudioContent"><url>rbxassetid://22917014</url></Content><bool name="Looped">true</bool><float name="RollOffMaxDistance">50</float><float name="RollOffMinDistance">2.70000005</float><token name="RollOffMode">3</token><Ref name="SoundGroup">RBX17582</Ref><Content name="SoundId"><url>rbxassetid://22917014</url></Content><string name="Name">SkatingSound</string></Properties></Item><Item class="Motor6D" referent="RBX10574"><Properties><CoordinateFrame name="C0"><X>-0.49987793</X><Y>-2.65230179</Y><Z>-0.249802589</Z><R00>-1.13248825e-05</R00><R01>0.766070843</R01><R02>-0.642756104</R02><R10>-1</R10><R11>-1.13248825e-05</R11><R12>4.14252281e-06</R12><R20>-4.14252281e-06</R20><R21>0.642756104</R21><R22>0.766070843</R22></CoordinateFrame><CoordinateFrame name="C1"><X>-0.0867659003</X><Y>-0.137615204</Y><Z>-0.182861328</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">RBX10571</Ref><Ref name="Part1">RBX10571</Ref><string name="Name">Skate</string></Properties></Item></Item><Item class="MeshPart" referent="RBX10575"><Properties><Content name="MeshContent"><url>http://www.roblox.com/asset/?id=36365830</url></Content><Content name="MeshId"><url>http://www.roblox.com/asset/?id=36365830</url></Content><Content name="TextureContent"><url>rbxassetid://36365793</url></Content><Content name="TextureID"><url>rbxassetid://36365793</url></Content><Vector3 name="UnscaledCofm"><X>0.00430735294</X><Y>-0.00271782884</Y><Z>-1.86123741</Z></Vector3><Vector3 name="UnscaledVolInertiaDiags"><X>0.600634038</X><Y>0.600636065</Y><Z>0.0621561147</Z></Vector3><Vector3 name="UnscaledVolInertiaOffDiags"><X>-1.84390245e-08</X><Y>4.07481878e-07</Y><Z>-6.39305927e-06</Z></Vector3><float name="UnscaledVolume">0.637056112</float><CoordinateFrame name="CFrame"><X>56.1129456</X><Y>1.95011556</Y><Z>93.05916