end
local function v_u_50(p36, p37, p38, p39) -- name: ApplyRewards
	-- upvalues: (copy) v_u_5
	local v40 = p36.Container.Icon:FindFirstChild("Items")
	if v40 then
		local v41 = p38.RewardItems or {}
		local v42 = p39.Notes or {}
		for v43, v44 in v41 do
			local v45 = v40:FindFirstChild("Reward" .. v43)
			if v45 then
				v45.Image = v_u_5:GetDisplayInfo(v44.ItemID, v44.ItemType).Image
				v45.Amount.Text = "x" .. v_u_5:CommaNumber(v44.Amount)
				local v46 = v45:FindFirstChild("Note")
				if not v46 then
					continue
				end
				v46.Text = v42[v44.ItemID] or ""
				v46.Visible = v42[v44.ItemID] ~= nil
			else
				warn((("[EventShopService] %*: %* has no Reward%* slot for %*"):format(p37, p39.Shape, v43, v44.ItemID)))
			end
		end
		for _, v47 in v40:GetChildren() do
			local v48 = v47.Name
			local v49 = tonumber(v48:match("^Reward(%d+)$"))
			if not v49 or v41[v49] then
				continue
			end
			v47.Visible = false
		end
	end
end
