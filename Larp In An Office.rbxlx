	if p1 == "FlipEmote" then
		local v2 = game.Players.LocalPlayer.Character.Humanoid
		local v3 = Instance.new("Animation")
		if v2.RigType == Enum.HumanoidRigType.R6 then
			v3.AnimationId = "rbxassetid://84683947894054"
		else
			v3.AnimationId = "rbxassetid://131773031491951"
		end
		local v4 = v2:FindFirstChildOfClass("Animator"):LoadAnimation(v3)
		v4:Play()
		task.wait(30)
		v4:Stop()
	end
end)]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX31038"><Properties><string name="Name">HDAdminStarterCharacter</string><ProtectedString name="Source"><![CDATA[local v1 = require(game:GetService("ReplicatedStorage"):WaitForChild("HDAdminSetup", 999)):GetMain()
