	["Remove"] = function(p75)
		local v76 = {}
		for _, v77 in pairs(p75) do
			if not v77 then
				continue
			end
			if v77:IsA("BasePart") then
				table.insert(v76, v77)
			elseif v77:IsA("Smoke") or (v77:IsA("Fire") or (v77:IsA("Sparkles") or (v77:IsA("DataModelMesh") or (v77:IsA("Decal") or (v77:IsA("Texture") or v77:IsA("Light")))))) then
				local v78 = v77.Parent
				table.insert(v76, v78)
			else
				if not (v77:IsA("Model") or v77:IsA("Folder")) then
					continue
				end
				Support.ConcatTable(v76, Support.GetDescendantsWhichAreA(v77, "BasePart"))
			end
		end
		if CanModifyItems(p75) then
			if not Security.ArePartsViolatingAreas(v76, Player, true) then
				for _, v79 in pairs(p75) do
					LastParents[v79] = v79.Parent
					CreatedInstances[v79] = v79
					v79.Parent = nil
				end
			end
		else
			return
		end
	end,
	["UndoRemove"] = function(p80)
		local v81 = {}
		for _, v82 in pairs(p80) do
			if not (v82 and LastParents[v82]) then
				continue
			end
			if v82:IsA("BasePart") then
				table.insert(v81, v82)
			elseif v82:IsA("Smoke") or (v82:IsA("Fire") or (v82:IsA("Sparkles") or (v82:IsA("DataModelMesh") or (v82:IsA("Decal") or (v82:IsA("Texture") or v82:IsA("Light")))))) then
				local v83 = v82.Parent
				table.insert(v81, v83)
			else
				if not (v82:IsA("Model") or v82:IsA("Folder")) then
					continue
				end
