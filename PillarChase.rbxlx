			}):Play()
			script.Parent.Parent.MapTips.AnchorPoint = Vector2.new(0, 0)
		until script.Parent.Parent.Visible == false
	end)
	task.wait(0.01)
	game.UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	workspace.CurrentCamera.CFrame = workspace.Map.WaitSpots["" .. v2].CFrame
	local v5 = nil
	v2 = #workspace.Map.WaitSpots:GetChildren() < v2 and 1 or v2
	if not (workspace.Map:GetAttribute("Ready") or v5) then
