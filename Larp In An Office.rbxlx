		end)
	end)
end]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22807"><Properties><string name="Name">Component</string><ProtectedString name="Source"><![CDATA[local v_u_1 = require(script.Parent.assign)
