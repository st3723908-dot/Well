local v_u_2 = script.Parent
local v_u_3 = {}
for _, v4 in ipairs(v_u_2.Color.Keypoints) do
	local v5 = {
		["t"] = v4.Time,
		["c"] = v4.Value
	}
	table.insert(v_u_3, v5)
end
local function v_u_22(p6) -- name: buildRotated
	-- upvalues: (copy) v_u_3
	local v7 = {}
	for _, v8 in ipairs(v_u_3) do
		local v9 = {
			["t"] = (v8.t + p6) % 1,
			["c"] = v8.c
		}
		table.insert(v7, v9)
	end
	table.sort(v7, function(p10, p11)
		return p10.t < p11.t
	end)
	local v12 = v7[1]
	local v13 = v7[#v7]
	local v14 = 1 - v13.t + v12.t
	local v15
	if v14 > 1e-6 then
		v15 = v13.c:Lerp(v12.c, (1 - v13.t) / v14)
	else
		v15 = v12.c
	end
	local v16 = { ColorSequenceKeypoint.new(0, v15) }
	for _, v17 in ipairs(v7) do
		if v17.t <= 0 or v17.t >= 1 then
			continue
		end
		local v18 = ColorSequenceKeypoint.new
		local v19 = v17.t
		local v20 = v17.c
		table.insert(v16, v18(v19, v20))
	end
	local v21 = ColorSequenceKeypoint.new
	table.insert(v16, v21(1, v15))
	while #v16 > 20 do
		table.remove(v16, #v16 - 1)
	end
	return ColorSequence.new(v16)
end
local v_u_23 = os.clock()
v1.Heartbeat:Connect(function()
	-- upvalues: (copy) v_u_23, (copy) v_u_22, (copy) v_u_2
	local v24 = (os.clock() - v_u_23) / 30 % 1
	local v25 = v_u_22
	local v26, v27 = pcall(v25, v24)
	if v26 then
